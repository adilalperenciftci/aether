// std.list - ArrayList Operations (alias for std.collections)
//
// API shape:
//   - Raw externs end in `_raw` and return ptr/int in the old C-style
//     convention. They are the escape hatch for advanced callers.
//   - Aether-native wrappers (below) use Go-style `(value, err)` / `err`
//     returns.

exports(
    list_new, list_new_in, list_add, list_add_raw, list_add_string_owned, list_get_raw, list_set,
    list_size, list_remove, list_clear, list_free,
    get, get_string
)

extern list_new() -> ptr @fresh
extern list_new_in(alloc: ptr) -> ptr @fresh
// The stores keep their item past the call (#3086): a `ptr` stays the
// list's, so a function that adds a borrowed `ptr` parameter declares it
// `@keep`, and a string or a closure is handed a reference of its own
// (`@retain`, R4).
extern list_add_raw(list: @holds ptr, item: @aether @retain ptr) -> int
// Append an item to a list. Returns "" on success, error on failure.
extern list_add(list: @holds ptr, item: @aether @retain ptr) -> string
// String-aware add, for C and `ptr` callers. The list takes a
// reference of its own: a counted string is retained, a plain C
// pointer is copied. The caller keeps and releases its own, so the
// same value can live in several containers. list_free releases each
// owned element before freeing the backing array. `list.add(l, s)` of
// a `string` in Aether code is a store into the list (R3): the
// compiler hands the list a reference, moving a fresh value in.
extern list_add_string_owned(list: @holds ptr, item: @aether ptr) -> int
extern list_get_raw(list: ptr, index: int) -> ptr
extern list_set(list: @holds ptr, index: int, item: @aether @retain ptr)
extern list_size(list: ptr) -> int
extern list_remove(list: ptr, index: int)
extern list_clear(list: ptr)
extern list_free(list: ptr)
extern aether_string_is_string(p: @aether ptr) -> int

// Index into a list.
// - (item, "")                     : index in range
// - (null, "index out of range")   : index < 0 or index >= size
// - (null, "null list")            : `list` is null
// An empty error means the value is good, as everywhere else in std (#2439).
// list_get_raw stays the unchecked form for callers that have already
// bounded the index.
get(list: ptr, index: int) -> {
    if list == null {
        return null, "null list"
    }
    if index < 0 || index >= list_size(list) {
        return null, "index out of range"
    }
    return list_get_raw(list, index), ""
}

// Index into a list whose element is a string. `get` hands back a `ptr`,
// which a `string` local would read as text whatever it points at (refused,
// E0202); this says the element is a string, and checks it is one:
// - (item, "")                     : index in range, the element a string
// - (null, "")                     : the element is null
// - (null, "not a string")         : the element is some other pointer
// - (null, "index out of range")   : index < 0 or index >= size
// - (null, "null list")            : `list` is null
get_string(list: ptr, index: int) -> (string, string) {
    if list == null {
        return null, "null list"
    }
    if index < 0 || index >= list_size(list) {
        return null, "index out of range"
    }
    v = list_get_raw(list, index)
    if v == null {
        return null, ""
    }
    if aether_string_is_string(v) == 0 {
        return null, "not a string"
    }
    return v, ""
}
