// std.log unit tests (#1584) — co-located with the module.
//
// The module had no dedicated test. It is a level-filtered logger
// writing to a file, and the behaviour worth pinning is the filter: a
// logger that drops the wrong side of its threshold either floods a
// production log or silently discards the errors it exists to record.
//
// The levels are the module's LOG_LEVEL_DEBUG to LOG_LEVEL_FATAL (#3149).
//
// Timestamps and colours are switched off before each assertion: both
// are on by default and would make the file content unassertable.

import std.spec
import std.log
import std.fs
import std.os
import std.string

main() {
    fw = spec.init()

    // Pid-suffixed so a parallel run cannot collide on the path.
    logfile = "${os.temp_dir()}/aether-log-test-${os.getpid()}.log"

    spec.describe(fw, "std.log level filtering") {
        spec.it("writes a message at or above the threshold") callback {
            spec.assert_ok(log.init(logfile, log.LOG_LEVEL_WARN), "init succeeds")
            log.set_timestamps(0)
            log.set_colors(0)
            log.write(log.LOG_LEVEL_WARN, "kept warning")
            log.write(log.LOG_LEVEL_ERROR, "kept error")
            log.shutdown()
            body, err = fs.read(logfile)
            spec.assert_ok(err, "log file readable")
            spec.assert_contains(body, "kept warning", "the WARN line is there")
            spec.assert_contains(body, "kept error", "the ERROR line is there")
            fs.delete(logfile)
        }

        spec.it("drops a message below the threshold") callback {
            // The half that matters most: a filter that let these
            // through would flood the log, and one that dropped the
            // case above would lose the errors.
            spec.assert_ok(log.init(logfile, log.LOG_LEVEL_WARN), "init succeeds")
            log.set_timestamps(0)
            log.set_colors(0)
            log.write(log.LOG_LEVEL_DEBUG, "dropped debug")
            log.write(log.LOG_LEVEL_INFO, "dropped info")
            log.shutdown()
            body, err = fs.read(logfile)
            spec.assert_ok(err, "log file readable")
            spec.assert_true(string.contains(body, "dropped debug") == 0,
                "the DEBUG line was filtered out")
            spec.assert_true(string.contains(body, "dropped info") == 0,
                "the INFO line was filtered out")
            fs.delete(logfile)
        }

        spec.it("labels each line with its level") callback {
            spec.assert_ok(log.init(logfile, log.LOG_LEVEL_DEBUG), "init succeeds")
            log.set_timestamps(0)
            log.set_colors(0)
            log.write(log.LOG_LEVEL_ERROR, "tagged")
            log.shutdown()
            body, err = fs.read(logfile)
            spec.assert_ok(err, "log file readable")
            spec.assert_contains(body, "ERROR", "the level name is on the line")
            fs.delete(logfile)
        }

        spec.it("honours a threshold raised after init") callback {
            spec.assert_ok(log.init(logfile, log.LOG_LEVEL_DEBUG), "init succeeds")
            log.set_timestamps(0)
            log.set_colors(0)
            log.write(log.LOG_LEVEL_INFO, "before raise")
            log.set_level(log.LOG_LEVEL_ERROR)
            log.write(log.LOG_LEVEL_INFO, "after raise")
            log.shutdown()
            body, err = fs.read(logfile)
            spec.assert_ok(err, "log file readable")
            spec.assert_contains(body, "before raise",
                "written while the threshold was low")
            spec.assert_true(string.contains(body, "after raise") == 0,
                "dropped once the threshold was raised")
            fs.delete(logfile)
        }
    }

    spec.describe(fw, "std.log init") {
        spec.it("reports a log file it cannot open, naming it") callback {
            err = log.init("/nonexistent-directory-xyz/app.log", log.LOG_LEVEL_DEBUG)
            spec.assert_err_contains(err, "cannot open log file /nonexistent-directory-xyz/app.log",
                "an unopenable path is reported by name")
            log.shutdown()
        }

        spec.it("takes \"\" and \"-\" for stderr") callback {
            spec.assert_ok(log.init("", log.LOG_LEVEL_INFO), "\"\" is stderr, not a file")
            spec.assert_ok(log.init("-", log.LOG_LEVEL_INFO), "\"-\" is stderr, not a file")
            spec.assert_true(fs.exists("-") == 0, "no file named - was created")
            log.shutdown()
        }

        spec.it("exports its levels, lowest first") callback {
            spec.assert_eq(log.LOG_LEVEL_DEBUG, 0, "DEBUG is aether_log.h's 0")
            spec.assert_eq(log.LOG_LEVEL_INFO, 1, "INFO is 1")
            spec.assert_eq(log.LOG_LEVEL_WARN, 2, "WARN is 2")
            spec.assert_eq(log.LOG_LEVEL_ERROR, 3, "ERROR is 3")
            spec.assert_eq(log.LOG_LEVEL_FATAL, 4, "FATAL is 4")
        }
    }

    return spec.run_summary(fw)
}
