// std.actors — process-global name → actor_ref registry.
// Import with: import std.actors
//
// (Module name is plural because `actor` itself is a reserved
// keyword in Aether and can't appear as a namespace prefix at call
// sites. `actors.register("auditor", a)` parses; `actor.register(...)`
// does not.)
//
// Models BEAM's `erlang:register(Name, Pid)` / `erlang:whereis(Name)`:
// a way to find an actor from any context, including from inside
// `@c_callback` handlers where Aether-typed parameters can't flow
// through the C void* user_data slot.
//
//     import std.actors
//
//     actor Auditor {
//         receive {
//             Analyze(payload) -> { /* ... */ }
//         }
//     }
//
//     main() {
//         a = spawn(Auditor())
//         actors.register("auditor", a)
//     }
//
//     handle_request(req: ptr, res: ptr, ud: ptr) {
//         a = actors.whereis("auditor")
//         a ! Analyze { ... }
//     }
//
// Off-scheduler senders (std.http handlers, std.worker threads, a C
// library's callback thread): `whereis` works from any thread, and so
// does the `!` send — a thread that is not a scheduler core enqueues
// through the target core's shared ingress channel, which serializes
// its producers (aether#2083 was that channel taking one producer at a
// time, so a pool worker's send raced the main thread's and was lost
// without a diagnostic). A handler → actor *read* is still not
// expressible (no ask/reply primitive); for state a handler must read
// back, keep it on the pool thread in a copy-on-write cell
// (std.snapshot: `snapshot.load` / `snapshot.cas`) handed to the
// handler via its `ud` slot. See docs/http-server.md "Handler → actor
// from a release".
//
// Storage: a single process-global hashmap behind a reader/writer
// lock. Reads (the hot path — every C-callback handler that needs
// to find a named actor) are concurrent. Writes serialize.
//
// At the C level, `actor_ref` lowers to `void*`, which is exactly
// what the registry stores — so the round-trip is layout-clean.
//
// The registry does NOT track actor liveness. If you register an
// actor and it later exits, `whereis` keeps returning the stale
// reference until something explicitly calls `unregister`. This
// matches BEAM's behaviour for non-link'd registrations and keeps
// the registry's responsibility narrow.
//
// Section 2 of nuther-ask-of-aether-team.md / Nico's reply.

exports(
    register, whereis, unregister, is_registered, registry_size,
    registry_clear,
    monitor, demonitor, kill, stop, dead_sends,
    link, unlink, trap_exits
)

// ---- Raw externs ----
// `actor_ref` lowers to `void*` at the C level, so the registry's
// `void* ref` slot accepts and returns the same shape Aether code
// passes / receives.
extern aether_actor_register(name: string, ref: actor_ref)
extern aether_actor_whereis(name: string) -> actor_ref
extern aether_actor_unregister(name: string) -> int
extern aether_actor_is_registered(name: string) -> int
extern aether_actor_registry_size() -> int
extern aether_actor_registry_clear()

// Death notices (#2974), runtime/actors/aether_supervision.c.
extern aether_actor_monitor(ref: actor_ref) -> int
extern aether_actor_demonitor(id: int)
extern aether_actor_kill(ref: actor_ref)
extern aether_actor_stop()
extern aether_actor_dead_sends() -> long
extern aether_actor_link(ref: actor_ref)
extern aether_actor_unlink(ref: actor_ref)
extern aether_actor_trap_exits(on: int)

// ---- Aether-side wrappers ----

// Bind `name` → `ref`. Overwrites any prior binding of the same
// name (no error). The name is duplicated internally; the actor_ref
// is stored as-is.
register(name: string, ref: actor_ref) {
    aether_actor_register(name, ref)
}

// Look up by name. Returns the registered actor_ref, or null (when
// cast to actor_ref) if no binding exists. Pattern: spawn at
// startup, register with a stable name, look up from any context
// (including from inside C-callback handlers that can't take an
// Aether-typed parameter).
whereis(name: string) -> actor_ref {
    return aether_actor_whereis(name)
}

// Remove a binding. Returns 1 if a binding was removed, 0 if `name`
// wasn't registered.
unregister(name: string) -> int {
    return aether_actor_unregister(name)
}

// 1 if `name` is bound, 0 otherwise.
is_registered(name: string) -> int {
    return aether_actor_is_registered(name)
}

// Number of currently-registered names. Mostly for tests / debug.
registry_size() -> int {
    return aether_actor_registry_size()
}

// Wipe all bindings. Tests use this for isolation.
registry_clear() {
    aether_actor_registry_clear()
}

// ---- Death notices (#2974) ----
//
// A watched actor's death reaches its watcher as the system message
// `Down { ref: actor_ref, reason: string }`, which the compiler declares:
// an actor handles it in a `Down(ref, reason) -> { ... }` arm. The reason
// is "normal" (it stopped, or was released), "killed" (actors.kill), or
// the panic's reason. A Down is sent once its death is final: never while
// its handler still runs, and after the last messages it sent the watcher.

// From a handler: one Down to this actor when `ref` ends, at once if it has
// ended already. Returns the monitor's id, for demonitor.
monitor(ref: actor_ref) -> int {
    return aether_actor_monitor(ref)
}

// From a handler: no Down of monitor `id` is handled after this, one
// already on its way included.
demonitor(id: int) {
    aether_actor_demonitor(id)
}

// Ends `ref` with "killed" once its current handler, if one is running,
// returns. Its queued messages are dropped and counted (dead_sends), an
// ask it is waiting in ends at once, and its watchers get Down. From
// anywhere; a dead actor is not killed twice.
kill(ref: actor_ref) {
    aether_actor_kill(ref)
}

// From a handler: this actor ends with "normal" when the handler returns.
stop() {
    aether_actor_stop()
}

// Messages a panicked, killed or stopped actor did not handle: queued at
// its death or sent to it after, each released and counted once.
dead_sends() -> long {
    return aether_actor_dead_sends()
}

// From a handler: this actor and `ref` are linked, both ways. When either
// ends, the other ends too, with the same reason (a panic's message, or
// "killed"), unless that reason is "normal", which ends nothing; one that
// traps exits gets a Down instead and lives on. Linked to an actor that has
// ended already, this actor takes its death at once.
link(ref: actor_ref) {
    aether_actor_link(ref)
}

// From a handler: the link with `ref` goes, both ways. A death already
// taken by it stays taken.
unlink(ref: actor_ref) {
    aether_actor_unlink(ref)
}

// From a handler: a linked actor's death reaches this actor as a Down (its
// id 0, never dropped by demonitor) instead of ending it, while `on`.
trap_exits(on: bool) {
    if on {
        aether_actor_trap_exits(1)
    } else {
        aether_actor_trap_exits(0)
    }
}
