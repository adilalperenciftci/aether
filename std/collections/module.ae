// std.collections - Collections Module
// Import with: import std.collections
//
// API shape:
//   - Raw externs end in `_raw` and return ptr/int in the old C-style
//     convention. They are the escape hatch for advanced callers.
//   - Aether-native wrappers (below) use Go-style `(value, err)` or
//     `err` returns and are the idiomatic way to call collections
//     operations that can fail.

import std.intarr

exports(
    list_new, list_new_in, list_add_raw, list_get_raw, list_set, list_size,
    list_remove, list_clear, list_free,
    map_new, map_put_raw, map_get_raw, map_has, map_remove,
    map_size, map_clear, map_free, map_keys_raw, map_keys_free,
    intarr_new_raw, intarr_new_filled_raw, intarr_size,
    intarr_get_raw, intarr_set_raw,
    intarr_get_unchecked, intarr_set_unchecked,
    intarr_fill, intarr_free, intarr_view,
    string_list_new, string_list_add, string_list_get, string_list_set,
    string_list_size, string_list_remove, string_list_clear, string_list_free,
    string_list_sort, string_list_sort_lex,
    list_add, list_get,
    map_put, map_get, map_keys
)

// ---- ArrayList raw externs ----
extern list_new() -> ptr
extern list_new_in(alloc: ptr) -> ptr
extern list_add_raw(list: ptr, item: @aether ptr) -> int
// String-aware add (#467), for C and `ptr` callers: the list takes a
// reference of its own (a counted string retained, a plain C pointer
// copied), tags the element and stores it; list_free releases owned
// elements before freeing the backing array. `list.add(l, s)` of a
// `string` in Aether code is a store into the list (R3): the compiler
// hands the list a reference, moving a fresh value in.
extern list_add_string_owned(list: ptr, item: @aether ptr) -> int
extern list_get_raw(list: ptr, index: int) -> ptr
extern list_set(list: ptr, index: int, item: @aether ptr)
extern list_size(list: ptr) -> int
extern list_remove(list: ptr, index: int)
extern list_clear(list: ptr)
extern list_free(list: ptr)

// ---- HashMap raw externs ----
extern map_new() -> ptr
// `key` is BORROWED: map_put_raw copies the key into the map's own
// AetherString (string_new at put time, released at map_free), so it
// never holds a reference to the caller's key bytes after the call.
// A heap-string `key` argument is therefore the caller's to reclaim —
// it must NOT be @retain-marked, or the caller's key leaks (the map
// only ever owns its copy). The map_clear/map_free path releases the
// COPY, not the caller's original.
// Keys cross as `@aether string`: the C map reads the AetherString's length,
// so a key with an embedded NUL is the whole key (#2469). Unwrapped to a C
// string, "a\0x" and "a\0y" were one key, "a".
extern map_put_raw(map: ptr, key: @aether string, value: @aether ptr) -> int
// Heap-string-aware put (#467). Retains the value and tags the
// map so map_free releases each string value before freeing.
extern map_put_string_owned(map: ptr, key: @aether @retain string, value: @aether ptr) -> int
extern map_get_raw(map: ptr, key: @aether string) -> ptr
extern map_has(map: ptr, key: @aether string) -> int
extern map_remove(map: ptr, key: @aether string)
extern map_size(map: ptr) -> int
extern map_clear(map: ptr)
extern map_free(map: ptr)

// ---- Key iteration ----
extern map_keys_raw(map: ptr) -> ptr
extern map_keys_free(keys: ptr)

// ---- IntArray raw externs ----
// Fixed-size packed int buffer with O(1) random access. For DP
// tables and other hot loops where std.list's void*-boxed items
// would cost an allocation per entry. Go-style wrappers live in
// std.intarr — import that module for `intarr.new(size)` / etc.
extern intarr_new_raw(size: int) -> ptr
extern intarr_new_filled_raw(size: int, init: int) -> ptr
extern intarr_size(arr: ptr) -> int
extern intarr_get_raw(arr: ptr, i: int) -> int
extern intarr_set_raw(arr: ptr, i: int, value: int)
@c_include("aether_arr_inline.h")
// #1986: the unchecked accessors are `static inline` in that header,
// so an element access is the load it names rather than a call the C
// compiler cannot see through. A module that declares them must pull
// the header in and mark them @c_import, or its own prototype
// collides with the header's definition.
extern intarr_get_unchecked(arr: ptr, i: int) -> int @c_import
extern intarr_set_unchecked(arr: ptr, i: int, value: int) @c_import
extern intarr_fill(arr: ptr, value: int)
extern intarr_free(arr: ptr)

// A bounded int[] view of a native intarr handle, through this
// compatibility facade (#2301) — the same bounded view std.intarr.array()
// gives (v.len is intarr.size(arr), an out-of-range v[i] panics rather than
// reading past the buffer), so a caller using only std.collections doesn't
// need a second import to get it. BORROWED, not owned: valid until arr is
// freed, same as array() itself.
intarr_view(arr: ptr) -> int[] {
    return intarr.array(arr)
}

// ---- StringList: a list whose elements are strings it owns ----
// It wraps the ArrayList's backing storage, stores its own copy of
// every string added or set, and frees those copies on remove, clear,
// an overwriting set and free. (`list.add` of a `string` gives an
// ordinary list a reference of its own too; StringList is the C-facing
// shape typed for strings.) Issue #274.
extern string_list_new() -> ptr
// `s` is COPIED, not retained: the list owns an independent copy of
// all the string's bytes, embedded NULs included (#2469), and frees it
// itself (in remove / clear / free / overwriting set). The caller keeps
// its argument, borrowed for the call as every argument is, and releases
// it as usual. This is why there is no `@retain` here: an earlier version
// stored the caller's pointer and could never reclaim a plain `char*`
// element. Copy-on-add owns the bytes outright. (#420 / leak-tail
// follow-up.)
extern string_list_add(list: ptr, s: string) -> int
extern string_list_get(list: ptr, index: int) -> string
// `s` is copied, same as string_list_add; the overwritten element is freed.
extern string_list_set(list: ptr, index: int, s: string)
extern string_list_size(list: ptr) -> int
extern string_list_remove(list: ptr, index: int)
extern string_list_clear(list: ptr)
extern string_list_free(list: ptr)
// #967: stable sort. `cmp` is a comparator closure `fn(string, string) -> int`
// (negative / 0 / positive, like strcmp), passed as a boxed closure (ptr)
// that the sort uses only during the call (`@noescape`, #2523: the caller
// releases its environment afterwards). Reorders slots only, safe against
// the get/set aliasing trap. sort_lex is the closure-free ascending-
// lexicographic common case.
extern string_list_sort(list: ptr, cmp: @noescape ptr)
extern string_list_sort_lex(list: ptr)

// ---- Go-style wrappers ----

// Append an item to a list. Returns "" on success, error on failure
// (OOM during resize, null list).
list_add(list: ptr, item: ptr) -> {
    ok = list_add_raw(list, item)
    if ok == 0 {
        return "list.add failed"
    }
    return ""
}

// Index into a list.
// - (item, "")                     : index in range
// - (null, "index out of range")   : index < 0 or index >= size
// - (null, "null list")            : `list` is null
// An empty error means the value is good, as everywhere else in std (#2439).
list_get(list: ptr, index: int) -> {
    if list == null {
        return null, "null list"
    }
    if index < 0 || index >= list_size(list) {
        return null, "index out of range"
    }
    return list_get_raw(list, index), ""
}

// Insert or update a key-value pair. Returns "" on success, error on
// failure (OOM during resize, null map, null key).
map_put(map: ptr, key: string, value: ptr) -> {
    ok = map_put_raw(map, key, value)
    if ok == 0 {
        return "map.put failed"
    }
    return ""
}

// Look up a key.
// - (value, "")          : key present
// - (null, "")           : key absent (not an error — use map.has to disambiguate)
// - (null, "null map")   : `map` is null
map_get(map: ptr, key: string) -> {
    if map == null {
        return null, "null map"
    }
    v = map_get_raw(map, key)
    return v, ""
}

// Snapshot a map's keys. Returns (MapKeys ptr, "") on success, (null,
// error) on allocation failure. Caller must free the returned ptr with
// map.keys_free.
map_keys(map: ptr) -> {
    if map == null {
        return null, "null map"
    }
    keys = map_keys_raw(map)
    if keys == null {
        return null, "allocation failed"
    }
    return keys, ""
}

// Go-style wrappers for IntArray live in std/intarr/module.ae so that
// users can write `intarr.new(size)` / `intarr.get(a, i)`. Import
// `std.intarr` for those; importing `std.collections` gets the raw
// externs declared above, which are fine for hot-path use.
