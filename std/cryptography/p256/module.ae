//
// std.cryptography.p256: NIST P-256 (secp256r1 / prime256v1) in pure
// Aether, constant time. NO externs to OpenSSL.
//
// Short-Weierstrass curve  y^2 = x^3 - 3x + b  over GF(p),
// p = 2^256 - 2^224 + 2^192 + 2^96 - 1. The arithmetic is
// std.cryptography.ecc: fixed-width Montgomery field elements with no
// allocation, complete projective addition formulas, a fixed-window scalar
// multiplication that reads every table entry, and RFC 6979 nonces.
//
//   scalar_mult_base(k32)            -> (x32, y32)     k*G (public key point)
//   scalar_mult(k32, px32, py32)     -> (x32, y32)     k*P
//   ecdh(priv32, pubx32, puby32)     -> shared_x32     priv * pub, x only
//   ecdsa_sign(priv32, hash)         -> (r32, s32)     RFC 6979 nonce
//   ecdsa_sign_hedged(priv32, hash, extra) -> (r32, s32) RFC 6979 3.6, extra mixed in
//   ecdsa_verify(pubx, puby, hash, r32, s32) -> int    1 = valid
//   public_key_valid(pubx32, puby32) -> int            1 = a point of the curve
//   private_key_valid(priv32)        -> int            1 = in [1, n-1]
//
// 32-byte big-endian scalars / coordinates (the SEC1 / NIST wire order).
//
// `hash` is the message digest, of any length: its leftmost 256 bits are the
// integer signed (FIPS 186-5). The nonce is RFC 6979's, derived with
// HMAC-SHA-224/256/384/512 when the digest is 28/32/48/64 bytes long and
// HMAC-SHA-256 otherwise, so signing the same digest with the same key gives
// the same signature, and no caller-supplied randomness can leak the key.
//
// Constant time: sign, ecdh and the scalar multiplications run the same
// instructions and touch the same memory whatever the private key and nonce
// are (checked under Valgrind by tests/integration/crypto_ct_valgrind).
// ecdsa_verify works on public values only and is not constant time.
//
// Errors: a private key or scalar that is not 32 bytes, a private key outside
// [1, n-1], or a public point that is not on the curve (or has a coordinate
// >= p) gives null (or (null, null)); ecdsa_verify gives 0.
//
// Measured with the default `ae build` (-O2) on an x86-64 Windows desktop,
// per operation: sign 415 us, verify 470 us, ecdh 365 us (the bignum
// implementation this replaced: 4050, 7850 and 3900 us).

import std.bytes
import std.cryptography.ecc

exports(
    scalar_mult_base, scalar_mult, ecdh, ecdsa_sign, ecdsa_sign_hedged, ecdsa_verify,
    public_key_valid, private_key_valid
)

// k * G as affine (x, y) 32-byte big-endian pair; (null, null) if k is a
// multiple of the group order.
scalar_mult_base(k: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult_base(ecc.P256, k)
}

// k * (px, py) as affine (x, y) 32-byte big-endian pair; (null, null) for a
// point not on the curve.
scalar_mult(k: ptr, px: ptr, py: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult(ecc.P256, k, px, py)
}

// ECDH: priv * pub, returns the shared x-coordinate (32 bytes BE), or null.
ecdh(priv: ptr, pubx: ptr, puby: ptr) -> ptr {
    return ecc.ecdh(ecc.P256, priv, pubx, puby)
}

// ECDSA signature (r, s), 32 bytes each, of the digest `hash` under `priv`.
ecdsa_sign(priv: ptr, hash: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign(ecc.P256, priv, hash)
}

// The same with a hedged nonce: `extra` (fresh random bytes) mixed into the
// RFC 6979 seed, as ecc.ecdsa_sign_hedged describes (#3376).
ecdsa_sign_hedged(priv: ptr, hash: ptr, extra: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign_hedged(ecc.P256, priv, hash, extra)
}

// 1 if (r, s) is a valid signature of `hash` under (pubx, puby), else 0.
ecdsa_verify(pubx: ptr, puby: ptr, hash: ptr, r: ptr, s: ptr) -> int {
    return ecc.ecdsa_verify(ecc.P256, pubx, puby, hash, r, s)
}

// 1 if (pubx, puby) is a point of P-256 with both coordinates below p.
public_key_valid(pubx: ptr, puby: ptr) -> int {
    return ecc.public_key_valid(ecc.P256, pubx, puby)
}

// 1 if priv is a 32-byte scalar in [1, n-1], the range a private key must be
// in (ecdh and ecdsa_sign refuse any other). A key drawn as 32 random bytes is
// outside it with probability about 2^-32: draw again.
private_key_valid(priv: ptr) -> int {
    return ecc.private_key_valid(ecc.P256, priv)
}
