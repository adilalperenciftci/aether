//
// std.cryptography.x448: X448 (RFC 7748) in pure Aether, constant time, on
// std.cryptography.ecc's fixed-width field. NO externs to OpenSSL. X448 is
// the Diffie-Hellman function on Curve448 (Montgomery form,
// y^2 = x^3 + 156326 x^2 + x over GF(2^448 - 2^224 - 1)) computed with the
// x-coordinate Montgomery ladder, a24 = (156326 - 2) / 4 = 39081.
//
//   x448(scalar56, u56)   -> shared56         (the core RFC 7748 function)
//   agree(scalar56, u56)  -> (shared56, err)  (refuses an all-zero result)
//   base_mult(scalar56)   -> public56         (scalar * base point, u = 5)
//
// All inputs/outputs are 56-byte little-endian std.bytes buffers (the wire
// format); a buffer of another length gives null. `scalar` is clamped per
// RFC 7748 section 5 (clear the low 2 bits of byte 0, set the high bit of
// byte 55); `u` is taken modulo p, as the RFC asks for non-canonical values.
//
// The ladder runs all 448 steps whatever the scalar, swaps with masks, and
// does its arithmetic on fixed-width Montgomery limbs: constant time in the
// scalar (tests/integration/crypto_ct_valgrind). agree is the key-agreement
// entry point, as x25519.agree is: an all-zero shared secret means the peer
// sent a small-order point, and RFC 7748 section 6.2 lets (and TLS 1.3
// requires) the caller refuse it.
//
// About 1 ms per agreement with the default `ae build` on an x86-64 Windows
// desktop (6.6 ms on std.bignum).

import std.bytes
import std.cryptography.ct
import std.cryptography.ecc

exports(
    x448, agree, base_mult
)

fn field(F: *ecc.Field) {
    ecc.field_init(F, "fffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
}

// X448(scalar, u): the RFC 7748 section 5 function. Returns a fresh 56-byte
// little-endian result (all zero for a small-order u), or null for inputs
// that are not 56 bytes.
x448(scalar: ptr, u: ptr) -> ptr {
    if scalar == null || u == null || bytes.length(scalar) != 56 || bytes.length(u) != 56 {
        return null
    }
    F = ecc.Field {}
    field(&F)
    // Clamp: clear the low 2 bits of byte 0, set the high bit of byte 55.
    k = bytes.new(56)
    bytes.copy_from_bytes(k, 0, scalar, 0, 56)
    bytes.set(k, 0, bytes.get(k, 0) & 252)
    bytes.set(k, 55, bytes.get(k, 55) | 128)

    x1 = ecc.Fe {}
    ecc.fe_reduce_le(&F, &x1, u, 0, 56)
    ecc.fe_to_mont(&F, &x1, &x1)
    x2 = ecc.Fe {}
    ecc.fe_one(&F, &x2)
    z2 = ecc.Fe {}
    ecc.fe_zero(&z2)
    x3 = ecc.Fe {}
    ecc.fe_copy(&x3, &x1)
    z3 = ecc.Fe {}
    ecc.fe_one(&F, &z3)
    a24 = ecc.Fe {}
    ecc.fe_from_int(&F, &a24, 39081)
    a = ecc.Fe {}
    aa = ecc.Fe {}
    b = ecc.Fe {}
    bb = ecc.Fe {}
    e = ecc.Fe {}
    c = ecc.Fe {}
    d = ecc.Fe {}
    da = ecc.Fe {}
    cb = ecc.Fe {}
    int swap = 0
    int t = 447
    while t >= 0 {
        int kt = (bytes.get(k, t / 8) >> (t % 8)) & 1
        swap = swap ^ kt
        ecc.fe_cswap(&F, &x2, &x3, swap)
        ecc.fe_cswap(&F, &z2, &z3, swap)
        swap = kt
        ecc.fe_add(&F, &a, &x2, &z2)
        ecc.fe_sqr(&F, &aa, &a)
        ecc.fe_sub(&F, &b, &x2, &z2)
        ecc.fe_sqr(&F, &bb, &b)
        ecc.fe_sub(&F, &e, &aa, &bb)
        ecc.fe_add(&F, &c, &x3, &z3)
        ecc.fe_sub(&F, &d, &x3, &z3)
        ecc.fe_mul(&F, &da, &d, &a)
        ecc.fe_mul(&F, &cb, &c, &b)
        ecc.fe_add(&F, &x3, &da, &cb)
        ecc.fe_sqr(&F, &x3, &x3)
        ecc.fe_sub(&F, &z3, &da, &cb)
        ecc.fe_sqr(&F, &z3, &z3)
        ecc.fe_mul(&F, &z3, &z3, &x1)
        ecc.fe_mul(&F, &x2, &aa, &bb)
        ecc.fe_mul(&F, &z2, &a24, &e)
        ecc.fe_add(&F, &z2, &z2, &aa)
        ecc.fe_mul(&F, &z2, &z2, &e)
        t = t - 1
    }
    ecc.fe_cswap(&F, &x2, &x3, swap)
    ecc.fe_cswap(&F, &z2, &z3, swap)
    ecc.fe_inv(&F, &z2, &z2)
    ecc.fe_mul(&F, &x2, &x2, &z2)
    ecc.fe_from_mont(&F, &x2, &x2)
    out = bytes.new(56)
    ecc.fe_to_le(&x2, out, 0, 56)
    int i = 0
    while i < 56 {
        bytes.set(k, i, 0)
        i = i + 1
    }
    bytes.free(k)
    return out
}

// Diffie-Hellman with RFC 7748's check: (shared, "") or, when the shared
// secret is all zero (a small-order u), (null, error) with nothing kept.
agree(scalar: ptr, u: ptr) -> (ptr, string) {
    r = x448(scalar, u)
    if r == null {
        return null, "x448: scalar and u must be 56 bytes"
    }
    int acc = 0
    int i = 0
    while i < 56 {
        acc = acc | (bytes.get(r, i) & 255)
        i = i + 1
    }
    if ct.declassify(ct.eq(acc, 0)) == 1 {
        bytes.free(r)
        return null, "x448: all-zero shared secret (small-order point)"
    }
    return r, ""
}

// scalar * base point (u = 5): the public key for a private scalar.
base_mult(scalar: ptr) -> ptr {
    base = bytes.new(56)
    int i = 0
    while i < 56 {
        bytes.set(base, i, 0)
        i = i + 1
    }
    bytes.set(base, 0, 5)
    r = x448(scalar, base)
    bytes.free(base)
    return r
}
