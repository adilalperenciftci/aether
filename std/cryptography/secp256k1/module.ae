//
// std.cryptography.secp256k1: SEC2 secp256k1 (the Bitcoin / Ethereum
// curve) in pure Aether, constant time. NO externs to OpenSSL.
//
// Short-Weierstrass curve  y^2 = x^3 + 7  over GF(p), p = 2^256 - 2^32 - 977
// (a = 0, b = 7), on std.cryptography.ecc with the a = 0 complete formulas
// (see std.cryptography.p256 for how the arithmetic is done).
//
//   scalar_mult_base(k32)            -> (x32, y32)     k*G (public key point)
//   scalar_mult(k32, px32, py32)     -> (x32, y32)     k*P
//   ecdh(priv32, pubx32, puby32)     -> shared_x32     priv * pub, x only
//   ecdsa_sign(priv32, hash)         -> (r32, s32)     RFC 6979 nonce
//   ecdsa_sign_hedged(priv32, hash, extra) -> (r32, s32) RFC 6979 3.6, extra mixed in
//   ecdsa_verify(pubx, puby, hash, r32, s32) -> int    1 = valid
//   public_key_valid(pubx32, puby32) -> int            1 = a point of the curve
//   private_key_valid(priv32)        -> int            1 = in [1, n-1]
//
// 32-byte big-endian scalars / coordinates (the SEC1 wire order).
//
// `hash` is the message digest, of any length (its leftmost 256 bits are
// signed). The nonce is RFC 6979's, derived with HMAC-SHA-224/256/384/512
// when the digest is 28/32/48/64 bytes long and HMAC-SHA-256 otherwise. s is
// returned as computed, not normalized to the lower half: a caller that
// needs Bitcoin's low-S form replaces s with n - s when s > n/2.
//
// Constant time in the private key and the nonce (sign, ecdh, scalar_mult*);
// ecdsa_verify is not, and needs not be. A bad key, scalar length or public
// point gives null (or (null, null)); ecdsa_verify gives 0.
//
// Measured with the default `ae build` (-O2) on an x86-64 Windows desktop,
// per operation: sign 340 us, verify 370 us, ecdh 285 us (the bignum
// implementation this replaced: 3800, 7850 and 3750 us).

import std.bytes
import std.cryptography.ecc

exports(
    scalar_mult_base, scalar_mult, ecdh, ecdsa_sign, ecdsa_sign_hedged, ecdsa_verify,
    public_key_valid, private_key_valid
)

scalar_mult_base(k: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult_base(ecc.SECP256K1, k)
}

scalar_mult(k: ptr, px: ptr, py: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult(ecc.SECP256K1, k, px, py)
}

ecdh(priv: ptr, pubx: ptr, puby: ptr) -> ptr {
    return ecc.ecdh(ecc.SECP256K1, priv, pubx, puby)
}

ecdsa_sign(priv: ptr, hash: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign(ecc.SECP256K1, priv, hash)
}

// The same with a hedged nonce: `extra` (fresh random bytes) mixed into the
// RFC 6979 seed, as ecc.ecdsa_sign_hedged describes (#3376).
ecdsa_sign_hedged(priv: ptr, hash: ptr, extra: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign_hedged(ecc.SECP256K1, priv, hash, extra)
}

ecdsa_verify(pubx: ptr, puby: ptr, hash: ptr, r: ptr, s: ptr) -> int {
    return ecc.ecdsa_verify(ecc.SECP256K1, pubx, puby, hash, r, s)
}

public_key_valid(pubx: ptr, puby: ptr) -> int {
    return ecc.public_key_valid(ecc.SECP256K1, pubx, puby)
}

private_key_valid(priv: ptr) -> int {
    return ecc.private_key_valid(ecc.SECP256K1, priv)
}
