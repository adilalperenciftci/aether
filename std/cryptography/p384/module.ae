//
// std.cryptography.p384: NIST P-384 (secp384r1) in pure Aether, constant
// time. NO externs to OpenSSL.
//
// Short-Weierstrass curve  y^2 = x^3 - 3x + b  over GF(p),
// p = 2^384 - 2^128 - 2^96 + 2^32 - 1, on std.cryptography.ecc (see
// std.cryptography.p256 for how the arithmetic is done).
//
//   scalar_mult_base(k48)            -> (x48, y48)     k*G (public key point)
//   scalar_mult(k48, px48, py48)     -> (x48, y48)     k*P
//   ecdh(priv48, pubx48, puby48)     -> shared_x48     priv * pub, x only
//   ecdsa_sign(priv48, hash)         -> (r48, s48)     RFC 6979 nonce
//   ecdsa_verify(pubx, puby, hash, r48, s48) -> int    1 = valid
//   public_key_valid(pubx48, puby48) -> int            1 = a point of the curve
//   private_key_valid(priv48)        -> int            1 = in [1, n-1]
//
// 48-byte big-endian scalars / coordinates (the SEC1 / NIST wire order).
//
// `hash` is the message digest, of any length: its leftmost 384 bits are the
// integer signed (FIPS 186-5). The nonce is RFC 6979's, derived with
// HMAC-SHA-224/256/384/512 when the digest is 28/32/48/64 bytes long and
// HMAC-SHA-384 otherwise.
//
// Constant time in the private key and the nonce (sign, ecdh, scalar_mult*);
// ecdsa_verify is not, and needs not be. A bad key, scalar length or public
// point gives null (or (null, null)); ecdsa_verify gives 0.
//
// Measured with the default `ae build` (-O2) on an x86-64 Windows desktop,
// per operation: sign 1230 us, verify 1410 us, ecdh 1110 us (the bignum
// implementation this replaced: 7700, 15500 and 7400 us).

import std.bytes
import std.cryptography.ecc

exports(
    scalar_mult_base, scalar_mult, ecdh, ecdsa_sign, ecdsa_verify,
    public_key_valid, private_key_valid
)

scalar_mult_base(k: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult_base(ecc.P384, k)
}

scalar_mult(k: ptr, px: ptr, py: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult(ecc.P384, k, px, py)
}

ecdh(priv: ptr, pubx: ptr, puby: ptr) -> ptr {
    return ecc.ecdh(ecc.P384, priv, pubx, puby)
}

ecdsa_sign(priv: ptr, hash: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign(ecc.P384, priv, hash)
}

ecdsa_verify(pubx: ptr, puby: ptr, hash: ptr, r: ptr, s: ptr) -> int {
    return ecc.ecdsa_verify(ecc.P384, pubx, puby, hash, r, s)
}

public_key_valid(pubx: ptr, puby: ptr) -> int {
    return ecc.public_key_valid(ecc.P384, pubx, puby)
}

private_key_valid(priv: ptr) -> int {
    return ecc.private_key_valid(ecc.P384, priv)
}
