//
// std.cryptography.tls13_record — the TLS 1.3 record protection layer
// (RFC 8446 §5.2) in pure Aether. NO externs to OpenSSL. This wraps the
// negotiated record AEAD (ChaCha20-Poly1305 for the subset) with the exact
// TLS 1.3 record framing: per-record nonce, TLSCiphertext AAD, inner
// content-type append, and padding strip. It does NOT do socket I/O (that is
// the transport-wiring layer above it) — it turns (plaintext, content_type)
// into a wire record and back.
//
// Record protection (RFC 8446 §5.2):
//   nonce = write_iv XOR (seq as 12-byte big-endian, right-aligned)
//   TLSInnerPlaintext = content || content_type(1) || zeros(padding)
//   AAD = opaque_type(0x17) || legacy_record_version(0x0303) || length(uint16)
//         where length is the AEAD ciphertext length (incl. the 16-byte tag)
//   TLSCiphertext.encrypted_record = AEAD-Seal(key, nonce, AAD, TLSInnerPlaintext)
//
// The outer opaque_type is ALWAYS 0x17 (application_data) for protected
// records; the real content type is the last non-zero byte of the decrypted
// inner plaintext.
//
// Import with:  import std.cryptography.tls13_record
//
//   ctx = new(key, iv12)          // a directional record context
//   seal_record(ctx, content_type, plaintext) -> ptr full_record
//       builds a complete TLSCiphertext record (5-byte header + encrypted
//       record). Advances the sequence number.
//   open_record(ctx, record, out) -> string
//       decrypts a TLSCiphertext record into out (plaintext + content_type),
//       verifying the tag. Advances the sequence number. "" on success.
//   free_ctx(ctx)
//   nonce_for(iv12, seq) -> ptr            // exposed for testing
//
// AEAD is ChaCha20-Poly1305 (16-byte tag). AES-GCM support is a later add.

import std.bytes
import std.string
import std.bits
import std.cryptography.chacha20poly1305
import std.cryptography.aes

extern malloc(size: int) -> ptr
@extern("free") libc_free(p: ptr)

exports(
    new, new_aead, rekey, free_ctx, seal_record, open_record, nonce_for, check_header,
    ALERT_UNEXPECTED_MESSAGE, ALERT_BAD_RECORD_MAC, ALERT_RECORD_OVERFLOW, ALERT_DECODE_ERROR,
    RecordCtx, OpenedRecord,
    CONTENT_HANDSHAKE, CONTENT_APPLICATION_DATA, CONTENT_ALERT,
    TAG_LEN, RECORD_HEADER_LEN, OPAQUE_APPLICATION_DATA,
    CONTENT_MAX_PLAIN_LEN, RECORD_MAX_CIPHERTEXT_LEN,
    AEAD_CHACHA20_POLY1305, AEAD_AES_128_GCM, AEAD_AES_256_GCM
)

// Which AEAD a record context uses. TLS 1.3's two mainstream suites:
//   TLS_CHACHA20_POLY1305_SHA256 -> ChaCha20-Poly1305 (32-byte key)
//   TLS_AES_128_GCM_SHA256       -> AES-128-GCM        (16-byte key)
// Both use a 12-byte nonce and a 16-byte tag, so only the cipher differs.
const AEAD_CHACHA20_POLY1305 = 0
const AEAD_AES_128_GCM = 1
const AEAD_AES_256_GCM = 2

const CONTENT_ALERT = 21
const CONTENT_HANDSHAKE = 22
const CONTENT_APPLICATION_DATA = 23

const TAG_LEN = 16 // ChaCha20-Poly1305 / AES-GCM tag
const RECORD_HEADER_LEN = 5 // opaque_type(1) + version(2) + length(2)
const NONCE_LEN = 12
const OPAQUE_APPLICATION_DATA = 0x17
// RFC 8446 record-size limits. A plaintext fragment is at most 2^14 bytes
// (§5.1); a protected TLSCiphertext is at most 2^14 + 256 (§5.2, the extra 256
// covering the content-type byte, padding and the AEAD tag). Enforcing both
// keeps a peer's declared length from driving an unbounded allocation.
const CONTENT_MAX_PLAIN_LEN = 16384 // 2^14
const RECORD_MAX_CIPHERTEXT_LEN = 16640 // 2^14 + 256
// A 64-bit record sequence number must never wrap (§5.3): a connection that
// reached the ceiling must fail rather than reuse a (key, nonce) pair.
const SEQ_MAX = 0x7FFFFFFFFFFFFFFF

// A directional record context: the AEAD key, base iv, and a 64-bit sequence
// number (the record sequence resets to 0 per key, per RFC 8446 §5.3).
struct RecordCtx {
    key: ptr
    key_len: int
    iv: ptr // 12-byte base write_iv
    seq: long // record sequence number (starts at 0)
    aead: int // AEAD_CHACHA20_POLY1305 | AEAD_AES_128_GCM
    aes_ctx: ptr // pre-built AES encryptor (AES-GCM only), else null
}

// Create a ChaCha20-Poly1305 record context (the default AEAD). key_len is 32.
// Kept as the back-compat entry; new_aead selects the cipher explicitly.
new(key: byte[], iv12: ptr) -> ptr {
    return new_aead(AEAD_CHACHA20_POLY1305, key, iv12)
}

// Create a record context for a specific AEAD. Both key and iv are copied (the
// ctx owns its copies). For AES-128-GCM the key_len is 16 and an AES encryptor
// is built once here (GCM only runs the cipher forward, for seal AND open).
new_aead(aead_id: int, key: byte[], iv12: ptr) -> ptr {
    if key.len < 0 { panic("tls13_record.new_aead: the `key` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    ctx = malloc(sizeof(RecordCtx)) as *RecordCtx
    ctx.key = null
    ctx.key_len = 0
    ctx.iv = null
    ctx.seq = 0
    ctx.aead = aead_id
    ctx.aes_ctx = null
    rekey(ctx as ptr, key, iv12)
    return ctx as ptr
}

// Key `ctx` afresh with `key` and `iv12`, its AEAD unchanged, and start its
// sequence number again at 0, as a KeyUpdate does (RFC 8446 4.6.3, 5.3).
// Both are copied (the ctx owns its copies; the old ones are freed).
rekey(ctx: ptr, key: byte[], iv12: ptr) {
    if key.len < 0 { panic("tls13_record.rekey: the `key` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    c = ctx as *RecordCtx
    int key_len = key.len
    k = bytes.new(key_len)
    if key_len > 0 { bytes.set(k, key_len - 1, 0) }
    bytes.copy_from_slice(k, 0, key[0..key_len])
    iv = bytes.new(NONCE_LEN)
    bytes.set(iv, NONCE_LEN - 1, 0)
    bytes.copy_from_bytes(iv, 0, iv12, 0, NONCE_LEN)
    wipe_free(c.key)
    wipe_free(c.iv)
    if c.aes_ctx != null { aes.free(c.aes_ctx) }
    c.key = k
    c.key_len = key_len
    c.iv = iv
    c.seq = 0
    c.aes_ctx = null
    if c.aead == AEAD_AES_128_GCM || c.aead == AEAD_AES_256_GCM {
        c.aes_ctx = aes.new_encryptor(bytes.view(k)[0..key_len])
    }
}

// Zero a key buffer, then free it: a record key must not outlive its
// context (RFC 8446 7.2 asks that keys replaced by a KeyUpdate be deleted).
fn wipe_free(b: @frees ptr) {
    bytes.wipe_free(b)
}

free_ctx(ctx: ptr) {
    c = ctx as *RecordCtx
    wipe_free(c.key)
    wipe_free(c.iv)
    if c.aes_ctx != null { aes.free(c.aes_ctx) }
    libc_free(ctx)
}

// Per-record nonce = iv XOR (seq as 12-byte big-endian, right-aligned)
// (RFC 8446 §5.3). Returns a fresh 12-byte buffer (caller frees).
nonce_for(iv12: ptr, seq: long) -> ptr {
    n = bytes.new(NONCE_LEN)
    bytes.set(n, NONCE_LEN - 1, 0)
    // The sequence number occupies the low 8 bytes of the 12-byte field;
    // the high 4 bytes of the field are just the iv (seq contributes 0).
    i = 0
    while i < NONCE_LEN {
        int seq_byte = 0
        // byte position from the right (0 = least significant)
        from_right = (NONCE_LEN - 1) - i
        if from_right < 8 {
            shift = from_right << 3
            // Logical (not arithmetic) right shift: high sequence bytes must
            // not sign-extend. std.bits.lsr64 is the logical-shift primitive.
            seq_byte = bits.lsr64(seq, shift) & 0xFF
        }
        bytes.set(n, i, (bytes.get(iv12, i) ^ seq_byte) & 0xFF)
        i = i + 1
    }
    return n
}

// Build the TLSCiphertext AAD (RFC 8446 §5.2):
//   opaque_type(0x17) || legacy_record_version(0x0303) || length(uint16)
// where `ct_len` is the AEAD ciphertext length (inner plaintext + tag).
fn build_aad(ct_len: int) -> ptr {
    aad = bytes.new(5)
    bytes.set(aad, 0, OPAQUE_APPLICATION_DATA)
    bytes.set(aad, 1, 0x03)
    bytes.set(aad, 2, 0x03)
    bytes.set(aad, 3, (ct_len >> 8) & 0xFF)
    bytes.set(aad, 4, ct_len & 0xFF)
    return aad
}

// Seal `plaintext` of `content_type` into a complete TLSCiphertext record
// (5-byte header + encrypted_record). No extra padding is added (the inner
// plaintext is content || content_type). Advances ctx.seq. Caller frees.
seal_record(ctx: ptr, content_type: int, plaintext: byte[]) -> ptr {
    if plaintext.len < 0 { panic("tls13_record.seal_record: the `plaintext` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int pt_len = plaintext.len
    if ctx == null { return null }
    c = ctx as *RecordCtx

    // RFC 8446 §5.1 / §5.3: refuse an over-2^14 fragment or a sequence number
    // at the wrap point rather than emit an out-of-spec record or reuse a nonce.
    if pt_len < 0 || pt_len > CONTENT_MAX_PLAIN_LEN { return null }
    if c.seq < 0 || c.seq >= SEQ_MAX { return null }

    // TLSInnerPlaintext = content || content_type (no padding in this cut).
    inner_len = pt_len + 1
    inner = bytes.new(inner_len)
    bytes.set(inner, inner_len - 1, 0)
    bytes.copy_from_slice(inner, 0, plaintext[0..pt_len])
    bytes.set(inner, pt_len, content_type & 0xFF)

    // ciphertext length = inner_len + tag
    ct_len = inner_len + TAG_LEN
    aad = build_aad(ct_len)
    nonce = nonce_for(c.iv, c.seq)

    enc = null
    if c.aead == AEAD_AES_128_GCM || c.aead == AEAD_AES_256_GCM {
        enc = aes.gcm_seal(c.aes_ctx, nonce, bytes.view(aad)[0..RECORD_HEADER_LEN], bytes.view(inner)[0..inner_len])
    } else {
        enc = chacha20poly1305.aead_seal(c.key, nonce, bytes.view(aad)[0..RECORD_HEADER_LEN], bytes.view(inner)[0..inner_len])
    }
    // enc is inner_len + 16 bytes (ciphertext-with-tag) == ct_len

    // Full record: header (0x17 0x0303 len16) || enc
    rec = bytes.new(RECORD_HEADER_LEN + ct_len)
    bytes.set(rec, RECORD_HEADER_LEN + ct_len - 1, 0)
    bytes.set(rec, 0, OPAQUE_APPLICATION_DATA)
    bytes.set(rec, 1, 0x03)
    bytes.set(rec, 2, 0x03)
    bytes.set(rec, 3, (ct_len >> 8) & 0xFF)
    bytes.set(rec, 4, ct_len & 0xFF)
    bytes.copy_from_bytes(rec, RECORD_HEADER_LEN, enc, 0, ct_len)

    bytes.free(inner)
    bytes.free(aad)
    bytes.free(nonce)
    bytes.free(enc)
    c.seq = c.seq + 1
    return rec
}

// Parsed result of opening a record.
struct OpenedRecord {
    content_type: int
    plaintext: ptr // fresh bytes (caller frees) — the inner content
    plaintext_len: int
    alert: int // the alert open_record says to send, when it refuses the record
}

// Dispatch AEAD-Open to the negotiated cipher. Returns (inner_plaintext, "")
// or (null, err) exactly like the underlying aead_open primitives.
fn aead_open_dispatch(c: *RecordCtx, nonce: ptr, aad: ptr, ctbuf: byte[]) -> (ptr, string) {
    if c.aead == AEAD_AES_128_GCM || c.aead == AEAD_AES_256_GCM {
        return aes.gcm_open(c.aes_ctx, nonce, bytes.view(aad)[0..RECORD_HEADER_LEN], ctbuf)
    }
    return chacha20poly1305.aead_open(c.key, nonce, bytes.view(aad)[0..RECORD_HEADER_LEN], ctbuf)
}

// Open a TLSCiphertext record (5-byte header + encrypted_record) into `out`.
// Verifies the AEAD tag, strips trailing zero padding, and reads the real
// content type from the last non-zero inner byte. Advances ctx.seq. Returns
// "" on success or an error string. On success out.plaintext is fresh bytes.
// The alerts the record layer refuses with (RFC 8446 5, 6.2).
const ALERT_UNEXPECTED_MESSAGE = 10
const ALERT_BAD_RECORD_MAC = 20
const ALERT_RECORD_OVERFLOW = 22
const ALERT_DECODE_ERROR = 50

// check_header(header) -> (alert, error) for a record's 5-byte header (the
// first five bytes of `header`): (0, "") for a content type TLS 1.3 knows
// (change_cipher_spec, alert, handshake, application_data) and a length the
// type allows: 2^14 for a plaintext record, 2^14 + 256 for a protected one
// (RFC 8446 5.1, 5.2), and never zero for a handshake or alert. Else
// unexpected_message or record_overflow. Checked as soon as the header has
// arrived, so a bogus length never sizes a read.
check_header(header: byte[]) -> (int, string) {
    if header.len < 0 { panic("tls13_record.check_header: the `header` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if header.len < RECORD_HEADER_LEN { return ALERT_DECODE_ERROR, "record: truncated header" }
    t = header[0] & 0xFF
    n = ((header[3] & 0xFF) << 8) | (header[4] & 0xFF)
    if t != 20 && t != 21 && t != 22 && t != 23 {
        return ALERT_UNEXPECTED_MESSAGE, "record: unknown content type ${t}"
    }
    if t == OPAQUE_APPLICATION_DATA {
        if n > RECORD_MAX_CIPHERTEXT_LEN { return ALERT_RECORD_OVERFLOW, "record: a protected record over 2^14 + 256 bytes" }
    } else if n > CONTENT_MAX_PLAIN_LEN {
        return ALERT_RECORD_OVERFLOW, "record: a plaintext record over 2^14 bytes"
    }
    if (t == 21 || t == 22) && n == 0 {
        return ALERT_UNEXPECTED_MESSAGE, "record: an empty handshake or alert record"
    }
    return 0, ""
}

open_record(ctx: ptr, record: byte[], out: *OpenedRecord) -> string {
    if record.len < 0 { panic("tls13_record.open_record: the `record` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int rec_len = record.len
    out.content_type = 0
    out.plaintext = null
    out.plaintext_len = 0
    out.alert = ALERT_DECODE_ERROR

    if ctx == null { return "record: null context" }
    c = ctx as *RecordCtx
    // RFC 8446 §5.3: a sequence number at the wrap point must end the
    // connection, not silently reuse a (key, nonce) pair.
    if c.seq < 0 || c.seq >= SEQ_MAX {
        return "record: sequence number overflow"
    }
    if rec_len < RECORD_HEADER_LEN + TAG_LEN {
        // Shorter than its tag: it cannot be decrypted, which RFC 8446 5.2
        // answers with bad_record_mac (#3357).
        out.alert = ALERT_BAD_RECORD_MAC
        return "record: too short"
    }
    // header: opaque_type must be 0x17 for a protected record
    if (record[0] & 0xFF) != OPAQUE_APPLICATION_DATA {
        out.alert = ALERT_UNEXPECTED_MESSAGE
        return "record: unexpected opaque_type"
    }
    ct_len = ((record[3] & 0xFF) << 8) | (record[4] & 0xFF)
    // RFC 8446 §5.2: a TLSCiphertext over 2^14 + 256 bytes is a record_overflow.
    // Reject before allocating so a bogus length cannot drive the buffer size.
    if ct_len > RECORD_MAX_CIPHERTEXT_LEN {
        out.alert = ALERT_RECORD_OVERFLOW
        return "record: length exceeds maximum record size"
    }
    if RECORD_HEADER_LEN + ct_len > rec_len {
        return "record: length overruns buffer"
    }

    // AAD is the 5-byte header exactly as received.
    aad = bytes.new(RECORD_HEADER_LEN)
    bytes.copy_from_slice(aad, 0, record[0..RECORD_HEADER_LEN])

    // ciphertext-with-tag = the ct_len bytes after the header.
    ctbuf = bytes.new(ct_len)
    if ct_len > 0 { bytes.set(ctbuf, ct_len - 1, 0) }
    bytes.copy_from_slice(ctbuf, 0, record[RECORD_HEADER_LEN..RECORD_HEADER_LEN + ct_len])

    nonce = nonce_for(c.iv, c.seq)
    inner, err = aead_open_dispatch(c, nonce, aad, bytes.view(ctbuf)[0..ct_len])

    bytes.free(aad)
    bytes.free(ctbuf)
    bytes.free(nonce)

    if string.equals(err, "") != 1 {
        out.alert = ALERT_BAD_RECORD_MAC
        return err
    }

    // inner = TLSInnerPlaintext = content || content_type || zeros(padding).
    // Scan from the end for the last non-zero byte: that is content_type;
    // everything before it is the content.
    inner_len = bytes.length(inner)
    ct_idx = -1
    scan = inner_len - 1
    while scan >= 0 {
        if ct_idx < 0 {
            if (bytes.get(inner, scan) & 0xFF) != 0 {
                ct_idx = scan
            }
        }
        scan = scan - 1
    }
    if ct_idx < 0 {
        // all-zero inner plaintext: no content type -> illegal
        bytes.free(inner)
        c.seq = c.seq + 1
        out.alert = ALERT_UNEXPECTED_MESSAGE
        return "record: no content type (all-zero inner plaintext)"
    }
    out.content_type = bytes.get(inner, ct_idx) & 0xFF
    // RFC 8446 5.4: TLSInnerPlaintext is at most 2^14 + 1 bytes (content,
    // type and padding), and 5: a record type TLS 1.3 does not know is
    // unexpected_message (#3317).
    if inner_len > CONTENT_MAX_PLAIN_LEN + 1 {
        bytes.free(inner)
        c.seq = c.seq + 1
        out.alert = ALERT_RECORD_OVERFLOW
        return "record: inner plaintext over 2^14 + 1 bytes"
    }
    if out.content_type != 21 && out.content_type != 22 && out.content_type != 23 {
        bytes.free(inner)
        c.seq = c.seq + 1
        out.alert = ALERT_UNEXPECTED_MESSAGE
        return "record: protected record of unknown type ${out.content_type}"
    }
    content_len = ct_idx
    pt = bytes.new(content_len)
    if content_len > 0 {
        bytes.set(pt, content_len - 1, 0)
        bytes.copy_from_bytes(pt, 0, inner, 0, content_len)
    }
    out.plaintext = pt
    out.plaintext_len = content_len
    out.alert = 0

    bytes.free(inner)
    c.seq = c.seq + 1
    return ""
}
