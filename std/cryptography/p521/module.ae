//
// std.cryptography.p521: NIST P-521 (secp521r1) in pure Aether, constant
// time. NO externs to OpenSSL.
//
// Short-Weierstrass curve  y^2 = x^3 - 3x + b  over GF(p), p = 2^521 - 1,
// on std.cryptography.ecc (see std.cryptography.p256 for how the
// arithmetic is done).
//
//   scalar_mult_base(k66)            -> (x66, y66)     k*G (public key point)
//   scalar_mult(k66, px66, py66)     -> (x66, y66)     k*P
//   ecdh(priv66, pubx66, puby66)     -> shared_x66     priv * pub, x only
//   ecdsa_sign(priv66, hash)         -> (r66, s66)     RFC 6979 nonce
//   ecdsa_sign_hedged(priv66, hash, extra) -> (r66, s66) RFC 6979 3.6, extra mixed in
//   ecdsa_verify(pubx, puby, hash, r66, s66) -> int    1 = valid
//   public_key_valid(pubx66, puby66) -> int            1 = a point of the curve
//   private_key_valid(priv66)        -> int            1 = in [1, n-1]
//
// 66-byte big-endian scalars / coordinates; the top byte holds only the
// value's bit 520.
//
// `hash` is the message digest itself, of any length: pass the 64 bytes of
// a SHA-512 digest as they are. Its leftmost 521 bits are the integer
// signed (FIPS 186-5), so a 64-byte digest is used whole, and a longer
// buffer is truncated: a digest zero-padded to 66 bytes is a different
// number, not the same one. The nonce is RFC 6979's, derived with
// HMAC-SHA-224/256/384/512 when the digest is 28/32/48/64 bytes long and
// HMAC-SHA-512 otherwise.
//
// Constant time in the private key and the nonce (sign, ecdh, scalar_mult*);
// ecdsa_verify is not, and needs not be. A bad key, scalar length or public
// point gives null (or (null, null)); ecdsa_verify gives 0.
//
// Measured with the default `ae build` (-O2) on an x86-64 Windows desktop,
// per operation: sign 3040 us, verify 3400 us, ecdh 2920 us (the bignum
// implementation this replaced: 15000, 28600 and 14800 us).

import std.bytes
import std.cryptography.ecc

exports(
    scalar_mult_base, scalar_mult, ecdh, ecdsa_sign, ecdsa_sign_hedged, ecdsa_verify,
    public_key_valid, private_key_valid
)

scalar_mult_base(k: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult_base(ecc.P521, k)
}

scalar_mult(k: ptr, px: ptr, py: ptr) -> (ptr, ptr) {
    return ecc.scalar_mult(ecc.P521, k, px, py)
}

ecdh(priv: ptr, pubx: ptr, puby: ptr) -> ptr {
    return ecc.ecdh(ecc.P521, priv, pubx, puby)
}

ecdsa_sign(priv: ptr, hash: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign(ecc.P521, priv, hash)
}

// The same with a hedged nonce: `extra` (fresh random bytes) mixed into the
// RFC 6979 seed, as ecc.ecdsa_sign_hedged describes (#3376).
ecdsa_sign_hedged(priv: ptr, hash: ptr, extra: ptr) -> (ptr, ptr) {
    return ecc.ecdsa_sign_hedged(ecc.P521, priv, hash, extra)
}

ecdsa_verify(pubx: ptr, puby: ptr, hash: ptr, r: ptr, s: ptr) -> int {
    return ecc.ecdsa_verify(ecc.P521, pubx, puby, hash, r, s)
}

public_key_valid(pubx: ptr, puby: ptr) -> int {
    return ecc.public_key_valid(ecc.P521, pubx, puby)
}

private_key_valid(priv: ptr) -> int {
    return ecc.private_key_valid(ecc.P521, priv)
}
