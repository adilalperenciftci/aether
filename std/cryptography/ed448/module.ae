//
// std.cryptography.ed448: Ed448 (RFC 8032) signatures in pure Aether,
// constant time, on std.cryptography.ecc and std.cryptography.sha3
// (SHAKE256). NO externs to OpenSSL.
//
// Ed448 is EdDSA over the UNTWISTED Edwards curve
//   x^2 + y^2 = 1 + d x^2 y^2   over GF(2^448 - 2^224 - 1),  d = -39081,
// cofactor 4, group order
//   L = 2^446 - 13818066809895115352007386748515426880336692474882178609894547503885.
//
//   publickey(seed57)             -> public57
//   sign(seed57, msg)             -> sig114
//   verify(public57, msg, sig114) -> int   (1 = valid, 0 = invalid)
//
// 57-byte keys, 114-byte signatures, all little-endian per RFC 8032. The hash
// is SHAKE256 with a 114-byte (= 2b/8) output, prefixed with dom4 =
// "SigEd448" || phflag(0) || octet(ctxlen=0) for the pure (non-prehash,
// empty-context) variant.
//
// publickey and sign are constant time in the seed, the secret scalar and
// the nonce r (a fixed-window scalar multiplication over complete Edwards
// formulas on std.cryptography.ecc's fixed-width field, and S = r + k s mod L
// on fixed-width limbs). verify works on public values; it checks
// [S]B = R + [k]A without the cofactor and refuses S >= L and a public key
// that is not a canonical point encoding.
//
// Measured with the default `ae build` on an x86-64 Windows desktop, per
// operation: sign 2.3 ms, verify 1.6 ms (23.2 and 25.5 ms on std.bignum).

import std.bytes
import std.cryptography.ecc
import std.cryptography.sha3

exports(
    publickey, sign, verify
)

// SHAKE256(b) with out_len bytes of output, or null.
fn shake(b: byte[], out_len: int) -> ptr {
    ctx, err = sha3.new("shake256")
    if err != "" {
        return null
    }
    sha3.update(ctx, b)
    return sha3.final_bytes(ctx, out_len)
}

fn wipe_free(b: @frees ptr) {
    bytes.wipe_free(b)
}

// dom4 prefix for pure Ed448 (phflag = 0, empty context):
//   "SigEd448" || 0x00 || 0x00   (10 bytes)
fn write_dom4(buf: ptr, off: int) -> int {
    // "SigEd448" = 53 69 67 45 64 34 34 38
    bytes.set(buf, off + 0, 0x53)
    bytes.set(buf, off + 1, 0x69)
    bytes.set(buf, off + 2, 0x67)
    bytes.set(buf, off + 3, 0x45)
    bytes.set(buf, off + 4, 0x64)
    bytes.set(buf, off + 5, 0x34)
    bytes.set(buf, off + 6, 0x34)
    bytes.set(buf, off + 7, 0x38)
    bytes.set(buf, off + 8, 0x00) // phflag = 0 (pure)
    bytes.set(buf, off + 9, 0x00) // context length = 0
    return 10
}

// The secret scalar s (pruned SHAKE256(seed, 114)[0..57]) into s_le and the
// prefix (bytes 57..114) into prefix; both 57-byte buffers.
fn expand_seed(seed: ptr, s_le: ptr, prefix: ptr) {
    h = shake(bytes.view(seed)[0..57], 114)
    bytes.copy_from_bytes(s_le, 0, h, 0, 57)
    // prune: clear low 2 bits of byte 0; clear byte 56; set bit 7 of byte 55.
    bytes.set(s_le, 0, bytes.get(s_le, 0) & 252)
    bytes.set(s_le, 56, 0)
    bytes.set(s_le, 55, bytes.get(s_le, 55) | 128)
    bytes.copy_from_bytes(prefix, 0, h, 57, 57)
    wipe_free(h)
}

// Derive the 57-byte public key from a 57-byte seed.
publickey(seed: ptr) -> ptr {
    s_le = bytes.new(57)
    prefix = bytes.new(57)
    expand_seed(seed, s_le, prefix)
    pub = ecc.ed_scalar_mult_base(ecc.ED448, s_le)
    wipe_free(s_le)
    wipe_free(prefix)
    return pub
}

// Sign msg with the 57-byte seed; returns a 114-byte signature.
sign(seed: ptr, msg: byte[]) -> ptr {
    if msg.len < 0 { panic("ed448.sign: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int msg_len = msg.len
    s_le = bytes.new(57)
    prefix = bytes.new(57)
    expand_seed(seed, s_le, prefix)
    aenc = ecc.ed_scalar_mult_base(ecc.ED448, s_le)

    // r = SHAKE256(dom4 || prefix || M, 114) mod L; R = r B
    rin_len = 10 + 57 + msg_len
    rin = bytes.new(rin_len)
    off = write_dom4(rin, 0)
    bytes.copy_from_bytes(rin, off, prefix, 0, 57)
    if msg_len > 0 { bytes.copy_from_slice(rin, off + 57, msg[0..msg_len]) }
    rh = shake(bytes.view(rin)[0..rin_len], 114)
    r = ecc.ed_reduce(ecc.ED448, rh)
    renc = ecc.ed_scalar_mult_base(ecc.ED448, r)

    // k = SHAKE256(dom4 || R || A || M, 114) mod L
    kin_len = 10 + 57 + 57 + msg_len
    kin = bytes.new(kin_len)
    off2 = write_dom4(kin, 0)
    bytes.copy_from_bytes(kin, off2, renc, 0, 57)
    bytes.copy_from_bytes(kin, off2 + 57, aenc, 0, 57)
    if msg_len > 0 { bytes.copy_from_slice(kin, off2 + 114, msg[0..msg_len]) }
    kh = shake(bytes.view(kin)[0..kin_len], 114)
    k = ecc.ed_reduce(ecc.ED448, kh)

    // S = (r + k s) mod L
    s = ecc.ed_sign_s(ecc.ED448, r, k, s_le)

    sig = bytes.new(114)
    bytes.copy_from_bytes(sig, 0, renc, 0, 57)
    bytes.copy_from_bytes(sig, 57, s, 0, 57)

    wipe_free(s_le); wipe_free(prefix); wipe_free(rin); wipe_free(rh); wipe_free(r)
    bytes.free(aenc); bytes.free(renc); bytes.free(kin); bytes.free(kh); bytes.free(k); bytes.free(s)
    return sig
}

// Verify a 114-byte signature over msg with the 57-byte public key.
// Returns 1 if valid, 0 otherwise.
verify(public: ptr, msg: byte[], sig: ptr) -> int {
    if msg.len < 0 { panic("ed448.verify: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if sig == null || bytes.length(sig) != 114 || public == null || bytes.length(public) != 57 { return 0 }
    int msg_len = msg.len
    renc = bytes.new(57)
    bytes.copy_from_bytes(renc, 0, sig, 0, 57)
    senc = bytes.new(57)
    bytes.copy_from_bytes(senc, 0, sig, 57, 57)

    // k = SHAKE256(dom4 || R || A || M, 114) mod L
    kin_len = 10 + 57 + 57 + msg_len
    kin = bytes.new(kin_len)
    off = write_dom4(kin, 0)
    bytes.copy_from_bytes(kin, off, renc, 0, 57)
    bytes.copy_from_bytes(kin, off + 57, public, 0, 57)
    if msg_len > 0 { bytes.copy_from_slice(kin, off + 114, msg[0..msg_len]) }
    kh = shake(bytes.view(kin)[0..kin_len], 114)
    k = ecc.ed_reduce(ecc.ED448, kh)

    ok = ecc.ed_verify(ecc.ED448, public, renc, senc, k)
    bytes.free(renc); bytes.free(senc); bytes.free(kin); bytes.free(kh); bytes.free(k)
    return ok
}
