//
// std.cryptography.tls13_cert — TLS 1.3 certificate handling for the pure-
// Aether client subset (issue #1298): the CertificateVerify signature check
// (RFC 8446 §4.4.3) and the X.509 structural parse needed to feed it. NO
// externs to OpenSSL. Built on std.cryptography.{asn1,sha2,p256,ed25519,rsa}.
//
// This brick covers the two highest-value, offline-testable pieces of cert
// handling:
//
//   1. CertificateVerify content + verify (RFC 8446 §4.4.3). The server signs
//        (0x20 * 64) || "TLS 1.3, server CertificateVerify" || 0x00 || Hash
//      where Hash is the transcript hash up to (and including) the server
//      Certificate message. We build that content and dispatch the signature
//      check to the right primitive by SignatureScheme.
//
//   2. X.509 leaf structural parse: split Certificate into tbsCertificate /
//      signatureAlgorithm / signatureValue, and pull the subjectPublicKeyInfo
//      (algorithm OID + public-key bits) out of the TBS. That SPKI is what the
//      CertificateVerify check needs (the leaf's public key).
//
// EXPLICITLY OUT OF SCOPE for this brick (later increments): chain building
// against a trust store, hostname / SAN matching, validity-period and Basic-
// Constraints / EKU policy. (OCSP-staple revocation status IS parsed — see
// parse_ocsp_status.) This is the crypto core, not the
// full RFC 5280 policy engine.
//
// Import with:  import std.cryptography.tls13_cert
//
//   cert_verify_content(context, transcript_hash, th_len) -> (ptr, int)
//       build the RFC 8446 §4.4.3 signed content; caller frees the buffer.
//   verify_cert_verify(scheme, pubx, puby, transcript_hash, sig) -> int
//       ECDSA-P256 / Ed25519 dispatch (1 = valid, 0 = invalid).
//   parse_certificate(der, out) -> string
//       split a DER Certificate into a LeafCert (tbs/spki/sig views).

import std.bytes
import std.string
import std.bignum
import std.list
import std.cryptography.asn1
import std.cryptography.sha2
import std.cryptography.p256
import std.cryptography.p384
import std.cryptography.ed25519
import std.os

extern malloc(size: int) -> ptr
extern free(p: ptr)

exports(
    init_leaf,
    LEAFCERT_SIZE,
    cert_verify_content, client_cert_verify_content, sign_client_cert_verify_ecdsa_p256, sign_server_cert_verify_ecdsa_p256,
    verify_cert_verify, verify_cert_verify_rsa_pss, parse_certificate, free_leaf,
    split_ecdsa_sig,
    LeafCert,
    leaf_not_before, leaf_not_before_len, leaf_not_after, leaf_not_after_len,
    leaf_dns_count, leaf_dns_name,
    leaf_tbs_len, leaf_subject_len, leaf_issuer_len,
    leaf_is_ca, leaf_key_cert_sign,
    SCHEME_ECDSA_P256_SHA256, SCHEME_ECDSA_P384_SHA384, SCHEME_ED25519, SCHEME_RSA_PSS_RSAE_SHA256,
    check_validity, time_to_key, check_hostname,
    chain_verify, chain_verify_path, verify_cert_signature, find_issuer_cert,
    validate_chain, check_validity_at, PURPOSE_SERVER, PURPOSE_CLIENT,
    trust_store_load, trust_store_add, trust_store_add_pem, free_anchors,
    parse_ocsp_status, verify_ocsp_signature, verify_ocsp_signature_at, OCSP_GOOD, OCSP_REVOKED, OCSP_UNKNOWN, OCSP_ERROR
)

// SignatureScheme code points (RFC 8446 §4.2.3).
const SCHEME_ECDSA_P256_SHA256 = 0x0403
const SCHEME_ECDSA_P384_SHA384 = 0x0503
const SCHEME_RSA_PSS_RSAE_SHA256 = 0x0804
const SCHEME_ED25519 = 0x0807

// The CertificateVerify context string for a server's signature
// (RFC 8446 §4.4.3): "TLS 1.3, server CertificateVerify".
fn server_context(out: ptr, off: int) -> int {
    // ASCII bytes of "TLS 1.3, server CertificateVerify"
    s = "TLS 1.3, server CertificateVerify"
    n = string.length(s)
    i = 0
    while i < n {
        bytes.set(out, off + i, string_char_at_n(s, n, i) & 0xFF)
        i = i + 1
    }
    return off + n
}

extern string_char_at_n(str: string, known_length: int, index: int) -> int

// Build the RFC 8446 §4.4.3 signed content:
//   64 bytes of 0x20  ||  context-string  ||  0x00  ||  transcript_hash
// Returns the content buffer (caller frees) and its length.
cert_verify_content(transcript_hash: byte[]) -> (ptr, int) {
    return cert_verify_content_ctx("TLS 1.3, server CertificateVerify", transcript_hash)
}

// The CLIENT CertificateVerify content (mTLS): identical shape but the context
// string is "TLS 1.3, client CertificateVerify" (RFC 8446 §4.4.3).
client_cert_verify_content(transcript_hash: byte[]) -> (ptr, int) {
    return cert_verify_content_ctx("TLS 1.3, client CertificateVerify", transcript_hash)
}

// Sign a client CertificateVerify with an ECDSA-P256 client key (mTLS). Builds
// the §4.4.3 client content, SHA-256-hashes it, ECDSA-signs it with `priv`
// (32-byte scalar; the nonce is RFC 6979's, derived from the key and the
// digest), and returns the DER ECDSA-Sig-Value SEQUENCE { r INTEGER, s INTEGER }
// (caller frees), or null for a private key outside [1, n-1]. This is the
// signature that goes in the client CertificateVerify handshake message under
// SignatureScheme ecdsa_secp256r1_sha256 (0x0403).
sign_client_cert_verify_ecdsa_p256(priv: ptr, transcript_hash: byte[]) -> ptr {
    content, clen = client_cert_verify_content(transcript_hash)
    sig = sign_content_ecdsa_p256(priv, content, clen)
    bytes.free(content)
    return sig
}

// Sign a server CertificateVerify with an ECDSA-P256 server key. Builds the
// §4.4.3 server content ("TLS 1.3, server CertificateVerify"), SHA-256 hashes
// it, ECDSA-signs it with `priv` (32-byte scalar, RFC 6979 nonce), and returns
// the DER ECDSA-Sig-Value SEQUENCE { r INTEGER, s INTEGER } (caller frees), or
// null for a private key outside [1, n-1].
sign_server_cert_verify_ecdsa_p256(priv: ptr, transcript_hash: byte[]) -> ptr {
    content, clen = cert_verify_content(transcript_hash)
    sig = sign_content_ecdsa_p256(priv, content, clen)
    bytes.free(content)
    return sig
}

// SHA-256 the first clen bytes of content, sign the digest with p256 and
// DER-encode (r, s); null when the key is refused.
fn sign_content_ecdsa_p256(priv: ptr, content: ptr, clen: int) -> ptr {
    digest = sha256_of_bytes(bytes.view(content)[0..clen])
    r32, s32 = p256.ecdsa_sign(priv, digest)
    bytes.free(digest)
    if r32 == null {
        return null
    }
    // DER-encode as SEQUENCE { INTEGER r, INTEGER s }.
    rbn = bignum.from_bytes_unsigned(r32, 32)
    sbn = bignum.from_bytes_unsigned(s32, 32)
    rder = asn1.encode_integer(rbn)
    sder = asn1.encode_integer(sbn)
    body = bytes.new(bytes.length(rder) + bytes.length(sder))
    if bytes.length(body) > 0 { bytes.set(body, bytes.length(body) - 1, 0) }
    bytes.copy_from_bytes(body, 0, rder, 0, bytes.length(rder))
    bytes.copy_from_bytes(body, bytes.length(rder), sder, 0, bytes.length(sder))
    // NOTE: asn1.encode_sequence -> wrap_tlv CONSUMES (frees) `body`, so we must
    // NOT free it again here (double-free). rder/sder are our own copies.
    sig = asn1.encode_sequence(body)
    bytes.free(r32); bytes.free(s32)
    bignum.free(rbn); bignum.free(sbn)
    bytes.free(rder); bytes.free(sder)
    return sig
}

// Generic §4.4.3 signed content with an explicit context string:
//   64 bytes of 0x20 || ctx_str || 0x00 || transcript_hash
fn cert_verify_content_ctx(ctx_str: string, transcript_hash: byte[]) -> (ptr, int) {
    if transcript_hash.len < 0 { panic("tls13_cert.cert_verify_content_ctx: the `transcript_hash` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int th_len = transcript_hash.len
    ctx_len = string.length(ctx_str)
    total = 64 + ctx_len + 1 + th_len
    out = bytes.new(total)
    bytes.set(out, total - 1, 0) // force full zero-fill
    i = 0
    while i < 64 {
        bytes.set(out, i, 0x20)
        i = i + 1
    }
    off = 64
    ci = 0
    while ci < ctx_len {
        bytes.set(out, off + ci, string_char_at_n(ctx_str, ctx_len, ci) & 0xFF)
        ci = ci + 1
    }
    off = off + ctx_len
    bytes.set(out, off, 0)
    off = off + 1
    j = 0
    while j < th_len {
        bytes.set(out, off + j, transcript_hash[j] & 0xFF)
        j = j + 1
    }
    return out, total
}

// Split a DER ECDSA-Sig-Value  SEQUENCE { r INTEGER, s INTEGER }  into two
// fixed 32-byte big-endian scalars (left-padded / high-byte-trimmed as
// needed). Returns (r32, s32, "") or (null, null, err).
// Exported (beyond internal cert-verify use) so the Wycheproof
// ECDSA-DER driver exercises this exact parse path — the DER-encoded
// signature family probes precisely the laxities a hand-rolled test
// parser would mask.
split_ecdsa_sig(sig: byte[], coord: int) -> (ptr, ptr, string) {
    if sig.len < 0 { panic("tls13_cert.split_ecdsa_sig: the `sig` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int sig_len = sig.len
    view = bytes.new(sig_len)
    if sig_len > 0 { bytes.set(view, sig_len - 1, 0) }
    bytes.copy_from_slice(view, 0, sig[0..sig_len])
    rdr = asn1.reader_new(view)
    sub, body, serr = asn1.read_sequence(rdr)
    if string.equals(serr, "") != 1 {
        asn1.reader_free(rdr)
        bytes.free(view)
        return null, null, serr
    }
    // read_integer returns a std.bignum handle (NOT a std.bytes buffer).
    rint, rerr = asn1.read_integer(sub)
    if string.equals(rerr, "") != 1 {
        asn1.reader_free(sub); asn1.reader_free(rdr); bytes.free(view); bytes.free(body)
        return null, null, rerr
    }
    sint, serr2 = asn1.read_integer(sub)
    if string.equals(serr2, "") != 1 {
        bignum.free(rint)
        asn1.reader_free(sub); asn1.reader_free(rdr); bytes.free(view); bytes.free(body)
        return null, null, serr2
    }

    // Strictness gate (Wycheproof ecdsa DER family caught all of these
    // being accepted): the asn1 reader is deliberately BER-tolerant for
    // X.509 field reuse, but an ECDSA-Sig-Value must be STRICT minimal
    // DER with in-range scalars.
    //   1. r and s must be non-negative;
    //   2. their magnitudes must fit `coord` bytes (rejects r + 2^320
    //      style padding — bn_to_fixed would silently truncate it);
    //   3. re-encoding SEQUENCE { INTEGER r, INTEGER s } as minimal DER
    //      must reproduce the input byte-for-byte — one comparison that
    //      rejects long-form/non-minimal/indefinite lengths, superfluous
    //      integer padding, and trailing garbage in a single stroke.
    strict = 1
    if bignum.sign(rint) < 0 { strict = 0 }
    if bignum.sign(sint) < 0 { strict = 0 }
    if strict == 1 {
        rmag = bignum.to_bytes_unsigned(rint)
        smag = bignum.to_bytes_unsigned(sint)
        if bytes.length(rmag) > coord { strict = 0 }
        if bytes.length(smag) > coord { strict = 0 }
        bytes.free(rmag)
        bytes.free(smag)
    }
    if strict == 1 {
        ri = asn1.encode_integer(rint)
        si = asn1.encode_integer(sint)
        rilen = bytes.length(ri)
        silen = bytes.length(si)
        inner = bytes.new(rilen + silen)
        if rilen + silen > 0 { bytes.set(inner, rilen + silen - 1, 0) }
        i = 0
        while i < rilen { bytes.set(inner, i, bytes.get(ri, i)); i = i + 1 }
        i = 0
        while i < silen { bytes.set(inner, rilen + i, bytes.get(si, i)); i = i + 1 }
        // encode_sequence consumes `inner` (wrap_tlv frees its content
        // argument), so only ri/si/reenc are ours to free here.
        reenc = asn1.encode_sequence(inner)
        if bytes.length(reenc) != sig_len {
            strict = 0
        } else {
            j = 0
            while j < sig_len {
                if bytes.get(reenc, j) != sig[j] { strict = 0 }
                j = j + 1
            }
        }
        bytes.free(ri)
        bytes.free(si)
        bytes.free(reenc)
    }
    if strict != 1 {
        bignum.free(rint)
        bignum.free(sint)
        asn1.reader_free(sub); asn1.reader_free(rdr); bytes.free(view); bytes.free(body)
        return null, null, "ecdsa-sig: not strict minimal DER, or scalar out of range"
    }

    r = bn_to_fixed(rint, coord)
    s = bn_to_fixed(sint, coord)
    bignum.free(rint)
    bignum.free(sint)
    asn1.reader_free(sub)
    asn1.reader_free(rdr)
    bytes.free(view)
    bytes.free(body)
    return r, s, ""
}

// Render a std.bignum into exactly 32 big-endian bytes (left-padded with
// zeros; high bytes dropped if the value somehow exceeds 32 bytes — it never
// should for a P-256 scalar).
fn bn_to_fixed(v: ptr, width: int) -> ptr {
    be = bignum.to_bytes_unsigned(v) // variable-length big-endian magnitude
    n = bytes.length(be)
    out = bytes.new(width)
    i = 0
    while i < width {
        bytes.set(out, i, 0)
        i = i + 1
    }
    // Right-align: copy the low min(n,width) bytes into the tail of `out`.
    copy_n = n
    src_start = 0
    if n > width {
        copy_n = width
        src_start = n - width
    }
    dst = width - copy_n
    k = 0
    while k < copy_n {
        bytes.set(out, dst + k, bytes.get(be, src_start + k) & 0xFF)
        k = k + 1
    }
    bytes.free(be)
    return out
}

// SHA-256 of a std.bytes buffer (the streaming update_bytes path — the
// one-shot sha2.sha256_bytes takes a STRING, not a bytes buffer).
fn sha256_of_bytes(data: byte[]) -> ptr {
    ctx, err = sha2.new("sha256")
    if err != "" { return null }
    sha2.update(ctx, data)
    return sha2.final_bytes(ctx)
}

// Verify a server CertificateVerify signature (RFC 8446 §4.4.3).
//   scheme            SignatureScheme code point
//   pubx, puby        the leaf's EC public key coords (ECDSA schemes)
//                     — for Ed25519, pass the 32-byte public key as `pubx`
//                       and null as `puby`.
//   transcript_hash   the transcript hash through the server Certificate msg
//   sig, sig_len      the CertificateVerify signature bytes
// Returns 1 if valid, 0 otherwise.
verify_cert_verify(scheme: int, pubx: ptr, puby: ptr, transcript_hash: byte[], sig: byte[]) -> int {
    content, clen = cert_verify_content(transcript_hash)

    result = 0
    if scheme == SCHEME_ECDSA_P256_SHA256 {
        // ECDSA over SHA-256(content); DER sig -> (r,s).
        // NOTE: sha2.sha256_bytes takes a STRING; content is a std.bytes
        // buffer, so we must hash it through the streaming update_bytes path.
        digest = sha256_of_bytes(bytes.view(content)[0..clen])
        r32, s32, serr = split_ecdsa_sig(sig, 32)
        if string.equals(serr, "") == 1 {
            result = p256.ecdsa_verify(pubx, puby, digest, r32, s32)
            bytes.free(r32)
            bytes.free(s32)
        }
        bytes.free(digest)
    }
    if scheme == SCHEME_ECDSA_P384_SHA384 {
        // ECDSA over SHA-384(content) on a P-384 leaf key; pubx/puby are the
        // 48-byte affine coordinates. DER sig -> (r,s), each 48 bytes.
        digest = sha384_of_bytes(bytes.view(content)[0..clen])
        r48, s48, serr = split_ecdsa_sig(sig, 48)
        if string.equals(serr, "") == 1 {
            result = p384.ecdsa_verify(pubx, puby, digest, r48, s48)
            bytes.free(r48)
            bytes.free(s48)
        }
        bytes.free(digest)
    }
    if scheme == SCHEME_ED25519 {
        // Ed25519 signs the raw content (hashes internally). pubx = 32-byte key.
        result = ed25519.verify(pubx, bytes.view(content)[0..clen], sig)
    }

    bytes.free(content)
    return result
}

// Verify an RSASSA-PSS (rsae, SHA-256) CertificateVerify — SCHEME_RSA_PSS_
// RSAE_SHA256 (0x0804), the mainstream RSA server signature. The RSA public key
// comes from the leaf SPKI (RSAPublicKey SEQUENCE { n, e }). PSS parameters for
// this scheme are fixed: SHA-256 for both the message hash and MGF1, salt
// length = hash length = 32. Returns 1 if valid, 0 otherwise.
verify_cert_verify_rsa_pss(spki_key: byte[], transcript_hash: byte[], sig: byte[]) -> int {
    n, e, perr = parse_rsa_spki(spki_key)
    if string.equals(perr, "") != 1 { return 0 }
    content, clen = cert_verify_content(transcript_hash)
    digest = sha256_of_bytes(bytes.view(content)[0..clen])
    k = rsa.key_from_components(n, e, null)
    result = rsa.verify_pss(k, digest, sig, 32)
    rsa.key_free(k) // frees n, e
    bytes.free(content)
    bytes.free(digest)
    return result
}

// ---- X.509 structural parse ----

// Views into a parsed Certificate (RFC 5280). All ptr fields are fresh
// std.bytes the caller must free via free_leaf. `tbs` is the exact DER of
// tbsCertificate INCLUDING its SEQUENCE tag+length (the bytes the certificate
// signature is computed over); `spki_algo_oid`/`spki_key` are the subject
// public key (EC: 0x04||X||Y; RSA: RSAPublicKey DER).
//
// For chain building and policy: `issuer`/`subject` hold the raw DER of the
// issuer/subject Name (for issuer==subject DN matching); `not_before`/
// `not_after` hold the validity times as their raw ASN.1 time strings
// (UTCTime "YYMMDDHHMMSSZ" or GeneralizedTime "YYYYMMDDHHMMSSZ"); `dns_names`
// is a std.list of dNSName strings from the SAN extension.
// NOTE: fields that are STORED and freed later are std.bytes buffers, not
// strings. Storing an owned AetherString in a struct field and freeing it in a
// separate cleanup is a refcount minefield in Aether (leaks or double-frees);
// bytes buffers free deterministically via bytes.free. So OIDs, validity
// times, and dNSNames are held as bytes; compare via bytes, or stringify a
// transient copy when needed.
// Byte size to malloc for a LeafCert. Aether has no sizeof, so callers that
// heap-allocate one (trust_store_load, the delegated-responder path, and the
// client's intermediate parser) carried the number 136 inline, arrived at by
// counting fields by hand.
//
// That is a heap-corruption bug waiting for the next field: adding one
// pointer makes the struct 144 bytes while three separate mallocs still ask
// for 136, and the overflow only shows as a double-free inside free_leaf,
// a long way from the edit that caused it. One constant, exported, so the
// count lives next to the definition it has to track.
//
// Sized with headroom rather than exactly: 11 ptr (8) + 7 int (4) padded is
// 144, and the slack absorbs the next field or two without another silent
// overflow. A few spare bytes per certificate is the right trade against
// corrupting the heap.
const LEAFCERT_SIZE = 256

struct LeafCert {
    tbs: ptr // full tbsCertificate DER (tag+len+content)
    tbs_len: int
    sig_alg_oid: ptr // outer signatureAlgorithm OID (dotted, as bytes) or null
    signature: ptr // outer signatureValue (BIT STRING content)
    signature_len: int
    spki_algo_oid: ptr // SPKI algorithm OID (dotted, as bytes) or null
    spki_key: ptr
    spki_key_len: int
    issuer: ptr // raw DER of the issuer Name (fresh bytes) or null
    issuer_len: int
    subject: ptr // raw DER of the subject Name (fresh bytes) or null
    subject_len: int
    not_before: ptr // validity notBefore, raw time bytes or null
    not_before_len: int
    not_after: ptr // validity notAfter, raw time bytes or null
    not_after_len: int
    dns_names: ptr // std.list of dNSName BYTES buffers (SAN), or null
    ip_addrs: ptr // std.list of iPAddress SAN BYTES buffers (4 or 16 bytes), or null
    is_ca: int
    has_key_usage: int
    key_cert_sign: int
    version: int // the encoded version: 0 = v1, 1 = v2, 2 = v3
    ext_bits: int // EXT_* flags: which extensions were seen, and how
    path_len: int // basicConstraints pathLenConstraint (when EXT_PATHLEN)
    key_usage: int // KeyUsage, bit i of the BIT STRING as (1 << i) (when has_key_usage)
    eku_bits: int // EKU_* purposes listed (when EXT_EKU)
    nc_permitted: ptr // std.list of permitted name-constraint subtrees (tag byte, then value), or null
    nc_excluded: ptr // std.list of excluded subtrees, or null
}

// Parse a DER Certificate into `out`. Returns "" on success or an error.
// Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }
// Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }
// Positionally walks tbsCertificate to extract the full TBS DER, validity,
// issuer/subject DNs, SAN dNSNames, and the subject public key.
parse_certificate(der: byte[], out: *LeafCert) -> string {
    if der.len < 0 { panic("tls13_cert.parse_certificate: the `der` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int len = der.len
    out.tbs = null
    out.tbs_len = 0
    out.sig_alg_oid = null
    out.signature = null
    out.signature_len = 0
    out.spki_algo_oid = null
    out.spki_key = null
    out.spki_key_len = 0
    out.issuer = null
    out.issuer_len = 0
    out.subject = null
    out.subject_len = 0
    out.not_before = null
    out.not_before_len = 0
    out.not_after = null
    out.not_after_len = 0
    out.dns_names = null
    out.ip_addrs = null
    out.is_ca = 0
    out.has_key_usage = 0
    out.key_cert_sign = 0
    out.version = 0
    out.ext_bits = 0
    out.path_len = 0
    out.key_usage = 0
    out.eku_bits = 0
    out.nc_permitted = null
    out.nc_excluded = null

    view = bytes.new(len)
    if len > 0 { bytes.set(view, len - 1, 0) }
    bytes.copy_from_slice(view, 0, der[0..len])

    top = asn1.reader_new(view)

    // Capture the FULL tbsCertificate DER (tag+len+content): bracket the
    // read with reader_pos so we can slice the exact signed bytes.
    // Certificate is a SEQUENCE; step into it, then the first element is TBS.
    cert, cert_body, cerr = asn1.read_sequence(top)
    if string.equals(cerr, "") != 1 {
        asn1.reader_free(top); bytes.free(view)
        return cerr
    }
    tbs_start = asn1.reader_pos(cert)
    tbs_content, terr = asn1.read_tlv(cert)
    if string.equals(terr, "") != 1 {
        asn1.reader_free(cert); asn1.reader_free(top); bytes.free(view); bytes.free(cert_body)
        return terr
    }
    tbs_end = asn1.reader_pos(cert)
    // Slice the full TBS DER out of cert_body (cert reads over cert_body).
    tbs_dlen = tbs_end - tbs_start
    full_tbs = bytes.new(tbs_dlen)
    if tbs_dlen > 0 { bytes.set(full_tbs, tbs_dlen - 1, 0) }
    bytes.copy_from_bytes(full_tbs, 0, cert_body, tbs_start, tbs_dlen)
    out.tbs = full_tbs
    out.tbs_len = tbs_dlen

    // outer signatureAlgorithm (SEQUENCE) then signatureValue (BIT STRING).
    salg_body, salg_full, saerr = asn1.read_sequence(cert)
    if string.equals(saerr, "") == 1 {
        soid, soerr = asn1.read_oid(salg_body)
        if string.equals(soerr, "") == 1 { out.sig_alg_oid = oid_to_bytes(soid); string.release(soid) }
        asn1.reader_free(salg_body)
        bytes.free(salg_full)
    }
    sigbits, _snbits, sberr = asn1.read_bit_string(cert)
    if string.equals(sberr, "") == 1 {
        out.signature = sigbits
        out.signature_len = bytes.length(sigbits)
    }

    // Positional walk of the TBS content.
    tbsr = asn1.reader_new(tbs_content)
    perr = parse_tbs_fields(tbsr, out)
    asn1.reader_free(tbsr)

    bytes.free(tbs_content)
    asn1.reader_free(cert)
    asn1.reader_free(top)
    bytes.free(view)
    bytes.free(cert_body)
    return perr
}

// TBSCertificate ::= SEQUENCE {
//   [0] version DEFAULT v1, serialNumber, signature AlgId, issuer Name,
//   validity SEQUENCE { notBefore Time, notAfter Time }, subject Name,
//   subjectPublicKeyInfo, ... [3] extensions OPTIONAL }
// `tbsr` reads the TBS *content* (fields in order).
fn parse_tbs_fields(tbsr: ptr, out: *LeafCert) -> string {
    // [0] version (context tag 0xA0) — optional; skip if present.
    v, verr = asn1.read_tlv(tbsr)
    vtag = asn1.last_tag(tbsr)
    if string.equals(verr, "") == 1 && vtag == 0xA0 {
        // [0] EXPLICIT Version INTEGER: one content byte, 0..2.
        vr0 = asn1.reader_new(v)
        vi, vierr = asn1.read_tlv(vr0)
        if string.equals(vierr, "") == 1 && asn1.last_tag(vr0) == 0x02 && bytes.length(vi) == 1 {
            out.version = bytes.get(vi, 0) & 0xFF
        } else {
            out.version = -1
        }
        if vi != null { bytes.free(vi) }
        asn1.reader_free(vr0)
    }
    bytes.free(v)
    // Every read below used to drop its error, so a truncated or malformed
    // certificate parsed "successfully" into a LeafCert whose fields came
    // from reads that failed -- an issuer, subject, validity or SPKI the
    // certificate does not actually carry. The neighbouring serialNumber /
    // notBefore / notAfter reads already checked; these six did not (#1942).
    if string.equals(verr, "") != 1 { return verr }
    if vtag != 0xA0 {
        // `v` was actually serialNumber; the field after version is
        // serialNumber, so if there was no version we've now consumed
        // serialNumber and should NOT read it again. Track this.
        // (Handled below by not reading serialNumber when vtag != 0xA0.)
    }

    // serialNumber INTEGER — only present-to-read if we consumed [0] above.
    if vtag == 0xA0 {
        sn, snerr = asn1.read_tlv(tbsr)
        if string.equals(snerr, "") != 1 { return snerr }
        bytes.free(sn)
    }

    // signature AlgorithmIdentifier (SEQUENCE) — skip.
    sa, saerr = asn1.read_tlv(tbsr)
    bytes.free(sa)
    if string.equals(saerr, "") != 1 { return saerr }

    // issuer Name (SEQUENCE) — capture raw DER (tag+len+content).
    iss, ierr = read_tlv_full(tbsr)
    if string.equals(ierr, "") != 1 { bytes.free(iss); return ierr }
    out.issuer = iss
    out.issuer_len = bytes.length(iss)

    // validity SEQUENCE { notBefore, notAfter }.
    val_content, valerr = asn1.read_tlv(tbsr)
    if string.equals(valerr, "") != 1 { bytes.free(val_content); return valerr }
    vr = asn1.reader_new(val_content)
    nb, nberr = asn1.read_tlv(vr)
    if string.equals(nberr, "") == 1 { out.not_before = nb; out.not_before_len = bytes.length(nb) }
    na, naerr = asn1.read_tlv(vr)
    if string.equals(naerr, "") == 1 { out.not_after = na; out.not_after_len = bytes.length(na) }
    asn1.reader_free(vr)
    bytes.free(val_content)

    // subject Name (SEQUENCE) — capture raw DER.
    subj, suberr = read_tlv_full(tbsr)
    if string.equals(suberr, "") != 1 { bytes.free(subj); return suberr }
    out.subject = subj
    out.subject_len = bytes.length(subj)

    // subjectPublicKeyInfo SEQUENCE { algorithm AlgId, subjectPublicKey BIT }.
    spki_content, spkierr = asn1.read_tlv(tbsr)
    if string.equals(spkierr, "") != 1 { bytes.free(spki_content); return spkierr }
    sr = asn1.reader_new(spki_content)
    algo_body, algo_full, ae = asn1.read_sequence(sr)
    if string.equals(ae, "") == 1 {
        oid, oerr = asn1.read_oid(algo_body)
        if string.equals(oerr, "") == 1 { out.spki_algo_oid = oid_to_bytes(oid); string.release(oid) }
        asn1.reader_free(algo_body)
        bytes.free(algo_full)
    }
    bitkey, _nbits, berr = asn1.read_bit_string(sr)
    if string.equals(berr, "") == 1 {
        out.spki_key = bitkey
        out.spki_key_len = bytes.length(bitkey)
    }
    asn1.reader_free(sr)
    bytes.free(spki_content)

    // Remaining: optional [1]/[2] unique IDs and [3] extensions. Scan for the
    // [3] EXPLICIT extensions wrapper (tag 0xA3) and parse SAN out of it.
    out.dns_names = list_new()
    out.ip_addrs = list_new()
    while asn1.reader_eof(tbsr) != 1 {
        ext_content, eerr = asn1.read_tlv(tbsr)
        if string.equals(eerr, "") != 1 { break }
        etag = asn1.last_tag(tbsr)
        if etag == 0xA3 {
            if out.version != 2 { out.ext_bits = out.ext_bits | EXT_MALFORMED }
            parse_extensions(ext_content, out)
        }
        bytes.free(ext_content)
    }

    return ""
}

// Read a TLV and return its FULL DER (tag+len+content) as fresh bytes.
fn read_tlv_full(r: ptr) -> (ptr, string) {
    start = asn1.reader_pos(r)
    content, err = asn1.read_tlv(r)
    if string.equals(err, "") != 1 { return null, err }
    bytes.free(content)
    end = asn1.reader_pos(r)
    // The reader's buffer holds the bytes; re-read the span. We need access to
    // the buffer — read_tlv already advanced it. Reconstruct by re-reading the
    // span from a fresh reader over the same buffer is not possible without the
    // buffer handle, so instead compute from the reader's buffer via a helper.
    return reader_slice(r, start, end), ""
}

// Slice [start,end) of the reader's underlying buffer into fresh bytes.
fn reader_slice(r: ptr, start: int, end: int) -> ptr {
    rr = r as *CertReaderView
    n = end - start
    out = bytes.new(n)
    if n > 0 { bytes.set(out, n - 1, 0) }
    bytes.copy_from_bytes(out, 0, rr.buf, start, n)
    return out
}

// Minimal view of asn1's Reader to reach its buffer for slicing (buf is the
// first field; this mirrors asn1.Reader's layout).
struct CertReaderView {
    buf: ptr
    pos: int
    len: int
    last_tag: int
}

// ---- extensions (RFC 5280 4.2) ----
//
// What path validation needs from each certificate: basicConstraints,
// keyUsage, extKeyUsage and nameConstraints (#1298, the x509-limbo corpus),
// the SAN names, and whether anything was critical but unknown, repeated, or
// malformed. A certificate with such an extension is refused wherever it
// appears in a path.
const EXT_BC = 1 // basicConstraints present
const EXT_PATHLEN = 4 // basicConstraints pathLenConstraint present
const EXT_EKU = 16 // extKeyUsage present
const EXT_NC = 32 // nameConstraints present
const EXT_UNKNOWN_CRITICAL = 64 // a critical extension this code does not process
const EXT_DUPLICATE = 128 // an extension OID appears twice
const EXT_MALFORMED = 256 // an extension this code processes did not parse
const EXT_SAN = 512 // subjectAltName present
const EXT_SAN_EMPTY = 1024 // subjectAltName with no names

const EKU_SERVER = 1 // id-kp-serverAuth
const EKU_CLIENT = 2 // id-kp-clientAuth
const EKU_ANY = 4 // anyExtendedKeyUsage
const EKU_OTHER = 8 // anything else

const KU_DIGITAL_SIGNATURE = 1 // bit 0
const KU_KEY_CERT_SIGN = 32 // bit 5

// The extnValue of every Extension in the [3] wrapper, dispatched on extnID.
fn parse_extensions(ext_wrapper: @keep ptr, out: *LeafCert) {
    wr = asn1.reader_new(ext_wrapper)
    // [3] wraps a single SEQUENCE OF Extension.
    seq_content, serr = asn1.read_tlv(wr)
    seq_tag = asn1.last_tag(wr)
    asn1.reader_free(wr)
    if string.equals(serr, "") != 1 || seq_tag != 0x30 {
        out.ext_bits = out.ext_bits | EXT_MALFORMED
        if seq_content != null { bytes.free(seq_content) }
        return
    }
    seen = list_new()
    er = asn1.reader_new(seq_content)
    while asn1.reader_eof(er) != 1 {
        one, oerr = asn1.read_tlv(er) // one Extension SEQUENCE content
        if string.equals(oerr, "") != 1 {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
            break
        }
        xr = asn1.reader_new(one)
        oid, oiderr = asn1.read_oid(xr)
        if string.equals(oiderr, "") == 1 {
            ob = oid_to_bytes(oid)
            if bytes_list_has(seen, ob) == 1 {
                out.ext_bits = out.ext_bits | EXT_DUPLICATE
                bytes.free(ob)
            } else {
                list.add(seen, ob)
            }
            value, critical = read_extn_value(xr)
            if value == null {
                out.ext_bits = out.ext_bits | EXT_MALFORMED
            } else {
                parse_one_extension(oid, critical, value, out)
                bytes.free(value)
            }
            string.release(oid)
        } else {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
        }
        asn1.reader_free(xr)
        bytes.free(one)
    }
    asn1.reader_free(er)
    bytes.free(seq_content)
    free_bytes_list(seen)
}

// 1 if the std.list of std.bytes `l` holds a buffer equal to `b`.
fn bytes_list_has(l: ptr, b: ptr) -> int {
    n = list_size(l)
    bl = bytes.length(b)
    i = 0
    while i < n {
        e = list.at(l, i) as ptr
        if e != null && bytes.length(e) == bl {
            same = 1
            k = 0
            while k < bl {
                if bytes.get(e, k) != bytes.get(b, k) { same = 0 }
                k = k + 1
            }
            if same == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

fn parse_one_extension(oid: string, critical: int, value: @keep ptr, out: *LeafCert) {
    if string.equals(oid, "2.5.29.17") == 1 {
        out.ext_bits = out.ext_bits | EXT_SAN
        n_any = decode_san_dnsnames(value, out)
        if n_any == 0 { out.ext_bits = out.ext_bits | EXT_SAN_EMPTY }
        return
    }
    if string.equals(oid, "2.5.29.19") == 1 {
        out.ext_bits = out.ext_bits | EXT_BC
        decode_basic_constraints(value, out)
        return
    }
    if string.equals(oid, "2.5.29.15") == 1 {
        decode_key_usage(value, out)
        return
    }
    if string.equals(oid, "2.5.29.37") == 1 {
        out.ext_bits = out.ext_bits | EXT_EKU
        parse_ext_key_usage(value, out)
        return
    }
    if string.equals(oid, "2.5.29.30") == 1 {
        out.ext_bits = out.ext_bits | EXT_NC
        parse_name_constraints(value, out)
        return
    }
    // Recognised and not acted on: subject/authority key identifiers, CRL
    // distribution points, authority information access, certificate
    // policies, SCTs. Anything else that is critical cannot be honoured.
    if string.equals(oid, "2.5.29.14") == 1 || string.equals(oid, "2.5.29.35") == 1 { return }
    if string.equals(oid, "2.5.29.31") == 1 || string.equals(oid, "1.3.6.1.5.5.7.1.1") == 1 { return }
    if string.equals(oid, "2.5.29.32") == 1 || string.equals(oid, "1.3.6.1.4.1.11129.2.4.2") == 1 { return }
    if critical == 1 { out.ext_bits = out.ext_bits | EXT_UNKNOWN_CRITICAL }
}

// ExtKeyUsageSyntax ::= SEQUENCE SIZE (1..MAX) OF KeyPurposeId
fn parse_ext_key_usage(value: @keep ptr, out: *LeafCert) {
    r = asn1.reader_new(value)
    body, berr = asn1.read_tlv(r)
    btag = asn1.last_tag(r)
    asn1.reader_free(r)
    if string.equals(berr, "") != 1 || btag != 0x30 {
        out.ext_bits = out.ext_bits | EXT_MALFORMED
        if body != null { bytes.free(body) }
        return
    }
    br = asn1.reader_new(body)
    count = 0
    while asn1.reader_eof(br) != 1 {
        kp, kperr = asn1.read_oid(br)
        if string.equals(kperr, "") != 1 {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
            break
        }
        count = count + 1
        if string.equals(kp, "1.3.6.1.5.5.7.3.1") == 1 {
            out.eku_bits = out.eku_bits | EKU_SERVER
        } else if string.equals(kp, "1.3.6.1.5.5.7.3.2") == 1 {
            out.eku_bits = out.eku_bits | EKU_CLIENT
        } else if string.equals(kp, "2.5.29.37.0") == 1 {
            out.eku_bits = out.eku_bits | EKU_ANY
        } else {
            out.eku_bits = out.eku_bits | EKU_OTHER
        }
        string.release(kp)
    }
    if count == 0 { out.ext_bits = out.ext_bits | EXT_MALFORMED }
    asn1.reader_free(br)
    bytes.free(body)
}

// NameConstraints ::= SEQUENCE { permittedSubtrees [0] GeneralSubtrees OPTIONAL,
//                                excludedSubtrees  [1] GeneralSubtrees OPTIONAL }
// GeneralSubtree ::= SEQUENCE { base GeneralName, minimum [0] DEFAULT 0,
//                               maximum [1] OPTIONAL }
// Each base is kept as its tag byte followed by its content.
fn parse_name_constraints(value: @keep ptr, out: *LeafCert) {
    r = asn1.reader_new(value)
    body, berr = asn1.read_tlv(r)
    btag = asn1.last_tag(r)
    asn1.reader_free(r)
    if string.equals(berr, "") != 1 || btag != 0x30 {
        out.ext_bits = out.ext_bits | EXT_MALFORMED
        if body != null { bytes.free(body) }
        return
    }
    br = asn1.reader_new(body)
    while asn1.reader_eof(br) != 1 {
        trees, terr = asn1.read_tlv(br)
        ttag = asn1.last_tag(br)
        if string.equals(terr, "") != 1 {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
            break
        }
        if ttag == 0xA0 || ttag == 0xA1 {
            dest = list_new()
            tr = asn1.reader_new(trees)
            while asn1.reader_eof(tr) != 1 {
                sub, suberr = asn1.read_tlv(tr)
                if string.equals(suberr, "") != 1 || asn1.last_tag(tr) != 0x30 {
                    out.ext_bits = out.ext_bits | EXT_MALFORMED
                    if sub != null { bytes.free(sub) }
                    break
                }
                sr = asn1.reader_new(sub)
                base, baseerr = asn1.read_tlv(sr)
                btag2 = asn1.last_tag(sr)
                if string.equals(baseerr, "") == 1 {
                    bl = bytes.length(base)
                    e = bytes.new(bl + 1)
                    bytes.set(e, bl, 0)
                    bytes.set(e, 0, btag2)
                    if bl > 0 { bytes.copy_from_bytes(e, 1, base, 0, bl) }
                    list.add(dest, e)
                    bytes.free(base)
                    // minimum other than 0, or any maximum, is not used by the
                    // Web PKI (RFC 5280 4.2.1.10 says MUST be absent).
                    if asn1.reader_eof(sr) != 1 { out.ext_bits = out.ext_bits | EXT_MALFORMED }
                } else {
                    out.ext_bits = out.ext_bits | EXT_MALFORMED
                }
                asn1.reader_free(sr)
                bytes.free(sub)
            }
            asn1.reader_free(tr)
            if ttag == 0xA0 {
                free_bytes_list(out.nc_permitted)
                out.nc_permitted = dest
            } else {
                free_bytes_list(out.nc_excluded)
                out.nc_excluded = dest
            }
        } else {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
        }
        bytes.free(trees)
    }
    asn1.reader_free(br)
    bytes.free(body)
}

// Read an Extension's extnValue OCTET STRING content, after the optional
// critical BOOLEAN: (fresh bytes, critical), or (null, 0) when the
// Extension does not parse: a BOOLEAN that is not one byte of 0x00 or 0xFF
// (X.690 8.2, 11.1), an extnValue that is not an OCTET STRING, or anything
// after it. The caller refuses the certificate then (EXT_MALFORMED).
fn read_extn_value(xr: ptr) -> (ptr, int) {
    nx, nxerr = asn1.read_tlv(xr)
    if string.equals(nxerr, "") != 1 { return null, 0 }
    if asn1.last_tag(xr) != 0x01 {
        if asn1.last_tag(xr) != 0x04 || asn1.reader_eof(xr) != 1 {
            bytes.free(nx)
            return null, 0
        }
        return nx, 0
    }
    critical = -1
    if bytes.length(nx) == 1 && (bytes.get(nx, 0) & 0xFF) == 0xFF { critical = 1 }
    if bytes.length(nx) == 1 && (bytes.get(nx, 0) & 0xFF) == 0 { critical = 0 }
    bytes.free(nx)
    if critical < 0 { return null, 0 }
    os2, os2e = asn1.read_tlv(xr)
    if string.equals(os2e, "") != 1 { return null, 0 }
    if asn1.last_tag(xr) != 0x04 || asn1.reader_eof(xr) != 1 {
        bytes.free(os2)
        return null, 0
    }
    return os2, critical
}

// basicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE,
// pathLenConstraint INTEGER (0..MAX) OPTIONAL }. A cA of TRUE sets
// out.is_ca; a pathLenConstraint goes to out.path_len (EXT_PATHLEN). A
// BOOLEAN that is not one byte of 0x00 or 0xFF, a pathLenConstraint that is
// negative or over three bytes, and anything else make the extension
// malformed (EXT_MALFORMED), so the certificate is refused rather than read
// as not a CA.
fn decode_basic_constraints(octet_content: @keep ptr, out: *LeafCert) {
    r = asn1.reader_new(octet_content)
    body, berr = asn1.read_tlv(r)
    btag = asn1.last_tag(r)
    asn1.reader_free(r)
    if string.equals(berr, "") != 1 || btag != 0x30 {
        out.ext_bits = out.ext_bits | EXT_MALFORMED
        if body != null { bytes.free(body) }
        return
    }
    br = asn1.reader_new(body)
    while asn1.reader_eof(br) != 1 {
        f, ferr = asn1.read_tlv(br)
        ftag = asn1.last_tag(br)
        if string.equals(ferr, "") != 1 {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
            break
        }
        if ftag == 0x01 {
            if bytes.length(f) == 1 && (bytes.get(f, 0) & 0xFF) == 0xFF {
                out.is_ca = 1
            } else if bytes.length(f) != 1 || (bytes.get(f, 0) & 0xFF) != 0 {
                out.ext_bits = out.ext_bits | EXT_MALFORMED
            }
        } else if ftag == 0x02 {
            fl = bytes.length(f)
            if fl < 1 || fl > 3 || (bytes.get(f, 0) & 0x80) != 0 {
                out.ext_bits = out.ext_bits | EXT_MALFORMED
            } else {
                v = 0
                k = 0
                while k < fl {
                    v = (v << 8) | (bytes.get(f, k) & 0xFF)
                    k = k + 1
                }
                out.path_len = v
                out.ext_bits = out.ext_bits | EXT_PATHLEN
            }
        } else {
            out.ext_bits = out.ext_bits | EXT_MALFORMED
        }
        bytes.free(f)
    }
    asn1.reader_free(br)
    bytes.free(body)
}

// keyUsage ::= BIT STRING. The extension sets out.has_key_usage; bit i
// (counting from the first byte's top bit) becomes (1 << i) in
// out.key_usage, and keyCertSign, bit 5, sets out.key_cert_sign. A value
// that is not a BIT STRING makes the extension malformed (EXT_MALFORMED),
// so the certificate is refused rather than read as having no keyUsage.
fn decode_key_usage(octet_content: @keep ptr, out: *LeafCert) {
    out.has_key_usage = 1
    r = asn1.reader_new(octet_content)
    bits, _unused, berr = asn1.read_bit_string(r)
    asn1.reader_free(r)
    if string.equals(berr, "") != 1 || bits == null {
        out.ext_bits = out.ext_bits | EXT_MALFORMED
        return
    }
    n = bytes.length(bits)
    ku = 0
    i = 0
    while i < n * 8 && i < 16 {
        if ((bytes.get(bits, i / 8) >> (7 - (i % 8))) & 1) == 1 { ku = ku | (1 << i) }
        i = i + 1
    }
    out.key_usage = ku
    if (ku & KU_KEY_CERT_SIGN) != 0 { out.key_cert_sign = 1 }
    bytes.free(bits)
}

// The SAN extnValue OCTET STRING wraps GeneralNames ::= SEQUENCE OF GeneralName.
// dNSName is [2] IMPLICIT IA5String (context tag 0x82). Add each to dns_names,
// (and each iPAddress to ip_addrs), and return how many GeneralNames there were,
// rejecting any with an embedded NUL.
fn decode_san_dnsnames(octet_content: @keep ptr, out: *LeafCert) -> int {
    or = asn1.reader_new(octet_content)
    gn_content, gerr = asn1.read_tlv(or) // the GeneralNames SEQUENCE content
    asn1.reader_free(or)
    if string.equals(gerr, "") != 1 { return 0 }
    int count = 0
    gr = asn1.reader_new(gn_content)
    while asn1.reader_eof(gr) != 1 {
        name_content, nerr = asn1.read_tlv(gr)
        if string.equals(nerr, "") != 1 { break }
        tag = asn1.last_tag(gr)
        count = count + 1
        if tag == 0x87 {
            // iPAddress [7] IMPLICIT OCTET STRING -- 4 bytes for IPv4, 16 for
            // IPv6, raw network order (RFC 5280 s4.2.1.6). Any other length is
            // malformed; skip it rather than match against it.
            alen = bytes.length(name_content)
            if alen == 4 || alen == 16 {
                ip = bytes.new(alen)
                bytes.copy_from_bytes(ip, 0, name_content, 0, alen)
                list.add(out.ip_addrs, ip)
            }
        }
        if tag == 0x82 {
            // dNSName IA5String content
            nlen = bytes.length(name_content)
            has_nul = 0
            i = 0
            while i < nlen {
                if (bytes.get(name_content, i) & 0xFF) == 0 { has_nul = 1 }
                i = i + 1
            }
            if has_nul == 0 {
                nm = bytes.new(nlen)
                if nlen > 0 { bytes.set(nm, nlen - 1, 0) }
                bytes.copy_from_bytes(nm, 0, name_content, 0, nlen)
                list.add(out.dns_names, nm)
            }
        }
        bytes.free(name_content)
    }
    asn1.reader_free(gr)
    bytes.free(gn_content)
    return count
}

// ---- LeafCert accessors + cleanup ----

// Copy a transient OID string into an owned bytes buffer (so it can live in a
// struct field and be freed deterministically).
fn oid_to_bytes(oid: string) -> ptr {
    n = string.length(oid)
    b = bytes.new(n)
    if n > 0 { bytes.set(b, n - 1, 0) }
    i = 0
    while i < n {
        bytes.set(b, i, string_char_at_n(oid, n, i) & 0xFF)
        i = i + 1
    }
    return b
}

leaf_not_before(c: *LeafCert) -> ptr { return c.not_before }
leaf_not_before_len(c: *LeafCert) -> int { return c.not_before_len }
leaf_not_after(c: *LeafCert) -> ptr { return c.not_after }
leaf_not_after_len(c: *LeafCert) -> int { return c.not_after_len }
leaf_tbs_len(c: *LeafCert) -> int { return c.tbs_len }
leaf_subject_len(c: *LeafCert) -> int { return c.subject_len }
leaf_issuer_len(c: *LeafCert) -> int { return c.issuer_len }
leaf_is_ca(c: *LeafCert) -> int { return c.is_ca }
leaf_key_cert_sign(c: *LeafCert) -> int { return c.key_cert_sign }

leaf_dns_count(c: *LeafCert) -> int {
    if c.dns_names == null { return 0 }
    return list_size(c.dns_names)
}

// The i-th dNSName as a bytes buffer (borrowed; do not free).
leaf_dns_name(c: *LeafCert, i: int) -> ptr {
    if c.dns_names == null { return null }
    if i < 0 { return null }
    if i >= list_size(c.dns_names) { return null }
    return list.at(c.dns_names, i) as ptr
}

// Free every owned buffer/string in a parsed LeafCert.
free_leaf(c: *LeafCert) {
    if c.tbs != null { bytes.free(c.tbs) }
    if c.signature != null { bytes.free(c.signature) }
    if c.spki_key != null { bytes.free(c.spki_key) }
    if c.issuer != null { bytes.free(c.issuer) }
    if c.subject != null { bytes.free(c.subject) }
    if c.sig_alg_oid != null { bytes.free(c.sig_alg_oid) }
    if c.spki_algo_oid != null { bytes.free(c.spki_algo_oid) }
    if c.not_before != null { bytes.free(c.not_before) }
    if c.not_after != null { bytes.free(c.not_after) }
    if c.dns_names != null {
        n = list_size(c.dns_names)
        i = 0
        while i < n {
            e = list.at(c.dns_names, i) as ptr
            bytes.free(e)
            i = i + 1
        }
        list_free(c.dns_names)
    }
    if c.ip_addrs != null {
        m = list_size(c.ip_addrs)
        j = 0
        while j < m {
            a = list.at(c.ip_addrs, j) as ptr
            bytes.free(a)
            j = j + 1
        }
        list_free(c.ip_addrs)
    }
    free_bytes_list(c.nc_permitted)
    free_bytes_list(c.nc_excluded)
    c.nc_permitted = null
    c.nc_excluded = null
}

// Free a std.list of std.bytes buffers (null-safe).
fn free_bytes_list(l: ptr) {
    if l == null { return }
    n = list_size(l)
    i = 0
    while i < n {
        e = list.at(l, i) as ptr
        if e != null { bytes.free(e) }
        i = i + 1
    }
    list_free(l)
}

// ---- validity-period check (RFC 5280 §4.1.2.5) ----

// Normalise an ASN.1 time (as bytes: UTCTime "YYMMDDHHMMSSZ" or
// GeneralizedTime "YYYYMMDDHHMMSSZ") to a 14-char "YYYYMMDDHHMMSS" key string,
// so times compare chronologically by plain string order. Returns "" on a
// malformed/unsupported time. UTCTime year: YY>=50 -> 19YY else 20YY (RFC 5280).
fn time_to_key(t: ptr, tlen: int) -> string {
    // Collect the leading digits (drop a trailing 'Z').
    digits = bytes.new(16)
    dn = 0
    i = 0
    while i < tlen {
        c = bytes.get(t, i) & 0xFF
        if c >= 48 && c <= 57 {
            if dn < 14 { bytes.set(digits, dn, c); dn = dn + 1 }
        }
        i = i + 1
    }
    if dn == 12 {
        // UTCTime YYMMDDHHMMSS -> expand the 2-digit year
        yy = ((bytes.get(digits, 0) - 48) * 10) + (bytes.get(digits, 1) - 48)
        century = 20
        if yy >= 50 { century = 19 }
        out = bytes.new(14)
        bytes.set(out, 0, 48 + (century / 10))
        bytes.set(out, 1, 48 + (century - ((century / 10) * 10)))
        k = 0
        while k < 12 { bytes.set(out, 2 + k, bytes.get(digits, k)); k = k + 1 }
        r = bytes.to_string(out, 14)
        bytes.free(out); bytes.free(digits)
        return r
    }
    if dn == 14 {
        r = bytes.to_string(digits, 14)
        bytes.free(digits)
        return r
    }
    bytes.free(digits)
    return ""
}

// Current UTC time as the same 14-char "YYYYMMDDHHMMSS" key. Derives it from
// os.now_utc_iso8601() ("YYYY-MM-DDTHH:MM:SSZ") by keeping the digits.
fn now_key() -> string {
    iso = os.now_utc_iso8601()
    n = string.length(iso)
    out = bytes.new(14)
    dn = 0
    i = 0
    while i < n {
        c = string_char_at_n(iso, n, i) & 0xFF
        if c >= 48 && c <= 57 {
            if dn < 14 { bytes.set(out, dn, c); dn = dn + 1 }
        }
        i = i + 1
    }
    r = bytes.to_string(out, 14)
    bytes.free(out)
    return r
}

// Check a leaf's validity window against the current time. Returns "" if
// notBefore <= now <= notAfter, else an error ("certificate expired" /
// "certificate not yet valid" / "certificate has no/invalid validity").
check_validity(c: *LeafCert) -> string {
    if c.not_before == null { return "certificate has no notBefore" }
    if c.not_after == null { return "certificate has no notAfter" }
    nb = time_to_key(c.not_before, c.not_before_len)
    na = time_to_key(c.not_after, c.not_after_len)
    if string.equals(nb, "") == 1 { return "certificate has invalid notBefore time" }
    if string.equals(na, "") == 1 { return "certificate has invalid notAfter time" }
    now = now_key()
    // string_compare: <0 if a<b. now < nb -> not yet valid; now > na -> expired.
    if string_compare(now, nb) < 0 { return "certificate not yet valid" }
    if string_compare(now, na) > 0 { return "certificate expired" }
    return ""
}

// ---- hostname / SAN matching (RFC 6125) ----

// ASCII lower-case a single byte (A-Z -> a-z), leaving others untouched.
fn ascii_lower(c: int) -> int {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

// Does the presented dNSName (a bytes buffer, `plen` bytes, no NUL) match the
// reference hostname `host` (a string) under RFC 6125? Case-insensitive ASCII.
// A single leftmost "*" wildcard label is allowed and matches exactly one
// label (no dots): "*.a.com" matches "x.a.com" but not "a.com" or "y.x.a.com".
// A wildcard anywhere but the leftmost label, or a partial-label wildcard
// ("f*.a.com"), is not accepted here (we only honour a whole-label leading *).
fn dnsname_matches(pat: ptr, plen: int, host: string, hlen: int) -> int {
    if plen <= 0 { return 0 }
    // Wildcard iff the pattern is "*." + rest  (first byte '*', second '.').
    is_wild = 0
    if plen >= 2 {
        if (bytes.get(pat, 0) & 0xFF) == 42 { // '*'
            if (bytes.get(pat, 1) & 0xFF) == 46 { // '.'
                is_wild = 1
            }
        }
    }
    if is_wild == 0 {
        // Exact case-insensitive match over the whole strings.
        if plen != hlen { return 0 }
        i = 0
        while i < plen {
            pc = ascii_lower(bytes.get(pat, i) & 0xFF)
            hc = ascii_lower(string_char_at_n(host, hlen, i) & 0xFF)
            if pc != hc { return 0 }
            i = i + 1
        }
        return 1
    }
    // Wildcard: the host's first label is consumed by '*', the remainder
    // (pattern from index 1, i.e. ".rest") must match the host from its first
    // dot onward, case-insensitively. The wildcard label must be non-empty and
    // must not itself contain a dot (exactly one label).
    // Find host's first dot.
    hdot = -1
    j = 0
    while j < hlen {
        if (string_char_at_n(host, hlen, j) & 0xFF) == 46 { hdot = j; break }
        j = j + 1
    }
    if hdot <= 0 { return 0 } // no dot, or empty first label -> no match
    // The pattern tail is pat[1..plen) == ".rest"; host tail is host[hdot..hlen).
    tail_len = plen - 1
    if tail_len != (hlen - hdot) { return 0 }
    k = 0
    while k < tail_len {
        pc = ascii_lower(bytes.get(pat, 1 + k) & 0xFF)
        hc = ascii_lower(string_char_at_n(host, hlen, hdot + k) & 0xFF)
        if pc != hc { return 0 }
        k = k + 1
    }
    return 1
}

// Verify the leaf certificate identifies `host`. Checks every SAN dNSName
// (RFC 6125; SAN-only, no CN fallback). Returns "" on a match, else an error.
// Parse a dotted-quad into 4 bytes, or null when `host` is not an IPv4
// literal -- which is the signal to fall through to dNSName matching.
fn parse_ipv4(host: string, hlen: int) -> ptr {
    out = bytes.new(4)
    octet = 0
    digits = 0
    idx = 0
    i = 0
    bad = 0
    while i < hlen {
        ch = string_char_at_n(host, hlen, i) & 0xFF
        if ch == 46 {
            if digits == 0 { bad = 1 }
            if idx > 2 { bad = 1 }
            if bad == 0 {
                bytes.set(out, idx, octet)
                idx = idx + 1
                octet = 0
                digits = 0
            }
        } else {
            if ch < 48 { bad = 1 }
            if ch > 57 { bad = 1 }
            if bad == 0 {
                octet = octet * 10 + (ch - 48)
                digits = digits + 1
                if octet > 255 { bad = 1 }
                if digits > 3 { bad = 1 }
            }
        }
        i = i + 1
    }
    if digits == 0 { bad = 1 }
    if idx != 3 { bad = 1 }
    if bad == 1 {
        bytes.free(out)
        return null
    }
    bytes.set(out, 3, octet)
    return out
}

// The value of one hex digit, or -1.
fn hex_digit(ch: int) -> int {
    if ch >= 48 && ch <= 57 { return ch - 48 }
    if ch >= 97 && ch <= 102 { return ch - 87 }
    if ch >= 65 && ch <= 70 { return ch - 55 }
    return -1
}

// Parse an IPv6 literal (RFC 4291 s2.2 text form, "::" at most once, no
// brackets) into 16 bytes, or null when `host` is not one. Stricter than the
// RFC on purpose: a zone ("%eth0") and an embedded dotted IPv4 tail
// ("::ffff:192.0.2.1") are refused, and the caller then refuses the host
// rather than matching it against dNSNames.
fn parse_ipv6(host: string, hlen: int) -> ptr {
    if hlen < 2 { return null }
    // Each group as it is read, two bytes apiece; placed around the gap at
    // the end.
    words = bytes.new(16)
    nw = 0
    gap = -1
    bad = 0
    i = 0
    if (string_char_at_n(host, hlen, 0) & 0xFF) == 58 {
        if (string_char_at_n(host, hlen, 1) & 0xFF) != 58 {
            bad = 1
        } else {
            gap = 0
            i = 2
        }
    }
    while bad == 0 && i < hlen {
        v = 0
        digits = 0
        stop = 0
        while stop == 0 && i < hlen {
            hv = hex_digit(string_char_at_n(host, hlen, i) & 0xFF)
            if hv < 0 {
                stop = 1
            } else {
                v = v * 16 + hv
                digits = digits + 1
                i = i + 1
            }
        }
        if digits == 0 || digits > 4 || nw >= 8 {
            bad = 1
        } else {
            bytes.set(words, 2 * nw, (v >> 8) & 0xFF)
            bytes.set(words, 2 * nw + 1, v & 0xFF)
            nw = nw + 1
        }
        if bad == 0 && i < hlen {
            if (string_char_at_n(host, hlen, i) & 0xFF) != 58 {
                bad = 1
            } else {
                i = i + 1
                if i < hlen && (string_char_at_n(host, hlen, i) & 0xFF) == 58 {
                    if gap >= 0 { bad = 1 }
                    gap = nw
                    i = i + 1
                } else if i == hlen {
                    bad = 1 // a lone trailing ':'
                }
            }
        }
    }
    if gap < 0 && nw != 8 { bad = 1 }
    if gap >= 0 && nw > 7 { bad = 1 }
    if bad == 1 {
        bytes.free(words)
        return null
    }
    // bytes.new does not zero: every byte of `out` is written below.
    out = bytes.new(16)
    k = 0
    while k < 16 {
        bytes.set(out, k, 0)
        k = k + 1
    }
    head = nw
    if gap >= 0 { head = gap }
    k = 0
    while k < 2 * head {
        bytes.set(out, k, bytes.get(words, k) & 0xFF)
        k = k + 1
    }
    tail = nw - head
    k = 0
    while k < 2 * tail {
        bytes.set(out, 16 - 2 * tail + k, bytes.get(words, 2 * head + k) & 0xFF)
        k = k + 1
    }
    bytes.free(words)
    return out
}

// 1 when `ip` (4 or 16 bytes) is one of the certificate's iPAddress SANs.
// Lengths must agree: an IPv4 address never matches a 16-byte SAN, nor an
// IPv6 one a 4-byte SAN.
fn ip_san_matches(c: *LeafCert, ip: ptr) -> int {
    if c.ip_addrs == null { return 0 }
    want = bytes.length(ip)
    n = list_size(c.ip_addrs)
    i = 0
    while i < n {
        cand = list.at(c.ip_addrs, i) as ptr
        if cand != null && bytes.length(cand) == want {
            same = 1
            b = 0
            while b < want {
                if (bytes.get(cand, b) & 0xFF) != (bytes.get(ip, b) & 0xFF) { same = 0 }
                b = b + 1
            }
            if same == 1 { return 1 }
        }
        i = i + 1
    }
    return 0
}

check_hostname(c: *LeafCert, host: string) -> string {
    hlen0 = string.length(host)
    if hlen0 == 0 { return "empty hostname" }
    // An IP literal is matched against iPAddress SANs and never against
    // dNSNames: a certificate naming the DNS name "10.0.0.1" does not
    // authorise the address 10.0.0.1, and RFC 6125 s1.7.2 keeps the two
    // namespaces apart deliberately. Connecting by IP to a local or internal
    // endpoint is common enough that refusing every such certificate -- which
    // is what dNSName-only matching did -- is a real gap rather than a
    // conservative default.
    ipv4 = parse_ipv4(host, hlen0)
    if ipv4 != null {
        if c.ip_addrs == null {
            bytes.free(ipv4)
            return "certificate has no iPAddress SAN for this address"
        }
        hit4 = ip_san_matches(c, ipv4)
        bytes.free(ipv4)
        if hit4 == 1 { return "" }
        return "certificate is not valid for the requested address"
    }
    // A colon is never part of a DNS name, so a host with one is an IPv6
    // literal or nothing: one that does not parse is refused, never tried
    // against the dNSNames.
    if string.contains(host, ":") == 1 {
        ipv6 = parse_ipv6(host, hlen0)
        if ipv6 == null { return "not a valid IPv6 address" }
        if c.ip_addrs == null {
            bytes.free(ipv6)
            return "certificate has no iPAddress SAN for this address"
        }
        hit6 = ip_san_matches(c, ipv6)
        bytes.free(ipv6)
        if hit6 == 1 { return "" }
        return "certificate is not valid for the requested address"
    }
    if c.dns_names == null { return "certificate has no subjectAltName dNSNames" }
    hlen = string.length(host)
    n = list_size(c.dns_names)
    if n == 0 { return "certificate has no subjectAltName dNSNames" }
    i = 0
    while i < n {
        nm = list.at(c.dns_names, i) as ptr
        if nm != null {
            plen = bytes.length(nm)
            if dnsname_matches(nm, plen, host, hlen) == 1 { return "" }
        }
        i = i + 1
    }
    return "certificate is not valid for the requested hostname"
}

// ---- OCSP stapling: certificate revocation status (RFC 6960 + RFC 6066 §8) ----
//
// A server may staple a signed OCSP response in the leaf CertificateEntry's
// status_request extension. parse_ocsp_status walks the response to the first
// SingleResponse's certStatus and reports good / revoked / unknown, so the
// client can fail closed on a REVOKED certificate. This checks the *status*
// only; it does NOT verify the OCSP responder's signature (that needs the
// responder's cert chain) — so it is a positive revocation signal, not a
// substitute for a full RFC 6960 validator. A missing/soft-fail staple is not
// treated as revoked (fail-open on absence, fail-closed on an explicit revoked).

const OCSP_GOOD = 0
const OCSP_REVOKED = 1
const OCSP_UNKNOWN = 2
const OCSP_ERROR = 3 // malformed / unsuccessful responseStatus

// Read a DER TLV header at buf[p]: returns (tag, content_offset, content_len,
// next_offset) or (-1,...) on truncation. Handles short + long-form lengths.
fn der_tlv(buf: ptr, p: int, end: int) -> (int, int, int, int) {
    return der_tlv_slice(bytes.view(buf), p, end)
}

// The slice form of der_tlv (#2301); der_tlv views its std.bytes handle into it.
fn der_tlv_slice(buf: byte[], p: int, end: int) -> (int, int, int, int) {
    if p + 2 > end { return -1, 0, 0, 0 }
    tag = buf[p] & 0xFF
    lb = buf[p + 1] & 0xFF
    q = p + 2
    clen = 0
    if lb < 0x80 {
        clen = lb
    } else {
        nbytes = lb & 0x7F
        // At most three length bytes (16 MB): four could overflow `clen`
        // into a negative length that passes the bound below, and the
        // callers would then walk backwards through the buffer (#3308).
        if nbytes == 0 || nbytes > 3 { return -1, 0, 0, 0 }
        if q + nbytes > end { return -1, 0, 0, 0 }
        i = 0
        while i < nbytes { clen = (clen * 256) + (buf[q] & 0xFF); q = q + 1; i = i + 1 }
    }
    if q + clen > end { return -1, 0, 0, 0 }
    return tag, q, clen, q + clen
}

// Parse a stapled OCSP response (DER) and return the first SingleResponse's
// certStatus: OCSP_GOOD / OCSP_REVOKED / OCSP_UNKNOWN, or OCSP_ERROR on a
// malformed / unsuccessful response.
parse_ocsp_status(der: byte[]) -> int {
    if der.len < 0 { panic("tls13_cert.parse_ocsp_status: the `der` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int len = der.len
    // OCSPResponse ::= SEQUENCE { responseStatus ENUMERATED, responseBytes [0] }
    t0, c0, l0, _n0 = der_tlv_slice(der, 0, len)
    if t0 != 0x30 { return OCSP_ERROR }
    end0 = c0 + l0
    // responseStatus ENUMERATED — must be 0 (successful).
    ts, cs, ls, ns = der_tlv_slice(der, c0, end0)
    if ts != 0x0A { return OCSP_ERROR }
    if ls < 1 { return OCSP_ERROR }
    if (der[cs] & 0xFF) != 0 { return OCSP_ERROR }
    // responseBytes [0] EXPLICIT SEQUENCE { responseType OID, response OCTET STRING }
    tb, cb, lb2, _nb = der_tlv_slice(der, ns, end0)
    if tb != 0xA0 { return OCSP_ERROR }
    endb = cb + lb2
    trb, crb, lrb, _nrb = der_tlv_slice(der, cb, endb) // inner SEQUENCE
    if trb != 0x30 { return OCSP_ERROR }
    endrb = crb + lrb
    toid, _coid, _loid, noid = der_tlv_slice(der, crb, endrb) // responseType OID (skip)
    if toid != 0x06 { return OCSP_ERROR }
    toct, coct, loct, _noct = der_tlv_slice(der, noid, endrb) // response OCTET STRING
    if toct != 0x04 { return OCSP_ERROR }
    // The OCTET STRING content is the DER of BasicOCSPResponse.
    return parse_basic_ocsp(der, coct, coct + loct)
}

// BasicOCSPResponse ::= SEQUENCE { tbsResponseData, signatureAlgorithm,
//                                  signature, certs [0] }
// We only need tbsResponseData -> responses -> [0].certStatus.
fn parse_basic_ocsp(buf: byte[], start: int, end: int) -> int {
    tb, cb, lb, _nb = der_tlv_slice(buf, start, end)
    if tb != 0x30 { return OCSP_ERROR }
    endb = cb + lb
    // tbsResponseData ::= SEQUENCE { version? [0], responderID, producedAt,
    //                                responses SEQUENCE OF SingleResponse, ... }
    tt, ct, lt, _nt = der_tlv_slice(buf, cb, endb)
    if tt != 0x30 { return OCSP_ERROR }
    endt = ct + lt
    // Walk tbsResponseData's fields to the first SEQUENCE OF (the `responses`).
    // responderID is [1] or [2]; producedAt is GeneralizedTime (0x18); the
    // responses is the first plain SEQUENCE (0x30) at this level.
    p = ct
    resp_seq = -1
    resp_end = -1
    while p < endt {
        ti, ci, li, ni = der_tlv_slice(buf, p, endt)
        if ti < 0 { p = endt } else {
            if ti == 0x30 { resp_seq = ci; resp_end = ci + li; p = endt }
            else { p = ni }
        }
    }
    if resp_seq < 0 { return OCSP_ERROR }
    // First SingleResponse ::= SEQUENCE { certID, certStatus, thisUpdate, ... }
    ts1, cs1, ls1, _ns1 = der_tlv_slice(buf, resp_seq, resp_end)
    if ts1 != 0x30 { return OCSP_ERROR }
    end_sr = cs1 + ls1
    // certID ::= SEQUENCE (skip it); certStatus is the NEXT element.
    tcid, _ccid, _lcid, ncid = der_tlv_slice(buf, cs1, end_sr)
    if tcid != 0x30 { return OCSP_ERROR }
    tcs, _ccs, _lcs, _ncs = der_tlv_slice(buf, ncid, end_sr)
    if tcs < 0 { return OCSP_ERROR }
    // certStatus CHOICE: good [0] IMPLICIT NULL (0x80), revoked [1] (0xA1),
    // unknown [2] IMPLICIT NULL (0x82).
    if tcs == 0x80 { return OCSP_GOOD }
    if tcs == 0xA1 { return OCSP_REVOKED }
    if tcs == 0x82 { return OCSP_UNKNOWN }
    return OCSP_ERROR
}

// Walk an OCSPResponse (DER) down to the BasicOCSPResponse SEQUENCE, returning
// (content_start, content_end) of that SEQUENCE's body or (-1,-1) on a
// malformed / non-successful response. Mirrors parse_ocsp_status's descent.
fn ocsp_basic_bounds(der: byte[]) -> (int, int) {
    if der.len < 0 { panic("tls13_cert.ocsp_basic_bounds: the `der` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int len = der.len
    t0, c0, l0, _n0 = der_tlv_slice(der, 0, len)
    if t0 != 0x30 { return -1, -1 }
    end0 = c0 + l0
    ts, cs, ls, ns = der_tlv_slice(der, c0, end0)
    if ts != 0x0A { return -1, -1 }
    if ls < 1 { return -1, -1 }
    if (der[cs] & 0xFF) != 0 { return -1, -1 }
    tb, cb, lb2, _nb = der_tlv_slice(der, ns, end0)
    if tb != 0xA0 { return -1, -1 }
    endb = cb + lb2
    trb, crb, lrb, _nrb = der_tlv_slice(der, cb, endb)
    if trb != 0x30 { return -1, -1 }
    endrb = crb + lrb
    toid, _coid, _loid, noid = der_tlv_slice(der, crb, endrb)
    if toid != 0x06 { return -1, -1 }
    toct, coct, loct, _noct = der_tlv_slice(der, noid, endrb)
    if toct != 0x04 { return -1, -1 }
    // OCTET STRING content == DER of BasicOCSPResponse SEQUENCE.
    tbr, cbr, lbr, _nbr = der_tlv_slice(der, coct, coct + loct)
    if tbr != 0x30 { return -1, -1 }
    return cbr, cbr + lbr
}

// Verify the responder signature on a stapled OCSP response (RFC 6960
// §4.2.2.2). Returns 1 iff the BasicOCSPResponse signature verifies AND the
// signer is authorized to answer for the cert whose `issuer` is passed:
//   - the issuer signed the response directly (its own key), OR
//   - a delegated responder cert is stapled in BasicOCSPResponse.certs[0],
//     itself signed by `issuer` and bearing the id-kp-OCSPSigning EKU
//     (1.3.6.1.5.5.7.3.9), and that cert's key signed the response.
// Returns 0 on any failure (bad sig, unauthorized/absent responder key,
// unsupported algorithm, malformed DER). This is a positive "the staple is
// authentic" signal; the CALLER decides policy on a 0 (today: fail-open on an
// unverifiable staple, fail-closed only on a verified REVOKED).
//
// Both RFC 6960 §4.2.2.2 responder-authorization shapes are handled and were
// verified end-to-end against real staples: direct-issuer (the cert's issuer
// signs, e.g. DigiCert) and delegated (a responder cert in certs[0], issuer-
// signed and OCSPSigning-EKU-bearing, e.g. GoDaddy). Signature algorithms:
// RSA-PKCS#1-SHA256, ECDSA-P256-SHA256, ECDSA-P384-SHA384.
// ptr-typed convenience for callers holding an issuer as a bare pointer (e.g.
// find_issuer_cert's return), so the call site needs no
// `as *tls13_cert.LeafCert` cast. Casts internally and delegates.
verify_ocsp_signature_at(der: byte[], issuer: ptr) -> int {
    return verify_ocsp_signature(der, issuer as *LeafCert)
}

verify_ocsp_signature(der: byte[], issuer: *LeafCert) -> int {
    if der.len < 0 { panic("tls13_cert.verify_ocsp_signature: the `der` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if issuer == null { return 0 }
    bstart, bend = ocsp_basic_bounds(der)
    if bstart < 0 { return 0 }

    // BasicOCSPResponse ::= SEQUENCE { tbsResponseData, signatureAlgorithm,
    //                                  signature BIT STRING, [0] certs OPTIONAL }
    // tbsResponseData: capture the FULL DER (tag+len+content) — that is the
    // signed message.
    tt, _ct, _lt, nt = der_tlv_slice(der, bstart, bend)
    if tt != 0x30 { return 0 }
    tbs_full_len = nt - bstart
    tbs = bytes.new(tbs_full_len)
    if tbs_full_len > 0 { bytes.set(tbs, tbs_full_len - 1, 0) }
    bytes.copy_from_slice(tbs, 0, der[bstart..bstart + tbs_full_len])

    // signatureAlgorithm ::= SEQUENCE { algorithm OID, ... }
    ta, ca, la, na = der_tlv_slice(der, nt, bend)
    if ta != 0x30 { bytes.free(tbs); return 0 }
    toi, coi, loi, _noi = der_tlv_slice(der, ca, ca + la)
    if toi != 0x06 { bytes.free(tbs); return 0 }
    sig_alg_oid = oid_der_to_dotted_bytes_slice(der, coi, loi)

    // signature BIT STRING — strip the leading "unused bits" octet (0x00).
    tsg, csg, lsg, nsg = der_tlv_slice(der, na, bend)
    if tsg != 0x03 { bytes.free(tbs); bytes.free(sig_alg_oid); return 0 }
    if lsg < 1 { bytes.free(tbs); bytes.free(sig_alg_oid); return 0 }
    sig_len = lsg - 1
    sig = bytes.new(sig_len)
    if sig_len > 0 { bytes.set(sig, sig_len - 1, 0) }
    bytes.copy_from_slice(sig, 0, der[csg + 1..csg + 1 + sig_len])

    // Optional certs [0] EXPLICIT SEQUENCE OF Certificate — a delegated responder.
    responder = issuer
    delegated = null as *LeafCert
    have_delegated = 0
    if nsg < bend {
        tc, cc, lc, _nc = der_tlv_slice(der, nsg, bend)
        if tc == 0xA0 {
            // certs [0] EXPLICIT wraps a SEQUENCE OF Certificate; step INTO that
            // SEQUENCE OF, then read the first Certificate SEQUENCE inside it.
            tso, cso, lso, _nso = der_tlv_slice(der, cc, cc + lc)
            tcs2 = 0
            _ccs2 = 0
            _lcs2 = 0
            ncs2 = 0
            if tso == 0x30 {
                tcs2, _ccs2, _lcs2, ncs2 = der_tlv_slice(der, cso, cso + lso)
            }
            if tcs2 == 0x30 {
                cert_der_len = ncs2 - cso
                cert_der = bytes.new(cert_der_len)
                if cert_der_len > 0 { bytes.set(cert_der, cert_der_len - 1, 0) }
                bytes.copy_from_slice(cert_der, 0, der[cso..cso + cert_der_len])
                d = malloc(LEAFCERT_SIZE) as *LeafCert
                init_leaf(d)
                perr = parse_certificate(bytes.view(cert_der)[0..cert_der_len], d)
                bytes.free(cert_der)
                if string.equals(perr, "") == 1 {
                    // The delegated responder cert must be signed by `issuer`
                    // and carry the OCSPSigning EKU. If either fails, the staple
                    // is not authentic under this cert.
                    vcs = verify_cert_signature(d, issuer)
                    eku = cert_has_ocsp_signing_eku(d)
                    if vcs == 1 {
                        if eku == 1 {
                            responder = d
                            delegated = d
                            have_delegated = 1
                        }
                    }
                }
                if have_delegated == 0 {
                    free_leaf(d)
                    free(d)
                }
            }
        }
    }

    result = 0
    if have_delegated == 1 || responder == issuer {
        result = verify_sig_over_bytes(bytes.view(tbs)[0..tbs_full_len], sig_alg_oid, bytes.view(sig)[0..sig_len], responder.spki_algo_oid, bytes.view(responder.spki_key)[0..responder.spki_key_len])
    }

    if have_delegated == 1 {
        free_leaf(delegated)
        free(delegated)
    }
    bytes.free(tbs)
    bytes.free(sig_alg_oid)
    bytes.free(sig)
    return result
}

// Decode a DER OID's content octets (`buf[coff..coff+clen)`) into a dotted
// ASCII string stored as bytes — the same representation oid_is() compares.
// Rebuilds the `06 <len> <content>` TLV and reuses asn1.read_oid so the
// base-128 decode matches the rest of the parser exactly.
fn oid_der_to_dotted_bytes(buf: ptr, coff: int, clen: int) -> ptr {
    return oid_der_to_dotted_bytes_slice(bytes.view(buf), coff, clen)
}

// The slice form of oid_der_to_dotted_bytes (#2301); oid_der_to_dotted_bytes views its std.bytes handle into it.
fn oid_der_to_dotted_bytes_slice(buf: byte[], coff: int, clen: int) -> ptr {
    lenoct = asn1.encode_len(clen)
    ll = bytes.length(lenoct)
    tlv = bytes.new(1 + ll + clen)
    if bytes.length(tlv) > 0 { bytes.set(tlv, bytes.length(tlv) - 1, 0) }
    bytes.set(tlv, 0, 0x06)
    bytes.copy_from_bytes(tlv, 1, lenoct, 0, ll)
    bytes.copy_from_slice(tlv, 1 + ll, buf[coff..coff + clen])
    bytes.free(lenoct)
    r = asn1.reader_new(tlv)
    dotted, oerr = asn1.read_oid(r)
    asn1.reader_free(r)
    bytes.free(tlv)
    if string.equals(oerr, "") != 1 { return bytes.new(0) }
    out = oid_to_bytes(dotted)
    string.release(dotted)
    return out
}

// Does a parsed cert's extendedKeyUsage include id-kp-OCSPSigning
// (1.3.6.1.5.5.7.3.9)? RFC 6960 §4.2.2.2 requires it on a delegated responder.
// Walks the cert's TBS extensions for the EKU extension (2.5.29.37) and scans
// its ExtKeyUsageSyntax (SEQUENCE OF KeyPurposeId) for the OCSPSigning OID.
// `c.tbs` holds the full tbsCertificate DER (tag+len+content).
fn cert_has_ocsp_signing_eku(c: *LeafCert) -> int {
    if c.tbs == null { return 0 }
    buf = c.tbs
    end = c.tbs_len
    // tbsCertificate ::= SEQUENCE { ... extensions [3] EXPLICIT SEQUENCE OF Extension }
    tt, ct, lt, _nt = der_tlv(buf, 0, end)
    if tt != 0x30 { return 0 }
    endt = ct + lt
    // Find the [3] context tag (0xA3) holding the extensions.
    p = ct
    ext_seq = -1
    ext_end = -1
    while p < endt {
        ti, ci, li, ni = der_tlv(buf, p, endt)
        if ti < 0 { p = endt } else {
            if ti == 0xA3 {
                // [3] EXPLICIT wraps a SEQUENCE OF Extension.
                ts, cs, ls, _ns = der_tlv(buf, ci, ci + li)
                if ts == 0x30 { ext_seq = cs; ext_end = cs + ls }
                p = endt
            } else { p = ni }
        }
    }
    if ext_seq < 0 { return 0 }
    // Each Extension ::= SEQUENCE { extnID OID, critical? BOOL, extnValue OCTET STRING }
    q = ext_seq
    while q < ext_end {
        te, ce, le, ne = der_tlv(buf, q, ext_end)
        if te < 0 { q = ext_end } else {
            if te == 0x30 {
                ext_inner_end = ce + le
                toid, coid, loid, noid = der_tlv(buf, ce, ext_inner_end)
                if toid == 0x06 {
                    oid_b = oid_der_to_dotted_bytes(buf, coid, loid)
                    is_eku = oid_is(oid_b, "2.5.29.37")
                    bytes.free(oid_b)
                    if is_eku == 1 {
                        // Skip optional critical BOOL, reach extnValue OCTET STRING.
                        tv, cv, lv, nv = der_tlv(buf, noid, ext_inner_end)
                        // If a BOOL precedes the OCTET STRING, step once more.
                        if tv == 0x01 { tv, cv, lv, nv = der_tlv(buf, nv, ext_inner_end) }
                        if tv == 0x04 {
                            // extnValue content is DER of SEQUENCE OF KeyPurposeId.
                            if eku_octets_have_ocsp_signing(buf, cv, cv + lv) == 1 { return 1 }
                        }
                        return 0
                    }
                }
            }
            q = ne
        }
    }
    return 0
}

// Scan a DER ExtKeyUsageSyntax (SEQUENCE OF KeyPurposeId OID) in
// buf[start..end) for id-kp-OCSPSigning (1.3.6.1.5.5.7.3.9). Returns 1 if found.
fn eku_octets_have_ocsp_signing(buf: ptr, start: int, end: int) -> int {
    ts, cs, ls, _ns = der_tlv(buf, start, end)
    if ts != 0x30 { return 0 }
    p = cs
    seq_end = cs + ls
    while p < seq_end {
        to, co, lo, no = der_tlv(buf, p, seq_end)
        if to < 0 { p = seq_end } else {
            if to == 0x06 {
                oid_b = oid_der_to_dotted_bytes(buf, co, lo)
                hit = oid_is(oid_b, "1.3.6.1.5.5.7.3.9")
                bytes.free(oid_b)
                if hit == 1 { return 1 }
            }
            p = no
        }
    }
    return 0
}

// ---- chain building + cert-to-cert signature verification (RFC 5280) ----
//
// Nic's third bar: a self-signed leaf (issuer == subject, no trusted anchor)
// must be REJECTED. chain_verify() rejects any leaf whose issuer DN does not
// exactly match a trusted anchor's subject DN AND whose tbsCertificate
// signature does not verify under that anchor's public key.
//
// Supported cert signature algorithms (the two that cover the real world):
//   sha256WithRSAEncryption  1.2.840.113549.1.1.11  -> RSA PKCS#1 v1.5
//   ecdsa-with-SHA256        1.2.840.10045.4.3.2    -> ECDSA P-256
//   ecdsa-with-SHA384        1.2.840.10045.4.3.3    -> ECDSA P-384
// SPKI key algorithms:
//   rsaEncryption            1.2.840.113549.1.1.1
//   id-ecPublicKey           1.2.840.10045.2.1

import std.cryptography.rsa

// Compare a bytes-stored OID (ASCII dotted string) against a literal.
fn oid_is(oid: ptr, want: string) -> int {
    if oid == null { return 0 }
    olen = bytes.length(oid)
    wlen = string.length(want)
    if olen != wlen { return 0 }
    i = 0
    while i < olen {
        if (bytes.get(oid, i) & 0xFF) != (string_char_at_n(want, wlen, i) & 0xFF) { return 0 }
        i = i + 1
    }
    return 1
}

// Byte-for-byte DER Name comparison (issuer DN vs subject DN).
fn dn_equal(a: byte[], b: byte[]) -> int {
    if a.len < 0 { panic("tls13_cert.dn_equal: the `a` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int alen = a.len
    if b.len < 0 { panic("tls13_cert.dn_equal: the `b` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int blen = b.len
    if a == null { return 0 }
    if b == null { return 0 }
    if alen != blen { return 0 }
    i = 0
    while i < alen {
        if (a[i] & 0xFF) != (b[i] & 0xFF) { return 0 }
        i = i + 1
    }
    return 1
}

// Build the DER DigestInfo for a SHA-256 hash (what PKCS#1 v1.5 verify wants):
//   SEQUENCE { SEQUENCE { OID 2.16.840.1.101.3.4.2.1, NULL }, OCTET STRING hash }
// The 19-byte fixed prefix for SHA-256 followed by the 32-byte hash.
fn sha256_digestinfo(hash32: ptr) -> ptr {
    // 30 31 30 0d 06 09 60 86 48 01 65 03 04 02 01 05 00 04 20 <hash>
    prefix = bytes.new(19)
    bytes.set(prefix, 0, 0x30); bytes.set(prefix, 1, 0x31)
    bytes.set(prefix, 2, 0x30); bytes.set(prefix, 3, 0x0d)
    bytes.set(prefix, 4, 0x06); bytes.set(prefix, 5, 0x09)
    bytes.set(prefix, 6, 0x60); bytes.set(prefix, 7, 0x86)
    bytes.set(prefix, 8, 0x48); bytes.set(prefix, 9, 0x01)
    bytes.set(prefix, 10, 0x65); bytes.set(prefix, 11, 0x03)
    bytes.set(prefix, 12, 0x04); bytes.set(prefix, 13, 0x02)
    bytes.set(prefix, 14, 0x01); bytes.set(prefix, 15, 0x05)
    bytes.set(prefix, 16, 0x00); bytes.set(prefix, 17, 0x04)
    bytes.set(prefix, 18, 0x20)
    di = bytes.new(51)
    bytes.set(di, 50, 0)
    bytes.copy_from_bytes(di, 0, prefix, 0, 19)
    bytes.copy_from_bytes(di, 19, hash32, 0, 32)
    bytes.free(prefix)
    return di
}

// Parse an RSA SPKI key blob (the SubjectPublicKey content, which for RSA is
// SEQUENCE { INTEGER n, INTEGER e }) into (n, e) bignums. Returns (n,e,"") or
// (null,null,err). Caller frees the bignums with bignum.free.
fn parse_rsa_spki(spki_key: byte[]) -> (ptr, ptr, string) {
    if spki_key.len < 0 { panic("tls13_cert.parse_rsa_spki: the `spki_key` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int key_len = spki_key.len
    view = bytes.new(key_len)
    if key_len > 0 { bytes.set(view, key_len - 1, 0) }
    bytes.copy_from_slice(view, 0, spki_key[0..key_len])
    r = asn1.reader_new(view)
    sub, body, serr = asn1.read_sequence(r)
    if string.equals(serr, "") != 1 {
        asn1.reader_free(r); bytes.free(view)
        return null, null, serr
    }
    n, nerr = asn1.read_integer(sub)
    if string.equals(nerr, "") != 1 {
        asn1.reader_free(sub); asn1.reader_free(r); bytes.free(view); bytes.free(body)
        return null, null, nerr
    }
    e, eerr = asn1.read_integer(sub)
    if string.equals(eerr, "") != 1 {
        bignum.free(n)
        asn1.reader_free(sub); asn1.reader_free(r); bytes.free(view); bytes.free(body)
        return null, null, eerr
    }
    asn1.reader_free(sub); asn1.reader_free(r); bytes.free(view); bytes.free(body)
    return n, e, ""
}

// Verify `leaf`'s tbsCertificate signature under `issuer`'s public key.
// Dispatches on leaf.sig_alg_oid. Returns 1 if the signature is valid, else 0.
verify_cert_signature(leaf: *LeafCert, issuer: *LeafCert) -> int {
    if leaf.tbs == null { return 0 }
    if leaf.signature == null { return 0 }
    return verify_sig_over_bytes(bytes.view(leaf.tbs)[0..leaf.tbs_len], leaf.sig_alg_oid, bytes.view(leaf.signature)[0..leaf.signature_len], issuer.spki_algo_oid, bytes.view(issuer.spki_key)[0..issuer.spki_key_len])
}

// Verify `sig` over the raw bytes `msg[0..msg_len)` under the signature
// algorithm named by `sig_alg_oid` (dotted-OID bytes), using the signer's SPKI
// (`key_algo_oid` + `key`/`key_len`). Returns 1 if valid, else 0. The three
// algorithms cover the real world for both X.509 cert signatures and OCSP
// responder signatures (RFC 6960 §4.2.2.2 uses the same AlgorithmIdentifier /
// key shapes as certificates):
//   sha256WithRSAEncryption  1.2.840.113549.1.1.11  -> RSA PKCS#1 v1.5 / SHA-256
//   ecdsa-with-SHA256        1.2.840.10045.4.3.2    -> ECDSA P-256 / SHA-256
//   ecdsa-with-SHA384        1.2.840.10045.4.3.3    -> ECDSA P-384 / SHA-384
fn verify_sig_over_bytes(msg: byte[], sig_alg_oid: ptr, sig: byte[], key_algo_oid: ptr, key: byte[]) -> int {
    if msg.len < 0 { panic("tls13_cert.verify_sig_over_bytes: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if sig.len < 0 { panic("tls13_cert.verify_sig_over_bytes: the `sig` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if key.len < 0 { panic("tls13_cert.verify_sig_over_bytes: the `key` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int key_len = key.len
    if msg == null { return 0 }
    if sig == null { return 0 }
    if key == null { return 0 }

    result = 0
    if oid_is(sig_alg_oid, "1.2.840.113549.1.1.11") == 1 {
        // sha256WithRSAEncryption. Signer key must be rsaEncryption.
        if oid_is(key_algo_oid, "1.2.840.113549.1.1.1") == 1 {
            hash = sha256_of_bytes(msg)
            n, e, perr = parse_rsa_spki(key)
            if string.equals(perr, "") == 1 {
                k = rsa.key_from_components(n, e, null)
                di = sha256_digestinfo(hash)
                result = rsa.verify_pkcs1(k, di, sig)
                bytes.free(di)
                rsa.key_free(k) // frees n, e too
            }
            bytes.free(hash)
        }
    }
    if oid_is(sig_alg_oid, "1.2.840.10045.4.3.2") == 1 {
        // ecdsa-with-SHA256 on a P-256 signer key (65-byte uncompressed point).
        if oid_is(key_algo_oid, "1.2.840.10045.2.1") == 1 {
            if key_len == 65 {
                hash = sha256_of_bytes(msg)
                px, py, kerr = ec_point_from_spki(key, 32)
                if string.equals(kerr, "") == 1 {
                    r32, s32, serr = split_ecdsa_sig(sig, 32)
                    if string.equals(serr, "") == 1 {
                        result = p256.ecdsa_verify(px, py, hash, r32, s32)
                        bytes.free(r32); bytes.free(s32)
                    }
                    bytes.free(px); bytes.free(py)
                }
                bytes.free(hash)
            }
        }
    }
    if oid_is(sig_alg_oid, "1.2.840.10045.4.3.3") == 1 {
        // ecdsa-with-SHA384 on a P-384 signer key (97-byte uncompressed point).
        // Common on modern roots/intermediates (e.g. Google Trust Services).
        if oid_is(key_algo_oid, "1.2.840.10045.2.1") == 1 {
            if key_len == 97 {
                hash = sha384_of_bytes(msg)
                px, py, kerr = ec_point_from_spki(key, 48)
                if string.equals(kerr, "") == 1 {
                    r48, s48, serr = split_ecdsa_sig(sig, 48)
                    if string.equals(serr, "") == 1 {
                        result = p384.ecdsa_verify(px, py, hash, r48, s48)
                        bytes.free(r48); bytes.free(s48)
                    }
                    bytes.free(px); bytes.free(py)
                }
                bytes.free(hash)
            }
        }
    }
    return result
}

// SHA-384 of a std.bytes buffer (streaming path).
fn sha384_of_bytes(data: byte[]) -> ptr {
    ctx, err = sha2.new("sha384")
    if err != "" { return null }
    sha2.update(ctx, data)
    return sha2.final_bytes(ctx)
}

// Split an uncompressed EC point (04 || X || Y, each `coord` bytes) from an SPKI
// key blob into (X, Y, ""). Returns (null,null,err) if it isn't a
// (1 + 2*coord)-byte uncompressed point. Caller frees X/Y. coord = 32 for
// P-256, 48 for P-384.
fn ec_point_from_spki(key: byte[], coord: int) -> (ptr, ptr, string) {
    if key.len < 0 { panic("tls13_cert.ec_point_from_spki: the `key` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int key_len = key.len
    if key_len != 1 + 2 * coord { return null, null, "unsupported EC point encoding" }
    if (key[0] & 0xFF) != 0x04 { return null, null, "EC point not uncompressed" }
    x = bytes.new(coord); bytes.set(x, coord - 1, 0)
    y = bytes.new(coord); bytes.set(y, coord - 1, 0)
    bytes.copy_from_slice(x, 0, key[1..1 + coord])
    bytes.copy_from_slice(y, 0, key[1 + coord..1 + coord + coord])
    return x, y, ""
}

// Verify `leaf` chains to one of the trusted `anchors` (a std.list of
// *LeafCert). Requires an anchor whose subject DN exactly equals leaf.issuer
// AND under whose key leaf's signature verifies. Returns "" on success, else
// an error. A self-signed leaf (no matching anchor) is REJECTED here.
chain_verify(leaf: *LeafCert, anchors: ptr) -> string {
    if anchors == null { return "no trust anchors" }
    n = list_size(anchors)
    if n == 0 { return "no trust anchors" }
    i = 0
    while i < n {
        a = list.at(anchors, i) as *LeafCert
        if a != null {
            if dn_equal(bytes.view(leaf.issuer)[0..leaf.issuer_len], bytes.view(a.subject)[0..a.subject_len]) == 1 {
                if verify_cert_signature(leaf, a) == 1 {
                    return ""
                }
            }
        }
        i = i + 1
    }
    return "certificate does not chain to a trusted anchor"
}

// Verify a certificate PATH from `leaf` through the server-sent
// `intermediates` (a std.list of *LeafCert, possibly empty or null) to one of
// the trusted `anchors`, now, for a TLS server: validate_chain with
// PURPOSE_SERVER at the current time. "" on a valid path, else why not.
//
// This used to accept any path whose DNs matched and whose signatures
// verified, never asking whether an issuer was a CA: a certificate a CA
// issued to any web site could sign one for any other host (#3303).
chain_verify_path(leaf: *LeafCert, intermediates: ptr, anchors: ptr) -> string {
    return validate_chain(leaf, intermediates, anchors, "", PURPOSE_SERVER, 0)
}

const MAX_CHAIN_DEPTH = 8

// ---- path validation (RFC 5280 section 6, as the Web PKI profiles it) ----
//
// validate_chain(leaf, intermediates, anchors, at, purpose, max_depth) -> ""
// or why no path is acceptable. It searches every path from the leaf
// through the intermediates (each used at most once) to a trust anchor,
// backtracking when a candidate fails, and accepts the first where:
//   - every signature verifies and every issuer DN matches its child's;
//   - every certificate is within its validity period at `at` (a
//     "YYYYMMDDHHMMSS" key, "" for now);
//   - every issuer is a v3 CA (basicConstraints cA), may sign certificates
//     (keyUsage keyCertSign, when keyUsage is present), and its
//     pathLenConstraint covers the CAs below it;
//   - no certificate has an unknown critical, repeated or malformed
//     extension;
//   - the leaf, and every issuer that restricts it, allows `purpose`
//     (PURPOSE_SERVER: id-kp-serverAuth, PURPOSE_CLIENT: id-kp-clientAuth)
//     in extendedKeyUsage;
//   - every name constraint (DNS and IP subtrees) of an issuer permits, and
//     does not exclude, the SAN names of the certificates below it.
// max_depth bounds the number of intermediates (0: MAX_CHAIN_DEPTH).
// The hostname is checked separately (check_hostname). #1298 (x509-limbo).

const PURPOSE_SERVER = 1
const PURPOSE_CLIENT = 2

const CHAIN_NO_PATH = 1
const CHAIN_TOO_LONG = 2
const CHAIN_NOT_CA = 3
const CHAIN_NO_CERT_SIGN = 4
const CHAIN_PATH_LEN = 5
const CHAIN_VALIDITY = 6
const CHAIN_CRITICAL = 7
const CHAIN_BAD_EXT = 8
const CHAIN_PURPOSE = 9
const CHAIN_NAME_CONSTRAINT = 10
const CHAIN_NOT_V3 = 11
const CHAIN_BUDGET = 12

// Signature checks one path search may spend: a set of cross-signed
// intermediates can otherwise make the search exponential (x509-limbo's
// pathological cases). The same bound as rustls-webpki.
const CHAIN_SIG_BUDGET = 100

struct ChainCtx {
    intermediates: ptr // std.list of *LeafCert, or null
    anchors: ptr // std.list of *LeafCert
    path: ptr // std.list of *LeafCert: leaf, intermediates, anchor
    purpose: int
    max_depth: int
    err: int // the most specific CHAIN_* failure seen
    budget: int // signature verifications left (path building is bounded)
}

fn chain_error(code: int) -> string {
    if code == CHAIN_TOO_LONG { return "certificate chain too long" }
    if code == CHAIN_NOT_CA { return "an issuing certificate is not a CA (basicConstraints)" }
    if code == CHAIN_NO_CERT_SIGN { return "an issuing certificate may not sign certificates (keyUsage)" }
    if code == CHAIN_PATH_LEN { return "a CA's path length constraint is exceeded" }
    if code == CHAIN_VALIDITY { return "a certificate in the chain has expired or is not yet valid" }
    if code == CHAIN_CRITICAL { return "a certificate in the chain has an unknown critical extension" }
    if code == CHAIN_BAD_EXT { return "a certificate in the chain has a malformed or repeated extension" }
    if code == CHAIN_PURPOSE { return "a certificate in the chain is not valid for this purpose (extendedKeyUsage)" }
    if code == CHAIN_NAME_CONSTRAINT { return "a name in the chain violates a CA's name constraints" }
    if code == CHAIN_NOT_V3 { return "an issuing certificate is not version 3" }
    if code == CHAIN_BUDGET { return "too many candidate paths: path building gave up" }
    return "certificate does not chain to a trusted anchor"
}

fn chain_note(cx: *ChainCtx, code: int) {
    if cx.err == CHAIN_NO_PATH || cx.err == CHAIN_TOO_LONG { cx.err = code }
}

// 1 if `at` is within c's validity period (both times well formed).
fn cert_time_ok(c: *LeafCert, at: string) -> int {
    if c.not_before == null || c.not_after == null { return 0 }
    nb = time_to_key(c.not_before, c.not_before_len)
    na = time_to_key(c.not_after, c.not_after_len)
    if string.equals(nb, "") == 1 || string.equals(na, "") == 1 { return 0 }
    if string_compare(at, nb) < 0 { return 0 }
    if string_compare(at, na) > 0 { return 0 }
    return 1
}

fn ext_code(c: *LeafCert) -> int {
    if (c.ext_bits & EXT_UNKNOWN_CRITICAL) != 0 { return CHAIN_CRITICAL }
    if (c.ext_bits & (EXT_DUPLICATE | EXT_MALFORMED | EXT_SAN_EMPTY)) != 0 { return CHAIN_BAD_EXT }
    return 0
}

fn purpose_ok(c: *LeafCert, purpose: int) -> int {
    if (c.ext_bits & EXT_EKU) == 0 { return 1 }
    if purpose == PURPOSE_SERVER && (c.eku_bits & EKU_SERVER) != 0 { return 1 }
    if purpose == PURPOSE_CLIENT && (c.eku_bits & EKU_CLIENT) != 0 { return 1 }
    return 0
}

// Why `ca` cannot issue (0 if it can), its own properties only.
fn issuer_code(ca: *LeafCert, at: string, purpose: int, is_anchor: int) -> int {
    e = ext_code(ca)
    if e != 0 { return e }
    if is_anchor == 0 && ca.version != 2 { return CHAIN_NOT_V3 }
    if is_anchor == 0 && ca.is_ca == 0 { return CHAIN_NOT_CA }
    if is_anchor == 1 && (ca.ext_bits & EXT_BC) != 0 && ca.is_ca == 0 { return CHAIN_NOT_CA }
    if ca.has_key_usage == 1 && ca.key_cert_sign == 0 { return CHAIN_NO_CERT_SIGN }
    if purpose_ok(ca, purpose) == 0 { return CHAIN_PURPOSE }
    if cert_time_ok(ca, at) == 0 { return CHAIN_VALIDITY }
    return 0
}

fn is_self_issued(c: *LeafCert) -> int {
    return dn_equal(bytes.view(c.issuer)[0..c.issuer_len], bytes.view(c.subject)[0..c.subject_len])
}

fn issued_by(cx: *ChainCtx, child: *LeafCert, parent: *LeafCert) -> int {
    if dn_equal(bytes.view(child.issuer)[0..child.issuer_len], bytes.view(parent.subject)[0..parent.subject_len]) != 1 { return 0 }
    if cx.budget <= 0 {
        cx.err = CHAIN_BUDGET
        return 0
    }
    cx.budget = cx.budget - 1
    return verify_cert_signature(child, parent)
}

// ASCII-lower-cased byte.
fn lc(c: int) -> int {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

// RFC 5280 4.2.1.10 for dNSName: "example.com" matches it and every name
// under it, ".example.com" only the names under it, "" everything.
fn dns_constraint_match(name: ptr, cons: ptr, coff: int) -> int {
    nl = bytes.length(name)
    cl = bytes.length(cons) - coff
    if cl <= 0 { return 1 }
    if nl < cl { return 0 }
    dot = 0
    if (bytes.get(cons, coff) & 0xFF) == 46 { dot = 1 }
    if dot == 1 && nl == cl { return 0 }
    if dot == 0 && nl > cl {
        if (bytes.get(name, nl - cl - 1) & 0xFF) != 46 { return 0 }
    }
    k = 0
    while k < cl {
        if lc(bytes.get(name, nl - cl + k) & 0xFF) != lc(bytes.get(cons, coff + k) & 0xFF) { return 0 }
        k = k + 1
    }
    return 1
}

// iPAddress constraint: address || mask (8 or 32 bytes).
fn ip_constraint_match(ip: ptr, cons: ptr, coff: int) -> int {
    il = bytes.length(ip)
    cl = bytes.length(cons) - coff
    if cl != 2 * il { return 0 }
    k = 0
    while k < il {
        m = bytes.get(cons, coff + il + k) & 0xFF
        if ((bytes.get(ip, k) & 0xFF) & m) != ((bytes.get(cons, coff + k) & 0xFF) & m) { return 0 }
        k = k + 1
    }
    return 1
}

// The subtrees of name type `tag` (0x82 DNS, 0x87 IP) in `trees` against
// `name`: 0 when there are none of that type, 1 when there are and none
// matches, 2 when one matches.
fn subtrees_match(trees: ptr, tag: int, name: ptr) -> int {
    if trees == null { return 0 }
    res = 0
    n = list_size(trees)
    i = 0
    while i < n {
        t = list.at(trees, i) as ptr
        if t != null && bytes.length(t) >= 1 && (bytes.get(t, 0) & 0xFF) == tag {
            if res == 0 { res = 1 }
            if tag == 0x82 && dns_constraint_match(name, t, 1) == 1 { return 2 }
            if tag == 0x87 && ip_constraint_match(name, t, 1) == 1 { return 2 }
        }
        i = i + 1
    }
    return res
}

// 1 if the names of `c` (SAN dNSNames and iPAddresses) satisfy `ca`'s
// name constraints.
fn names_allowed(ca: *LeafCert, c: *LeafCert) -> int {
    if (ca.ext_bits & EXT_NC) == 0 { return 1 }
    if names_allowed_list(ca, c.dns_names, 0x82) == 0 { return 0 }
    if names_allowed_list(ca, c.ip_addrs, 0x87) == 0 { return 0 }
    return 1
}

fn names_allowed_list(ca: *LeafCert, names: ptr, tag: int) -> int {
    if names == null { return 1 }
    n = list_size(names)
    i = 0
    while i < n {
        nm = list.at(names, i) as ptr
        if nm != null {
            if subtrees_match(ca.nc_excluded, tag, nm) == 2 { return 0 }
            if subtrees_match(ca.nc_permitted, tag, nm) == 1 { return 0 }
        }
        i = i + 1
    }
    return 1
}

// The checks over the whole candidate path (leaf at 0, anchor last): path
// length constraints and name constraints. 0 if they hold.
fn path_code(cx: *ChainCtx) -> int {
    n = list_size(cx.path)
    j = 1
    while j < n {
        ca = list.at(cx.path, j) as *LeafCert
        if (ca.ext_bits & EXT_PATHLEN) != 0 {
            below = 0
            k = 1
            while k < j {
                if is_self_issued(list.at(cx.path, k) as *LeafCert) == 0 { below = below + 1 }
                k = k + 1
            }
            if below > ca.path_len { return CHAIN_PATH_LEN }
        }
        if (ca.ext_bits & EXT_NC) != 0 {
            k = 0
            while k < j {
                c = list.at(cx.path, k) as *LeafCert
                if k == 0 || is_self_issued(c) == 0 {
                    if names_allowed(ca, c) == 0 { return CHAIN_NAME_CONSTRAINT }
                }
                k = k + 1
            }
        }
        j = j + 1
    }
    return 0
}

fn path_pop(cx: *ChainCtx) {
    list_remove(cx.path, list_size(cx.path) - 1)
}

fn in_path(cx: *ChainCtx, c: ptr) -> int {
    n = list_size(cx.path)
    i = 0
    while i < n {
        if list.at(cx.path, i) == c { return 1 }
        i = i + 1
    }
    return 0
}

// Extend the path above `cert`; 1 when an acceptable path is found.
fn chain_dfs(cx: *ChainCtx, cert: *LeafCert, at: string, depth: int) -> int {
    na = list_size(cx.anchors)
    i = 0
    while i < na {
        a = list.at(cx.anchors, i) as *LeafCert
        if a != null && issued_by(cx, cert, a) == 1 {
            code = issuer_code(a, at, cx.purpose, 1)
            if code == 0 {
                list.add(cx.path, a)
                code = path_code(cx)
                path_pop(cx)
                if code == 0 { return 1 }
            }
            chain_note(cx, code)
        }
        i = i + 1
    }
    if cx.intermediates == null { return 0 }
    if depth >= cx.max_depth {
        chain_note(cx, CHAIN_TOO_LONG)
        return 0
    }
    ni = list_size(cx.intermediates)
    j = 0
    while j < ni {
        m = list.at(cx.intermediates, j) as *LeafCert
        if m != null && in_path(cx, m as ptr) == 0 && issued_by(cx, cert, m) == 1 {
            code = issuer_code(m, at, cx.purpose, 0)
            if code == 0 {
                list.add(cx.path, m)
                found = chain_dfs(cx, m, at, depth + 1)
                path_pop(cx)
                if found == 1 { return 1 }
            } else {
                chain_note(cx, code)
            }
        }
        j = j + 1
    }
    return 0
}

// "" when there is a valid path from `leaf` through `intermediates` (a
// std.list of *LeafCert, or null) to one of `anchors` at `at` (a
// "YYYYMMDDHHMMSS" key, "" for now) for `purpose` (PURPOSE_SERVER or
// PURPOSE_CLIENT), with at most `max_depth` intermediates (0 for
// MAX_CHAIN_DEPTH); else why not. The rules are in the comment above
// PURPOSE_SERVER.
validate_chain(leaf: *LeafCert, intermediates: ptr, anchors: ptr, at: string, purpose: int, max_depth: int) -> string {
    if anchors == null || list_size(anchors) == 0 { return "no trust anchors" }
    at_key = at
    if string.equals(at_key, "") == 1 { at_key = now_key() }
    e = ext_code(leaf)
    if e != 0 { return chain_error(e) }
    if purpose_ok(leaf, purpose) == 0 { return chain_error(CHAIN_PURPOSE) }
    if cert_time_ok(leaf, at_key) == 0 { return chain_error(CHAIN_VALIDITY) }
    md = max_depth
    if md <= 0 { md = MAX_CHAIN_DEPTH }
    cx = ChainCtx { intermediates: intermediates, anchors: anchors, path: list_new(), purpose: purpose, max_depth: md, err: CHAIN_NO_PATH, budget: CHAIN_SIG_BUDGET }
    list.add(cx.path, leaf)
    found = chain_dfs(&cx, leaf, at_key, 0)
    list_free(cx.path)
    if found == 1 { return "" }
    return chain_error(cx.err)
}

// Validity at a given "YYYYMMDDHHMMSS" key: "" or why not.
check_validity_at(c: *LeafCert, at: string) -> string {
    if cert_time_ok(c, at) == 1 { return "" }
    return "certificate expired, not yet valid, or with an invalid validity period"
}

// Find the certificate that issued `leaf` — search `intermediates` then
// `anchors` for one whose subject DN equals leaf.issuer AND whose key verifies
// leaf's signature. Returns the issuer *LeafCert as ptr, or null if none.
// Used by OCSP: the responder is authorized relative to the cert's issuer.
find_issuer_cert(leaf: *LeafCert, intermediates: ptr, anchors: ptr) -> ptr {
    if intermediates != null {
        n = list_size(intermediates)
        i = 0
        while i < n {
            m = list.at(intermediates, i) as *LeafCert
            if m != null {
                if dn_equal(bytes.view(leaf.issuer)[0..leaf.issuer_len], bytes.view(m.subject)[0..m.subject_len]) == 1 {
                    if verify_cert_signature(leaf, m) == 1 { return m as ptr }
                }
            }
            i = i + 1
        }
    }
    if anchors != null {
        an = list_size(anchors)
        j = 0
        while j < an {
            a = list.at(anchors, j) as *LeafCert
            if a != null {
                if dn_equal(bytes.view(leaf.issuer)[0..leaf.issuer_len], bytes.view(a.subject)[0..a.subject_len]) == 1 {
                    if verify_cert_signature(leaf, a) == 1 { return a as ptr }
                }
            }
            j = j + 1
        }
    }
    return null
}

// ---- system trust store (PEM bundle) ----

import std.fs
import std.cryptography.pem

// Load a trust store into a std.list of *LeafCert trust anchors. `path` is
// either a PEM bundle file (e.g. /etc/ssl/certs/ca-certificates.crt) or a
// DIRECTORY of PEM files, one or more certificates each -- the layout OpenSSL's
// SSL_CERT_DIR names and the only one Android has (/system/etc/security/cacerts,
// /apex/com.android.conscrypt/cacerts; there is no bundle file there at all).
// Each PEM CERTIFICATE block is base64-decoded and structurally parsed; blocks
// that fail to parse are skipped, as is any text around them (Android's files
// carry an `openssl x509 -text` dump after the PEM).
//
// Returns (list, "") when at least one certificate loaded, or (null, err) when
// the path cannot be read or yields no certificate at all -- an empty store
// would only fail later, at chain building, with a message about the server's
// certificate rather than about the missing store.
// Caller frees with free_anchors (frees each LeafCert + the list).
trust_store_load(path: string) -> (ptr, string) {
    anchors = list_new()
    n, err = trust_store_add(anchors, path)
    if n <= 0 {
        free_anchors(anchors)
        if string.equals(err, "") == 1 { err = "no certificates found in ${path}" }
        return null, err
    }
    return anchors, ""
}

// Append the certificates at `path` (a PEM bundle file or a directory of PEM
// files, as trust_store_load) to `anchors`, a list from trust_store_load or
// list_new. Returns (count added, "") or (0, err) when `path` cannot be read.
// A directory loads every regular file (or symlink) directly inside it; files
// holding no certificate are skipped silently, since a CA directory routinely
// carries other things (OpenSSL's hash symlinks beside the .pem they point at,
// a README). Subdirectories are not descended into. This is what lets a caller
// assemble one store from several sources (SSL_CERT_FILE plus SSL_CERT_DIR).
trust_store_add(anchors: ptr, path: string) -> (int, string) {
    if anchors == null { return 0, "trust_store_add: anchors list is null" }
    if path == null { return 0, "cannot open trust store (no path)" }
    if string.length(path) == 0 { return 0, "cannot open trust store (empty path)" }
    if fs.dir_exists(path) == 1 {
        return add_pem_dir(anchors, path)
    }
    // fs.read's error already names the path and the OS reason.
    text, err = fs.read(path)
    if string.equals(err, "") != 1 { return 0, "cannot open trust store ${err}" }
    return add_pem_text(anchors, text), ""
}

// Append the certificates in PEM `text` (any number of CERTIFICATE blocks,
// anything around them ignored) to `anchors`, as trust_store_add does for a
// file. Returns how many were added. What tls13_client loads the Windows
// system store through (#2675), which arrives as text rather than as a file.
trust_store_add_pem(anchors: ptr, text: string) -> int {
    if anchors == null { return 0 }
    return add_pem_text(anchors, text)
}

// Every file directly inside `dir`, through add_pem_text.
fn add_pem_dir(anchors: ptr, dir: string) -> (int, string) {
    entries, lerr = fs.list_dir(dir)
    if string.equals(lerr, "") != 1 { return 0, "cannot list trust store directory ${dir}" }
    total = 0
    count = fs.dir_list_count(entries)
    i = 0
    while i < count {
        name = fs.dir_list_get(entries, i)
        kind = fs.dir_list_kind(entries, i)
        // Directories (and ".", "..") are skipped; a symlink is followed by
        // the open below, which is what makes OpenSSL's hash links load. Kind
        // 0 is "the filesystem did not say", so it is tried too.
        if kind != fs.STAT_KIND_DIR && string.starts_with(name, ".") != 1 {
            full = fs.path_join(dir, name)
            // A file that cannot be read (a dangling link, no permission) is
            // skipped, as OpenSSL's directory lookup skips it.
            text, rerr = fs.read(full)
            if string.equals(rerr, "") == 1 { total = total + add_pem_text(anchors, text) }
        }
        i = i + 1
    }
    fs.dir_list_free(entries)
    return total, ""
}

// Parse every PEM CERTIFICATE block in `text` onto `anchors`; returns how many.
fn add_pem_text(anchors: ptr, text: string) -> int {
    if text == null { return 0 }
    added = 0
    end_marker = "-----END CERTIFICATE-----"
    tlen = string.length(text)
    mlen = string.length(end_marker)
    pos = 0
    while pos < tlen {
        e = string.index_of_from(text, end_marker, pos)
        if e < 0 { break }
        block_end = e + mlen
        block = string.substring_n(text, tlen, pos, block_end)
        der, _label, perr = pem.parse(block)
        if string.equals(perr, "") == 1 {
            if der != null {
                leaf = malloc(LEAFCERT_SIZE) as *LeafCert
                init_leaf(leaf)
                dlen = bytes.length(der)
                cerr = parse_certificate(bytes.view(der)[0..dlen], leaf)
                if string.equals(cerr, "") == 1 {
                    list.add(anchors, leaf)
                    added = added + 1
                } else {
                    free_leaf(leaf)
                    free(leaf)
                }
            }
            bytes.free(der)
        }
        pos = block_end
    }
    return added
}

// Zero every field of a heap-allocated LeafCert.
//
// Exported, and the ONLY initialiser: tls13_client had a byte-identical
// private copy for the intermediates it parses, so a new field had to be
// remembered in two files. Missing one leaves that field holding whatever
// malloc returned, and free_leaf then frees a garbage pointer -- which
// surfaces as a double-free far from the omission. One initialiser, next to
// the struct and to free_leaf, so the three stay in step.
init_leaf(l: *LeafCert) {
    l.tbs = null; l.tbs_len = 0
    l.sig_alg_oid = null
    l.signature = null; l.signature_len = 0
    l.spki_algo_oid = null; l.spki_key = null; l.spki_key_len = 0
    l.issuer = null; l.issuer_len = 0
    l.subject = null; l.subject_len = 0
    l.not_before = null; l.not_before_len = 0
    l.not_after = null; l.not_after_len = 0
    l.dns_names = null
    l.ip_addrs = null
    l.is_ca = 0
    l.has_key_usage = 0
    l.key_cert_sign = 0
    l.version = 0; l.ext_bits = 0; l.path_len = 0; l.key_usage = 0; l.eku_bits = 0
    l.nc_permitted = null; l.nc_excluded = null
}

// Free a trust-anchor list built by trust_store_load: each *LeafCert's buffers,
// each LeafCert struct, then the list.
free_anchors(anchors: ptr) {
    if anchors == null { return }
    n = list_size(anchors)
    i = 0
    while i < n {
        a = list.at(anchors, i) as *LeafCert
        if a != null {
            free_leaf(a)
            free(a)
        }
        i = i + 1
    }
    list_free(anchors)
}
