//
// std.cryptography.ed25519: Ed25519 (RFC 8032) signatures in pure Aether,
// constant time, on std.cryptography.ecc and std.cryptography.sha2
// (SHA-512). NO externs to OpenSSL.
//
// Ed25519 is EdDSA over the twisted Edwards curve
//   -x^2 + y^2 = 1 + d x^2 y^2   over GF(2^255 - 19),  d = -121665/121666,
// group order L = 2^252 + 27742317777372353535851937790883648493.
//
//   publickey(seed32)            -> public32
//   sign(seed32, msg)            -> sig64
//   verify(public32, msg, sig64) -> int   (1 = valid, 0 = invalid)
//
// 32-byte keys, 64-byte signatures, all little-endian per RFC 8032.
//
// publickey and sign are constant time in the seed, the secret scalar and
// the per-message nonce r: the scalar multiplication by the base point is a
// fixed 4-bit window over complete Edwards formulas that reads every table
// entry, and S = r + k a mod L is computed on fixed-width limbs
// (std.cryptography.ecc). verify works on public values and is not constant
// time. It checks [S]B = R + [k]A without the cofactor, and refuses S >= L,
// a public key that is not a canonical point encoding, and a non-canonical
// R (no point encodes to it, so the comparison fails).
//
// Measured with the default `ae build` on an x86-64 Windows desktop, per
// operation: sign 665 us, verify 410 us (7850 and 8350 us on std.bignum).

import std.bytes
import std.cryptography.ecc
import std.cryptography.sha2

exports(
    publickey, sign, verify
)

// SHA-512 of a byte slice -> 64-byte std.bytes, or null.
fn sha512(b: byte[]) -> ptr {
    ctx, err = sha2.new("sha512")
    if err != "" {
        return null
    }
    sha2.update(ctx, b)
    return sha2.final_bytes(ctx)
}

fn wipe_free(b: @frees ptr) {
    if b == null {
        return
    }
    int n = bytes.length(b)
    int i = 0
    while i < n {
        bytes.set(b, i, 0)
        i = i + 1
    }
    bytes.free(b)
}

// The secret scalar a (clamped SHA-512(seed)[0..32]) into a_le, and the
// prefix SHA-512(seed)[32..64] into prefix. Both 32-byte buffers.
fn expand_seed(seed: ptr, a_le: ptr, prefix: ptr) {
    h = sha512(bytes.view(seed)[0..32])
    bytes.copy_from_bytes(a_le, 0, h, 0, 32)
    bytes.set(a_le, 0, bytes.get(a_le, 0) & 248)
    bytes.set(a_le, 31, (bytes.get(a_le, 31) & 63) | 64)
    bytes.copy_from_bytes(prefix, 0, h, 32, 32)
    wipe_free(h)
}

// Derive the 32-byte public key from a 32-byte seed.
publickey(seed: ptr) -> ptr {
    a_le = bytes.new(32)
    prefix = bytes.new(32)
    expand_seed(seed, a_le, prefix)
    pub = ecc.ed_scalar_mult_base(ecc.ED25519, a_le)
    wipe_free(a_le)
    wipe_free(prefix)
    return pub
}

// Sign msg with the 32-byte seed; returns a 64-byte signature.
sign(seed: ptr, msg: byte[]) -> ptr {
    if msg.len < 0 { panic("ed25519.sign: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int msg_len = msg.len
    a_le = bytes.new(32)
    prefix = bytes.new(32)
    expand_seed(seed, a_le, prefix)
    aenc = ecc.ed_scalar_mult_base(ecc.ED25519, a_le)

    // r = SHA-512(prefix || M) mod L; R = r B
    rin_len = 32 + msg_len
    rin = bytes.new(rin_len)
    bytes.copy_from_bytes(rin, 0, prefix, 0, 32)
    if msg_len > 0 { bytes.copy_from_slice(rin, 32, msg[0..msg_len]) }
    rh = sha512(bytes.view(rin)[0..rin_len])
    r = ecc.ed_reduce(ecc.ED25519, rh)
    renc = ecc.ed_scalar_mult_base(ecc.ED25519, r)

    // k = SHA-512(R || A || M) mod L
    kin_len = 64 + msg_len
    kin = bytes.new(kin_len)
    bytes.copy_from_bytes(kin, 0, renc, 0, 32)
    bytes.copy_from_bytes(kin, 32, aenc, 0, 32)
    if msg_len > 0 { bytes.copy_from_slice(kin, 64, msg[0..msg_len]) }
    kh = sha512(bytes.view(kin)[0..kin_len])
    k = ecc.ed_reduce(ecc.ED25519, kh)

    // S = (r + k a) mod L
    s = ecc.ed_sign_s(ecc.ED25519, r, k, a_le)

    sig = bytes.new(64)
    bytes.copy_from_bytes(sig, 0, renc, 0, 32)
    bytes.copy_from_bytes(sig, 32, s, 0, 32)

    wipe_free(a_le); wipe_free(prefix); wipe_free(rin); wipe_free(rh); wipe_free(r)
    bytes.free(aenc); bytes.free(renc); bytes.free(kin); bytes.free(kh); bytes.free(k); bytes.free(s)
    return sig
}

// Verify a 64-byte signature over msg with the 32-byte public key.
// Returns 1 if valid, 0 otherwise.
verify(public: ptr, msg: byte[], sig: byte[]) -> int {
    if msg.len < 0 { panic("ed25519.verify: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if sig.len < 0 { panic("ed25519.verify: the `sig` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if sig.len != 64 || public == null || bytes.length(public) != 32 { return 0 }
    int msg_len = msg.len
    renc = bytes.new(32)
    bytes.copy_from_slice(renc, 0, sig[0..32])
    senc = bytes.new(32)
    bytes.copy_from_slice(senc, 0, sig[32..64])

    // k = SHA-512(R || A || M) mod L
    kin_len = 64 + msg_len
    kin = bytes.new(kin_len)
    bytes.copy_from_bytes(kin, 0, renc, 0, 32)
    bytes.copy_from_bytes(kin, 32, public, 0, 32)
    if msg_len > 0 { bytes.copy_from_slice(kin, 64, msg[0..msg_len]) }
    kh = sha512(bytes.view(kin)[0..kin_len])
    k = ecc.ed_reduce(ecc.ED25519, kh)

    ok = ecc.ed_verify(ecc.ED25519, public, renc, senc, k)
    bytes.free(renc); bytes.free(senc); bytes.free(kin); bytes.free(kh); bytes.free(k)
    return ok
}
