// Ownership micro-benchmark (#2925): a function returning one of its string parameters (R3 hands a reference over).
// The budget compares a build with the base of the change, the two binaries
// run interleaved, the median of 11 runs each, on an otherwise idle machine.

import std.string
pick(a: string, b: string, n: int) -> string {
    if n % 2 == 0 { return a }
    return b
}
measure(s: string) -> int {
    return string.length(s)
}
main() {
    a = string.concat("left", "!")
    b = string.concat("right", "!")
    total = 0
    i = 0
    while i < 50000000 {
        p = pick(a, b, i)
        total = total + measure(p)
        i = i + 1
    }
    println(total)
}
