// Ownership micro-benchmark (#2925): string.concat results bound to locals.
// The budget compares a build with the base of the change, the two binaries
// run interleaved, the median of 11 runs each, on an otherwise idle machine.

import std.string
main() {
    total = 0
    i = 0
    while i < 3000000 {
        s = string.concat("ab", "cd")
        t = string.concat(s, "ef")
        total = total + string.length(t)
        i = i + 1
    }
    println(total)
}
