// Aether Cross-Language Benchmark Runner
// Builds and runs 11 languages across 5 Savina benchmark patterns and writes
// JSON results to visualize/. FAIRNESS.md is the rule book it implements.
//
// Usage: ae run run_benchmarks.ae
//        BENCH_RUNS=10 BENCH_WARMUP=2 BENCHMARK_MESSAGES=1000 ae run run_benchmarks.ae
//        BENCH_LANGS=c,rust BENCH_PATTERNS=ping_pong ae run run_benchmarks.ae
//        BENCH_STRICT=1 ae run run_benchmarks.ae   (exit 1 if any selected
//                                                   language skips or fails)
//
// Each language is built only through its own build file (`make <pattern>`
// in its directory, which calls cargo, zig build, sbt, javac or erlc as that
// language does); this file passes no compiler flags. Every run's checksum is
// compared with what a correct run prints, and a language whose run is wrong
// is reported as [FAIL] rather than measured.

import std.os
import std.io
import std.list
import std.string
import benchstats

extern exit(code: int)

// Every command here is POSIX sh: `cd c && make ping_pong`, `/usr/bin/time -v
// ./ping_pong`, `2>&1`. os.run_full runs it through `sh -c` on every
// platform: os_system and os_exec_raw hand a command to cmd.exe on Windows,
// which reads none of that, and they report no exit status.
// (output, exit status); the status is -1 when the shell could not be started.
sh_run(cmd: string) -> (string, int) {
    argv = list.new()
    _a = list.add(argv, "-c")
    _b = list.add(argv, cmd)
    out, err_out, status, err = os.run_full("sh", argv, null, "")
    list.free(argv)
    if err != "" {
        return "${out}${err_out}", -1
    }
    return "${out}${err_out}", status
}

sh_text(cmd: string) -> string {
    out, _status = sh_run(cmd)
    return string.trim(out)
}

// ---- the languages ---------------------------------------------------------

const LANG_COUNT = 11

lang_name(i: int) -> string {
    return match i {
        0 -> "Aether"
        1 -> "C"
        2 -> "C++"
        3 -> "Go"
        4 -> "Rust"
        5 -> "Java"
        6 -> "Zig"
        7 -> "Elixir"
        8 -> "Erlang"
        9 -> "Pony"
        _ -> "Scala"
    }
}

lang_dir(i: int) -> string {
    return match i {
        0 -> "aether"
        1 -> "c"
        2 -> "cpp"
        3 -> "go"
        4 -> "rust"
        5 -> "java"
        6 -> "zig"
        7 -> "elixir"
        8 -> "erlang"
        9 -> "pony"
        _ -> "scala"
    }
}

java_class(pattern: string) -> string {
    return match pattern {
        "ping_pong" -> "PingPong"
        "counting" -> "Counting"
        "thread_ring" -> "ThreadRing"
        "fork_join" -> "ForkJoin"
        _ -> "Skynet"
    }
}

scala_class(pattern: string) -> string {
    return match pattern {
        "ping_pong" -> "bench.ping_pong.PingPongBenchmark"
        "counting" -> "bench.counting.CountingBenchmark"
        "thread_ring" -> "bench.thread_ring.ThreadRingBenchmark"
        "fork_join" -> "bench.fork_join.ForkJoinBenchmark"
        _ -> "bench.skynet.SkynetBenchmark"
    }
}

// How to start the program `make <pattern>` built, from the language's
// directory. An invocation only: no tuning flags (FAIRNESS.md, rule 7).
lang_run(i: int, pattern: string) -> string {
    return match i {
        4 -> "./target/release/${pattern}"
        5 -> "java -cp classes ${java_class(pattern)}"
        6 -> "./zig-out/bin/${pattern}"
        7 -> "elixir ${pattern}.exs"
        8 -> "erl -noshell -s ${pattern} start"
        9 -> "./${pattern}/${pattern}"
        10 -> "java -cp \"$(cat classpath.txt)\" ${scala_class(pattern)}"
        _ -> "./${pattern}"
    }
}

lang_runtime(i: int) -> string {
    return match i {
        0 -> "Native (Aether runtime)"
        1 -> "Native (pthread)"
        2 -> "Native (std::thread)"
        3 -> "Go runtime"
        4 -> "Native (std::thread)"
        5 -> "JVM"
        6 -> "Native (std.Thread)"
        7 -> "BEAM VM"
        8 -> "BEAM VM"
        9 -> "Native (Pony runtime)"
        _ -> "JVM"
    }
}

// The toolchain's version, recorded with the results.
lang_version(i: int) -> string {
    cmd = match i {
        0 -> "../../build/ae version 2>&1 | head -1"
        1 -> "gcc --version 2>&1 | head -1"
        2 -> "g++ --version 2>&1 | head -1"
        3 -> "go version 2>&1 | head -1"
        4 -> "rustc --version 2>&1 | head -1"
        5 -> "java -version 2>&1 | head -1"
        6 -> "zig version 2>&1 | head -1"
        7 -> "elixir --version 2>&1 | tail -1"
        8 -> "erl -noshell -eval 'io:format(\"OTP ~s\", [erlang:system_info(otp_release)]), halt().' 2>&1 | head -1"
        9 -> "ponyc --version 2>&1 | head -1"
        _ -> "grep scalaVersion scala/build.sbt 2>&1 | head -1"
    }
    return json_escape(sh_text(cmd))
}

// ---- JSON ------------------------------------------------------------------

// `s` as the inside of a JSON string: quotes, backslashes and control
// characters escaped (a Windows path or a compiler banner carries them).
json_escape(s: string) -> string {
    out = ""
    n = string.length(s)
    i = 0
    while i < n {
        c = string.char_at(s, i)
        if c == 34 {
            out = "${out}\\\""
        } else if c == 92 {
            out = "${out}\\\\"
        } else if c == 10 || c == 13 || c == 9 {
            out = "${out} "
        } else if c >= 32 {
            out = "${out}${string.from_char(c)}"
        }
        i = i + 1
    }
    return out
}

// A measurement that may be missing: its value, or null.
json_num(v: float) -> string {
    if v < 0.0 {
        return "null"
    }
    return benchstats.fixed2(v)
}

// ---- one language, one pattern ---------------------------------------------

// The settings every language runs with.
struct Settings {
    runs: int
    warmup: int
    msgs: long
    time_cmd: string // "" where /usr/bin/time cannot see the program
    is_mac: int
}

// Build, warm up and time language `i` on `pattern`. Returns the JSON entry
// for the results, "" for a skipped language, or "FAIL: <reason>".
run_lang(i: int, pattern: string, cfg: Settings) -> string {
    name = lang_name(i)
    dir = lang_dir(i)
    print("  ${name}... ")

    blog = "build/${dir}_${pattern}.log"
    _bout, bstatus = sh_run("cd ${dir} && make ${pattern} > ../${blog} 2>&1")
    if bstatus != 0 {
        println("[SKIP] build failed (${blog})")
        return ""
    }

    env = "BENCHMARK_MESSAGES=${cfg.msgs}"
    if pattern == "skynet" {
        env = "BENCHMARK_MESSAGES=${cfg.msgs} SKYNET_LEAVES=${cfg.msgs}"
    }
    run = lang_run(i, pattern)
    cmd = "cd ${dir} && ${env} ${cfg.time_cmd} ${run} 2>&1"

    // The same warmup for every language: a JIT gets its warmup, and so
    // does a cache or a page fault a native runtime would otherwise pay in
    // its first timed run.
    w = 0
    while w < cfg.warmup {
        _wout, _wstatus = sh_run(cmd)
        w = w + 1
    }

    long want = benchstats.expected_checksum(pattern, cfg.msgs)
    long want_units = benchstats.expected_units(pattern, cfg.msgs)
    long work = benchstats.work_units(pattern, cfg.msgs)

    tput = make([]float, cfg.runs)
    nsm = make([]float, cfg.runs)
    cpu = make([]float, cfg.runs)
    per_cpu = make([]float, cfg.runs)
    mem = make([]float, cfg.runs)
    cpu_ok = 1
    mem_ok = 1
    failure = ""
    runs_json = ""

    r = 0
    while r < cfg.runs && failure == "" {
        out, status = sh_run(cmd)
        mps = benchstats.parse_throughput(out)
        long got = benchstats.long_after(out, "Checksum:")
        if status != 0 {
            failure = "run ${r + 1} exited with status ${status}"
        } else if got != want {
            failure = "run ${r + 1}: checksum ${got}, expected ${want}"
        } else if pattern == "skynet" && benchstats.long_after(out, "concurrency units:") != want_units {
            failure = "run ${r + 1}: concurrency units ${benchstats.long_after(out, "concurrency units:")}, expected ${want_units}"
        } else if mps < 0.0 {
            failure = "run ${r + 1}: no throughput in its output"
        }
        if failure == "" {
            tput[r] = mps * 1000000.0
            nsm[r] = benchstats.parse_ns(out)
            c = -1.0
            m = -1.0
            if string.length(cfg.time_cmd) > 0 {
                c = benchstats.parse_cpu_seconds(out, cfg.is_mac)
                m = benchstats.parse_peak_mb(out, cfg.is_mac)
            }
            if c <= 0.0 {
                cpu_ok = 0
            } else {
                cpu[r] = c
                per_cpu[r] = work / c
            }
            if m <= 0.0 {
                mem_ok = 0
            } else {
                mem[r] = m
            }
            if r > 0 {
                runs_json = "${runs_json},"
            }
            runs_json = "${runs_json}${benchstats.fixed2(tput[r])}"
        }
        r = r + 1
    }

    if failure != "" {
        println("[FAIL] ${failure}")
        free(tput)
        free(nsm)
        free(cpu)
        free(per_cpu)
        free(mem)
        return "FAIL: ${failure}"
    }

    med = benchstats.median(tput)
    lo = benchstats.minimum(tput)
    hi = benchstats.maximum(tput)
    cv = benchstats.cv_pct(tput)
    med_ns = benchstats.median(nsm)
    med_cpu = -1.0
    med_per_cpu = -1.0
    if cpu_ok == 1 {
        med_cpu = benchstats.median(cpu)
        med_per_cpu = benchstats.median(per_cpu)
    }
    med_mem = -1.0
    if mem_ok == 1 {
        med_mem = benchstats.median(mem)
    }
    free(tput)
    free(nsm)
    free(cpu)
    free(per_cpu)
    free(mem)

    cpu_text = "CPU n/a"
    if med_per_cpu > 0.0 {
        cpu_text = "${benchstats.fixed2(med_per_cpu / 1000000.0)}M per CPU-s"
    }
    mem_text = "memory n/a"
    if med_mem > 0.0 {
        mem_text = "${benchstats.fixed2(med_mem)} MB"
    }
    println("[OK] ${benchstats.fixed2(med / 1000000.0)}M msg/sec (${benchstats.fixed2(lo / 1000000.0)}-${benchstats.fixed2(hi / 1000000.0)}, cv ${benchstats.fixed2(cv)}%), ${cpu_text}, ${mem_text}")

    flags = json_escape(sh_text("cd ${dir} && make -s flags 2>/dev/null"))
    j = "    \"${name}\": {\n"
    j = "${j}      \"runtime\": \"${lang_runtime(i)}\",\n"
    j = "${j}      \"toolchain\": \"${lang_version(i)}\",\n"
    j = "${j}      \"build_flags\": \"${flags}\",\n"
    j = "${j}      \"msg_per_sec\": ${benchstats.fixed2(med)},\n"
    j = "${j}      \"ns_per_msg\": ${benchstats.fixed2(med_ns)},\n"
    j = "${j}      \"runs\": [${runs_json}],\n"
    j = "${j}      \"min_mps\": ${benchstats.fixed2(lo)},\n"
    j = "${j}      \"max_mps\": ${benchstats.fixed2(hi)},\n"
    j = "${j}      \"cv_pct\": ${benchstats.fixed2(cv)},\n"
    j = "${j}      \"cpu_seconds\": ${json_num(med_cpu)},\n"
    j = "${j}      \"msg_per_cpu_sec\": ${json_num(med_per_cpu)},\n"
    j = "${j}      \"memory_mb\": ${json_num(med_mem)},\n"
    j = "${j}      \"checksum\": ${want}\n"
    j = "${j}    }"
    return j
}

// Is `name` selected by a comma-separated list (empty: every one)?
selected(list_text: string, name: string) -> bool {
    if string.length(list_text) == 0 {
        return true
    }
    return string.contains(",${list_text},", ",${name},") == 1
}

pattern_at(pi: int) -> string {
    return match pi {
        0 -> "ping_pong"
        1 -> "counting"
        2 -> "thread_ring"
        3 -> "fork_join"
        _ -> "skynet"
    }
}

pattern_description(pattern: string) -> string {
    return match pattern {
        "ping_pong" -> "Two actors exchange messages back and forth"
        "counting" -> "Single actor counts incoming messages"
        "thread_ring" -> "Token passed through a ring of 100 actors"
        "fork_join" -> "Messages distributed round-robin across 8 workers"
        _ -> "Recursive actor tree summing the leaves, 1,111 units for a million"
    }
}

main() {
    runs = 5
    warmup = 1
    long msgs = 1000000

    env_r = getenv("BENCH_RUNS")
    if env_r != 0 { runs = atoi(env_r) }
    env_w = getenv("BENCH_WARMUP")
    if env_w != 0 { warmup = atoi(env_w) }
    env_m = getenv("BENCHMARK_MESSAGES")
    if env_m != 0 { msgs = atoi(env_m) }
    if runs < 1 {
        println("ERROR: BENCH_RUNS must be at least 1")
        exit(1)
    }
    only_langs = ""
    env_l = getenv("BENCH_LANGS")
    if env_l != 0 { only_langs = string.to_lower(env_l) }
    only_patterns = ""
    env_p = getenv("BENCH_PATTERNS")
    if env_p != 0 { only_patterns = env_p }
    // BENCH_STRICT=1 (the CI job): every selected language must build and
    // pass, so a skip is an error there, not a missing toolchain.
    strict = 0
    env_s = getenv("BENCH_STRICT")
    if env_s != 0 { strict = atoi(env_s) }
    problems = ""

    on_windows = select(windows: 1, other: 0)

    // A non-interactive sh has a minimal PATH: add the usual tool locations
    // so cargo, erlc, ponyc and the rest are found. Not on Windows, whose
    // PATH is `;`-separated and which the MSYS shell already has.
    if on_windows == 0 {
        home = getenv("HOME")
        cur_path = getenv("PATH")
        tool_paths = "/opt/homebrew/bin:/opt/homebrew/opt/erlang/bin:/opt/homebrew/opt/elixir/bin:/usr/local/bin:/usr/local/go/bin:/snap/bin:${cur_path}"
        if home != 0 {
            tool_paths = "${home}/.cargo/bin:${home}/go/bin:${home}/.local/bin:${tool_paths}"
        }
        io_setenv("PATH", tool_paths)
    }

    uname = sh_text("uname -s")
    is_mac = string.contains(uname, "Darwin")
    // CPU time and peak memory come from /usr/bin/time, which on Windows
    // (MSYS) sees only itself: it reads 0 s and about 5 MB for any native
    // program. There they are n/a rather than a number that means nothing.
    time_cmd = ""
    measure_note = "CPU time and peak memory are not measured on this platform"
    if on_windows == 0 {
        _tout, tstatus = sh_run("test -x /usr/bin/time")
        if tstatus == 0 {
            time_cmd = "/usr/bin/time -v"
            if is_mac == 1 { time_cmd = "/usr/bin/time -l" }
            measure_note = "CPU time (user + system) and peak memory of the whole process, from ${time_cmd}"
        }
    }

    cpu_name = ""
    cores = ""
    if is_mac == 1 {
        cpu_name = sh_text("sysctl -n machdep.cpu.brand_string")
        cores = sh_text("sysctl -n hw.ncpu")
    } else {
        // /proc/cpuinfo, which Linux and MSYS both have (lscpu MSYS has not).
        cpu_name = sh_text("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs")
        cores = sh_text("nproc")
    }
    arch = sh_text("uname -m")

    cfg = Settings { runs: runs, warmup: warmup, msgs: msgs, time_cmd: time_cmd, is_mac: is_mac }

    _mk, _mks = sh_run("mkdir -p build")
    io_write_file("build/problems.txt", "")

    println("============================================")
    println("  Aether Cross-Language Benchmark Suite")
    println("============================================")
    println("  Messages: ${msgs}")
    println("  Runs: ${runs} (median), warmup: ${warmup} for every language")
    println("  ${measure_note}")
    println("")

    pi = 0
    while pi < 5 {
        pattern = pattern_at(pi)
        pi = pi + 1
        if !selected(only_patterns, pattern) {
            continue
        }

        println("============================================")
        println("  Running: ${pattern}")
        println("============================================")

        ts = sh_text("date -u +\"%Y-%m-%dT%H:%M:%SZ\"")
        json = "{\n  \"timestamp\": \"${ts}\",\n"
        json = "${json}  \"pattern\": \"${pattern}\",\n"
        json = "${json}  \"messages\": ${msgs},\n"
        json = "${json}  \"runs_per_benchmark\": ${runs},\n"
        json = "${json}  \"warmup_runs\": ${warmup},\n"
        json = "${json}  \"description\": \"${pattern_description(pattern)}\",\n"
        json = "${json}  \"measurement\": \"${json_escape(measure_note)}\",\n"
        json = "${json}  \"hardware\": {\n    \"cpu\": \"${json_escape(cpu_name)}\",\n"
        json = "${json}    \"cores\": \"${cores}\",\n"
        json = "${json}    \"os\": \"${json_escape(uname)}\",\n"
        json = "${json}    \"arch\": \"${arch}\"\n  },\n  \"benchmarks\": {\n"
        failed = ""

        first = 1
        li = 0
        while li < LANG_COUNT {
            name = lang_name(li)
            if !selected(only_langs, string.to_lower(name)) && !selected(only_langs, lang_dir(li)) {
                li = li + 1
                continue
            }
            res = run_lang(li, pattern, cfg)
            // A missing third-party toolchain is a fair skip; a missing or
            // wrong Aether is not. A results file that omits Aether while
            // listing ten other languages reads as a complete comparison.
            if li == 0 && (string.length(res) == 0 || string.starts_with(res, "FAIL: ") == 1) {
                println("")
                println("ERROR: Aether did not build or did not run correctly, so there is nothing to compare against.")
                println("       Reproduce with: cd benchmarks/cross-language/aether && make ${pattern}")
                why = "did not build (build/aether_${pattern}.log)"
                if string.length(res) > 0 {
                    why = string.substring(res, 6, string.length(res))
                }
                io_write_file("build/problems.txt", "${problems}  Aether ${pattern}: ${why}\n")
                exit(1)
            }
            if string.length(res) == 0 {
                problems = "${problems}  ${name} ${pattern}: did not build (build/${lang_dir(li)}_${pattern}.log)\n"
            } else if string.starts_with(res, "FAIL: ") == 1 {
                if string.length(failed) > 0 {
                    failed = "${failed},\n"
                }
                reason = string.substring(res, 6, string.length(res))
                failed = "${failed}    \"${name}\": \"${json_escape(reason)}\""
                problems = "${problems}  ${name} ${pattern}: ${reason}\n"
            } else {
                if first == 0 {
                    json = "${json},\n"
                }
                json = "${json}${res}"
                first = 0
            }
            li = li + 1
        }

        json = "${json}\n  },\n  \"failed\": {\n${failed}\n  }\n}\n"
        path = "visualize/results_${pattern}.json"
        io_write_file(path, json)
        println("Results: ${path}")
        println("")
    }

    println("============================================")
    println("  All benchmarks complete!")
    println("============================================")
    // What broke, one "<language> <pattern>: <reason>" per line, for the CI
    // job's summary; empty when nothing did.
    io_write_file("build/problems.txt", problems)
    if strict != 0 && string.length(problems) > 0 {
        println("")
        println("BENCH_STRICT: every selected language must build and pass:")
        print(problems)
        exit(1)
    }
}
