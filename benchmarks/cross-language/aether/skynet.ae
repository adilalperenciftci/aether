// Aether Skynet Benchmark
// Based on https://github.com/atemerev/skynet
// Creates a recursive tree of actors: root spawns 10 children,
// each spawns 10 more, down to SEQUENTIAL_THRESHOLD.
// Below the threshold, the subtree sum is computed sequentially
// in the actor's handler (no child actors spawned).
// This matches the approach used by C, Go, Rust, and other
// high-performance implementations.
//
// Default: 1,000,000 leaves, threshold 1000 -> 1,111 actors. See FAIRNESS.md.

// Spawn starts tree construction.
// parent=0 for the root (it has no parent to report to).
message Spawn { offset: long, size: long, parent: ptr }

// Result carries a subtree sum up the tree.
// value is long (int64) to hold the full sum for 1M leaves (max ~499999500000).
message Result { value: long }

actor SkynetNode {
    state parent_ref = 0;
    state pending = 0;
    state long total = 0;

    receive {
        Spawn(offset, size, parent) -> {
            parent_ref = parent;
            if (size <= 1000) {
                // Sequential threshold: compute subtree sum without spawning actors.
                long sum = 0;
                long i = 0;
                while (i < size) {
                    sum = sum + offset + i;
                    i = i + 1;
                }
                if (parent_ref == 0) {
                    total = sum;
                } else {
                    parent_ref ! Result { value: sum };
                }
            } else {
                child_size = size / 10;
                // Distribute remainder: first (size % 10) children get child_size+1
                remainder = size - child_size * 10;
                pending = 10;
                long child_offset = offset;
                i = 0;
                while (i < 10) {
                    // First 'remainder' children get one extra leaf
                    cs = child_size;
                    if (i < remainder) {
                        cs = cs + 1;
                    }
                    child = spawn(SkynetNode());
                    // The node passes itself as the parent: one message per
                    // child, as in every language here. (A Setup message
                    // telling each child its own ref doubled that.)
                    child ! Spawn { offset: child_offset, size: cs, parent: self };
                    child_offset = child_offset + cs;
                    i = i + 1;
                }
            }
        }
        Result(value) -> {
            total = total + value;
            pending = pending - 1;
            if (pending == 0) {
                // parent_ref == 0 means we are the root: stop here.
                // Non-root nodes propagate the sum upward.
                if (parent_ref != 0) {
                    parent_ref ! Result { value: total };
                }
            }
        }
    }
}

main() {
    long num_leaves = 1000000;
    env_val = getenv("SKYNET_LEAVES");
    if (env_val != 0) {
        num_leaves = atoi(env_val);
    }

    // Divide by units created, not the tree's node count. See FAIRNESS.md.
    long actor_count = 1;
    long n = num_leaves;
    while (n > 1000) {
        actor_count = actor_count + n / 1000;
        n = n / 10;
    }
    long total_nodes = actor_count;

    start_time = clock_ns();

    root = spawn(SkynetNode());
    // parent=0 signals this is the root (no parent to report to)
    root ! Spawn { offset: 0, size: num_leaves, parent: 0 };

    wait_for_idle();
    end_time = clock_ns();

    print("Leaves: ");
    print(num_leaves);
    print(", concurrency units: ");
    print(actor_count);
    print(" (sequential below 1000)\n");
    print("Sum: ");
    print(root.total);
    print("\n");
    print("Checksum: ");
    print(root.total);
    print("\n");

    // Always printed: a tree small enough to finish within a microsecond
    // printed no rate at all, which the runner reads as a broken run.
    long elapsed_ns = end_time - start_time;
    if (elapsed_ns < 1) {
        elapsed_ns = 1;
    }
    print("ns/msg:         ");
    print(elapsed_ns / total_nodes);
    print("\n");

    // Millions per second, in hundredths: units * 1e9 / ns / 1e6 * 100.
    long hundredths = total_nodes * 100000 / elapsed_ns;
    throughput_m = hundredths / 100;
    throughput_frac = hundredths - throughput_m * 100;
    print("Throughput:     ");
    print(throughput_m);
    print(".");
    if (throughput_frac < 10) {
        print("0");
    }
    print(throughput_frac);
    print(" M msg/sec\n");
}
