// Aether Ping-Pong Benchmark (Savina-style)
// Based on the Savina benchmark suite micro-benchmark
// Measures pure message passing overhead between two actors

message Ping { count: int }
message Pong { count: int }

actor PingActor {
    state pong_ref = 0;
    state received = 0;
    state target = 0;
    state errors = 0;
    // The sum of the values ping got back, which the runner checks.
    state long checksum = 0;

    receive {
        Pong(count) -> {
            if (count != received) {
                errors = errors + 1;
            }
            checksum = checksum + count;
            received = received + 1;

            if (received < target) {
                pong_ref ! Ping { count: received };
            }
        }
    }
}

actor PongActor {
    state ping_ref = 0;
    state expected = 0;

    receive {
        Ping(count) -> {
            if (count != expected) {
                // Sequence error
            }
            expected = expected + 1;
            ping_ref ! Pong { count: count };
        }
    }
}

main() {
    total_messages = 100000;
    env_val = getenv("BENCHMARK_MESSAGES");
    if (env_val != 0) {
        total_messages = atoi(env_val);
    }

    start_time = clock_ns();

    ping = spawn(PingActor());
    pong = spawn(PongActor());

    ping.pong_ref = pong;
    ping.target = total_messages;
    pong.ping_ref = ping;

    pong ! Ping { count: 0 };
    wait_for_idle();
    end_time = clock_ns();

    if (ping.errors > 0) {
        print("VALIDATION FAILED: ");
        print(ping.errors);
        print(" errors\n");
    }

    actual_received = ping.received;
    if (actual_received < total_messages) {
        print("INCOMPLETE: ");
        print(actual_received);
        print("/");
        print(total_messages);
        print(" messages\n");
    }

    print("Checksum: ");
    print(ping.checksum);
    print("\n");

    // Always printed: a run shorter than a microsecond printed no rate,
    // which the runner reads as a broken run.
    long elapsed_ns = end_time - start_time;
    if (elapsed_ns < 1) {
        elapsed_ns = 1;
    }
    print("ns/msg:         ");
    print(elapsed_ns / actual_received);
    print("\n");

    // Millions per second, in hundredths: count * 1e9 / ns / 1e6 * 100.
    long hundredths = actual_received;
    hundredths = hundredths * 100000 / elapsed_ns;
    throughput_m = hundredths / 100;
    throughput_frac = hundredths - throughput_m * 100;
    print("Throughput:     ");
    print(throughput_m);
    print(".");
    if (throughput_frac < 10) {
        print("0");
    }
    print(throughput_frac);
    print(" M msg/sec\n");
}
