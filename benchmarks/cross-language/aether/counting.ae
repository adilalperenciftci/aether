// Aether Counting Actor Benchmark (Savina-style)
// Based on the Savina benchmark suite micro-benchmark
// Measures message passing overhead with a single counting actor

message Increment {}

actor Counter {
    state count = 0;

    receive {
        Increment() -> {
            count = count + 1;
        }
    }
}

main() {
    // Read from BENCHMARK_MESSAGES env var, default 100K
    total_messages = 100000;
    env_val = getenv("BENCHMARK_MESSAGES");
    if (env_val != 0) {
        total_messages = atoi(env_val);
    }

    // The clock starts before the counter exists, as in every language here
    // (FAIRNESS.md, rule 5).
    start_time = clock_ns();
    counter = spawn(Counter());

    // Send all messages
    i = 0;
    while (i < total_messages) {
        counter ! Increment {};
        i = i + 1;
    }

    // Wait for completion
    wait_for_idle();

    // Get end time
    end_time = clock_ns();

    // Verify
    actual = counter.count;
    if (actual != total_messages) {
        print("VALIDATION FAILED: expected ");
        print(total_messages);
        print(" got ");
        print(actual);
        print("\n");
    }

    print("Checksum: ");
    print(actual);
    print("\n");

    // Always printed: a run shorter than a microsecond printed no rate,
    // which the runner reads as a broken run.
    long elapsed_ns = end_time - start_time;
    if (elapsed_ns < 1) {
        elapsed_ns = 1;
    }
    print("ns/msg:         ");
    print(elapsed_ns / actual);
    print("\n");

    // Millions per second, in hundredths: count * 1e9 / ns / 1e6 * 100.
    long hundredths = actual;
    hundredths = hundredths * 100000 / elapsed_ns;
    throughput_m = hundredths / 100;
    throughput_frac = hundredths - throughput_m * 100;
    print("Throughput:     ");
    print(throughput_m);
    print(".");
    if (throughput_frac < 10) {
        print("0");
    }
    print(throughput_frac);
    print(" M msg/sec\n");
}
