// The extern ABI checker's self-test (tests/extern_abi/check.ae): six
// findings, each marked, and declarations that must pass. Never built.

exports(sym)

// A finding: `long` is int64_t, the C definition takes a size_t.
extern fx_len(data: ptr, n: long) -> ptr
// A finding: C long is 32 or 64 bits by platform.
extern fx_count() -> long
// A finding: the C definition takes three parameters.
extern fx_pair(a: int, b: int) -> int
// A finding: the C definition returns a pointer.
extern fx_handle(p: ptr) -> int
// A finding: the @extern binds fx_sym_impl, which takes an int.
@extern("fx_sym_impl") sym(n: long)

// No finding: every width matches.
extern fx_good(a: int, b: long, s: string, n: size_t, f: float) -> float
// No finding: a variadic function's parameters are not counted.
extern fx_fmt(fmt: string, ...) -> int
// No finding: a function type and a bool are not compared.
extern fx_cb(cb: fn(int) -> int, ud: ptr, b: bool)
// No finding: a comment is not read: extern fx_len(data: ptr, n: int) -> ptr
// No finding: the C definition is static, nothing a program links.
extern fx_hidden(n: long) -> int
