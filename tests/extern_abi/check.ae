// Every extern binds its C function with the widths that function takes,
// and every C function of the runtime, std and contrib has one definition
// (#3185).
//
// An extern's Aether types lower to fixed C types: `int` to int, `long` to
// int64_t, `size_t` to size_t, `float` to double, a `ptr` or a `string` to a
// pointer. When the C definition takes another width, a 64-bit host hides
// it (a long and a size_t are both eight bytes there) and a 32-bit one does
// not: wasm32's linker replaced string_new_with_length, declared with an
// int64_t length and defined with a size_t one, by a stub that traps, so
// every actor message that carried a string killed the program under
// Emscripten. A C `long` is four bytes on Windows and wasm32 and eight on
// Linux, so no Aether type has its width everywhere.
//
// This reads the C function definitions under the given directories (not
// `static`, starting a line) and every `extern` and `@extern("sym")`
// declaration, matches each declaration to the definition of the C symbol
// it binds (the one in the declaring file's directory when there is one),
// and reports:
//   - a parameter or a result whose width differs, or another number of
//     parameters (a variadic function's are not counted);
//   - a C function defined in two directories, which a program linking both
//     has twice (contrib.parsers.xml_expat and std.xml both defined
//     xml_parser_new).
// A type it cannot size (a struct by value, a typedef, a function type) is
// not compared, nor is a char, a short or a bool, which C widens.
//
//     check [--expect N] DIR...
//
// Exits 1 on a finding; with --expect, unless exactly N were found (the
// self-test over tests/extern_abi/fixture). `make check-extern-abi` runs
// both.

import std.fs
import std.os
import std.io
import std.map
import std.string
import std.collections

extern exit(code: int)

say(s: string) {
    _w = io.stdout_write("${s}\n")
}

is_ident_char(c: int) -> int {
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 {
        return 1
    }
    return 0
}

last_index_of_char(s: string, c: int) -> int {
    n = string.length(s)
    i = n - 1
    while i >= 0 {
        if string.char_at_n(s, n, i) == c {
            return i
        }
        i = i - 1
    }
    return -1
}

dir_of(p: string) -> string {
    slash = last_index_of_char(p, 47)
    if slash < 0 {
        return "."
    }
    return string.substring(p, 0, slash)
}

// The lines of a text, without their line breaks.
split_lines(text: string) -> ptr {
    out = collections.string_list_new()
    n = string.length(text)
    start = 0
    while start < n {
        cut = string.index_of_from(text, "\n", start)
        stop = cut
        if cut < 0 {
            stop = n
        }
        line_end = stop
        if line_end > start && string.char_at_n(text, n, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        collections.string_list_add(out, string.substring(text, start, line_end))
        start = stop + 1
    }
    return out
}

// A line without its `//` comment (one inside a string literal stays).
cut_comment(line: string) -> string {
    n = string.length(line)
    in_str = 0
    i = 0
    while i < n {
        c = string.char_at_n(line, n, i)
        if in_str == 1 {
            if c == 92 {
                i = i + 2
                continue
            }
            if c == 34 {
                in_str = 0
            }
        } else if c == 34 {
            in_str = 1
        } else if c == 47 && i + 1 < n && string.char_at_n(line, n, i + 1) == 47 {
            return string.substring(line, 0, i)
        }
        i = i + 1
    }
    return line
}

// The whitespace-separated words of `s`.
words(s: string) -> ptr {
    out = collections.string_list_new()
    n = string.length(s)
    i = 0
    while i < n {
        while i < n && (string.char_at_n(s, n, i) == 32 || string.char_at_n(s, n, i) == 9) {
            i = i + 1
        }
        start = i
        while i < n && string.char_at_n(s, n, i) != 32 && string.char_at_n(s, n, i) != 9 {
            i = i + 1
        }
        if i > start {
            collections.string_list_add(out, string.substring(s, start, i))
        }
    }
    return out
}

// The index of the `)` that closes the `(` at `open`, or -1.
matching_paren(s: string, open: int) -> int {
    n = string.length(s)
    depth = 0
    i = open
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 40 {
            depth = depth + 1
        } else if c == 41 {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// The parts of a parameter list, split at the commas outside parentheses
// (a function type's own commas stay in its part).
split_params(s: string) -> ptr {
    out = collections.string_list_new()
    n = string.length(s)
    depth = 0
    start = 0
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 40 {
            depth = depth + 1
        } else if c == 41 {
            depth = depth - 1
        } else if c == 44 && depth == 0 {
            collections.string_list_add(out, string.trim(string.substring(s, start, i)))
            start = i + 1
        }
        i = i + 1
    }
    last = string.trim(string.substring(s, start, n))
    if last != "" {
        collections.string_list_add(out, last)
    }
    return out
}

is_all_caps(w: string) -> int {
    n = string.length(w)
    if n == 0 {
        return 0
    }
    c0 = string.char_at_n(w, n, 0)
    if c0 < 65 || c0 > 90 {
        return 0
    }
    i = 0
    while i < n {
        c = string.char_at_n(w, n, i)
        if !((c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// A width class: "i32", "i64", "word" (size_t, the pointer's width),
// "long" (C's, 32 or 64 bits by platform), "f64", "f32", "ptr", "void",
// "small" (widened by C, not compared), or "" (cannot say).
c_class(t: string) -> string {
    if string.contains(t, "*") == 1 || string.contains(t, "[") == 1 {
        return "ptr"
    }
    ws = words(t)
    kept = ""
    nw = collections.string_list_size(ws)
    i = 0
    while i < nw {
        w = collections.string_list_get(ws, i)
        if w != "const" && w != "volatile" && w != "static" && w != "inline" &&
        w != "extern" && w != "register" && w != "restrict" && w != "__restrict" &&
        w != "signed" && w != "__inline" && is_all_caps(w) == 0 {
            if kept == "" {
                kept = w
            } else {
                kept = "${kept} ${w}"
            }
        }
        i = i + 1
    }
    collections.string_list_free(ws)
    if kept == "int" || kept == "unsigned" || kept == "unsigned int" ||
    kept == "int32_t" || kept == "uint32_t" {
        return "i32"
    }
    if kept == "long long" || kept == "long long int" || kept == "unsigned long long" ||
    kept == "unsigned long long int" || kept == "int64_t" || kept == "uint64_t" ||
    kept == "off_t" || kept == "time_t" {
        return "i64"
    }
    if kept == "size_t" || kept == "ssize_t" || kept == "intptr_t" || kept == "uintptr_t" ||
    kept == "ptrdiff_t" {
        return "word"
    }
    if kept == "long" || kept == "long int" || kept == "unsigned long" || kept == "unsigned long int" {
        return "long"
    }
    if kept == "double" {
        return "f64"
    }
    if kept == "float" {
        return "f32"
    }
    if kept == "void" {
        return "void"
    }
    if kept == "char" || kept == "unsigned char" || kept == "short" || kept == "unsigned short" ||
    kept == "int8_t" || kept == "uint8_t" || kept == "int16_t" || kept == "uint16_t" ||
    kept == "_Bool" || kept == "bool" {
        return "small"
    }
    return ""
}

is_c_type_word(w: string) -> int {
    if w == "int" || w == "long" || w == "short" || w == "char" || w == "unsigned" ||
    w == "signed" || w == "double" || w == "float" || w == "void" || w == "_Bool" ||
    w == "bool" || w == "const" || w == "size_t" || w == "ssize_t" || w == "intptr_t" ||
    w == "uintptr_t" || w == "ptrdiff_t" || w == "off_t" || w == "time_t" {
        return 1
    }
    if string.ends_with(w, "_t") == 1 && (string.starts_with(w, "int") == 1 || string.starts_with(w, "uint") == 1) {
        return 1
    }
    return 0
}

// A C parameter's type, its name taken off: `size_t length` is `size_t`.
c_param_type(p: string) -> string {
    t = string.trim(p)
    if string.contains(t, "(") == 1 {
        return "(fn)"
    }
    if string.contains(t, "*") == 1 || string.contains(t, "[") == 1 {
        return t
    }
    ws = words(t)
    nw = collections.string_list_size(ws)
    out = ""
    i = 0
    while i < nw {
        w = collections.string_list_get(ws, i)
        if i == nw - 1 && nw > 1 && is_c_type_word(w) == 0 {
            break
        }
        if out == "" {
            out = w
        } else {
            out = "${out} ${w}"
        }
        i = i + 1
    }
    collections.string_list_free(ws)
    return out
}

// The class of an Aether type, as it lowers to C.
ae_class(t: string) -> string {
    ws = words(t)
    kept = ""
    nw = collections.string_list_size(ws)
    i = 0
    while i < nw {
        w = collections.string_list_get(ws, i)
        if string.starts_with(w, "@") == 0 && w != "const" {
            if kept == "" {
                kept = w
            } else {
                kept = "${kept} ${w}"
            }
        }
        i = i + 1
    }
    collections.string_list_free(ws)
    if string.starts_with(kept, "fn") == 1 || string.contains(kept, "(") == 1 ||
    string.ends_with(kept, "?") == 1 {
        return ""
    }
    if string.contains(kept, "[") == 1 || kept == "ptr" || kept == "string" {
        return "ptr"
    }
    if kept == "int" || kept == "uint32" || kept == "int32_t" || kept == "uint32_t" {
        return "i32"
    }
    if kept == "long" || kept == "int64" || kept == "uint64" || kept == "ulong" ||
    kept == "int64_t" || kept == "uint64_t" || kept == "off_t" || kept == "time_t" {
        return "i64"
    }
    if kept == "size_t" || kept == "ssize_t" || kept == "intptr_t" || kept == "uintptr_t" {
        return "word"
    }
    if kept == "float" || kept == "float64" {
        return "f64"
    }
    if kept == "float32" {
        return "f32"
    }
    if kept == "bool" || kept == "byte" || kept == "uint8" || kept == "uint16" ||
    kept == "int8_t" || kept == "int16_t" || kept == "uint8_t" || kept == "uint16_t" {
        return "small"
    }
    return ""
}

width_name(k: string) -> string {
    if k == "i32" {
        return "a 32-bit integer"
    }
    if k == "i64" {
        return "a 64-bit integer"
    }
    if k == "word" {
        return "a size_t (the pointer's width)"
    }
    if k == "long" {
        return "a C long (32 or 64 bits by platform)"
    }
    if k == "f64" {
        return "a double"
    }
    if k == "f32" {
        return "a float"
    }
    if k == "ptr" {
        return "a pointer"
    }
    if k == "void" {
        return "nothing"
    }
    return k
}

// Two classes that disagree, either known and neither widened by C.
differ(a: string, c: string) -> int {
    if a == "" || c == "" || a == "small" || c == "small" || a == c {
        return 0
    }
    return 1
}

// The C function definition that starts at line `k`, as
// "name\tret\tparams", or "". A line that starts with a letter, holds the
// `(`, and whose `)` is followed by the body's `{`; a `static` one is not
// a symbol the program sees. A return type alone on the line before
// (`AetherString*` above `string_x(...) {`) is taken too.
c_definition(lines: ptr, k: int) -> string {
    nl = collections.string_list_size(lines)
    first = collections.string_list_get(lines, k)
    n0 = string.length(first)
    if n0 == 0 {
        return ""
    }
    c0 = string.char_at_n(first, n0, 0)
    if !((c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90) || c0 == 95) {
        return ""
    }
    open = string.index_of(first, "(")
    if open < 0 {
        return ""
    }
    lead = string.substring(first, 0, open)
    if string.contains(lead, "=") == 1 {
        return ""
    }
    lw = words(lead)
    nlw = collections.string_list_size(lw)
    w0 = ""
    if nlw > 0 {
        w0 = collections.string_list_get(lw, 0)
    }
    collections.string_list_free(lw)
    if w0 == "static" || w0 == "typedef" || w0 == "extern" || w0 == "return" || w0 == "else" ||
    w0 == "if" || w0 == "for" || w0 == "while" || w0 == "switch" || w0 == "do" ||
    w0 == "case" || w0 == "goto" || w0 == "struct" || w0 == "enum" || w0 == "union" ||
    w0 == "sizeof" {
        return ""
    }
    // The header up to the `)` closing its parameter list, over at most
    // eight lines.
    text = first
    j = k
    close = matching_paren(text, open)
    while close < 0 && j + 1 < nl && j < k + 8 {
        j = j + 1
        text = "${text}\n${collections.string_list_get(lines, j)}"
        close = matching_paren(text, open)
    }
    if close < 0 {
        return ""
    }
    after = string.trim(string.substring(text, close + 1, string.length(text)))
    if after == "" {
        if j + 1 >= nl || string.starts_with(string.trim(collections.string_list_get(lines, j + 1)), "{") == 0 {
            return ""
        }
    } else if string.starts_with(after, "{") == 0 {
        return ""
    }
    pre = string.trim(lead)
    np = string.length(pre)
    e = np
    while e > 0 && is_ident_char(string.char_at_n(pre, np, e - 1)) == 1 {
        e = e - 1
    }
    name = string.substring(pre, e, np)
    ret = string.trim(string.substring(pre, 0, e))
    if name == "" {
        return ""
    }
    if ret == "" {
        // `name(...) {` with the type on the line before, if that line is
        // one.
        if k == 0 {
            return ""
        }
        prev = string.trim(collections.string_list_get(lines, k - 1))
        if prev == "" || string.starts_with(prev, "#") == 1 || string.starts_with(prev, "/") == 1 ||
        string.starts_with(prev, "*") == 1 || string.starts_with(prev, "static") == 1 ||
        string.ends_with(prev, ";") == 1 || string.ends_with(prev, "{") == 1 ||
        string.ends_with(prev, "}") == 1 || string.ends_with(prev, ",") == 1 ||
        string.ends_with(prev, ")") == 1 {
            return ""
        }
        ret = prev
    }
    params = string.replace_all(string.substring(text, open + 1, close), "\n", " ")
    return "${name}\t${ret}\t${params}"
}

// One extern declaration starting at line `k`, as "sym\tname\tparams\tret",
// or "": `extern name(...) -> T` binds C `name`, `@extern("sym") name(...)`
// binds `sym`.
ae_extern(lines: ptr, k: int) -> string {
    nl = collections.string_list_size(lines)
    t = string.trim(cut_comment(collections.string_list_get(lines, k)))
    sym = ""
    rest = ""
    if string.starts_with(t, "extern ") == 1 {
        rest = string.trim(string.substring(t, 7, string.length(t)))
    } else if string.starts_with(t, "@extern(\"") == 1 {
        q = string.index_of_from(t, "\"", 9)
        close = string.index_of(t, ")")
        if q < 0 || close < 0 {
            return ""
        }
        sym = string.substring(t, 9, q)
        rest = string.trim(string.substring(t, close + 1, string.length(t)))
    } else {
        return ""
    }
    open = string.index_of(rest, "(")
    if open <= 0 {
        return ""
    }
    name = string.trim(string.substring(rest, 0, open))
    j = k
    close = matching_paren(rest, open)
    while close < 0 && j + 1 < nl && j < k + 6 {
        j = j + 1
        rest = "${rest} ${string.trim(cut_comment(collections.string_list_get(lines, j)))}"
        close = matching_paren(rest, open)
    }
    if close < 0 {
        return ""
    }
    if sym == "" {
        sym = name
    }
    params = string.substring(rest, open + 1, close)
    tail = string.trim(string.substring(rest, close + 1, string.length(rest)))
    ret = ""
    if string.starts_with(tail, "->") == 1 {
        ret = string.trim(string.substring(tail, 2, string.length(tail)))
    }
    return "${sym}\t${name}\t${params}\t${ret}"
}

// The `i`th tab-separated field of `s`.
field(s: string, i: int) -> string {
    start = 0
    k = 0
    while k < i {
        t = string.index_of_from(s, "\t", start)
        if t < 0 {
            return ""
        }
        start = t + 1
        k = k + 1
    }
    stop = string.index_of_from(s, "\t", start)
    if stop < 0 {
        stop = string.length(s)
    }
    return string.substring(s, start, stop)
}

has_varargs(parts: ptr) -> int {
    n = collections.string_list_size(parts)
    i = 0
    while i < n {
        if string.trim(collections.string_list_get(parts, i)) == "..." ||
        string.ends_with(collections.string_list_get(parts, i), "...") == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// What is wrong with extern `ext` against definition `def` (both as the
// two functions above return them), or "".
compare(ext: string, def: string) -> string {
    ap = split_params(field(ext, 2))
    cp = split_params(field(def, 2))
    if collections.string_list_size(cp) == 1 && string.trim(collections.string_list_get(cp, 0)) == "void" {
        collections.string_list_free(cp)
        cp = collections.string_list_new()
    }
    out = ""
    na = collections.string_list_size(ap)
    nc = collections.string_list_size(cp)
    if has_varargs(ap) == 0 && has_varargs(cp) == 0 {
        if na != nc {
            out = "declared with ${na} parameter(s), and the C definition takes ${nc}"
        } else {
            i = 0
            while i < na {
                a = collections.string_list_get(ap, i)
                colon = string.index_of(a, ":")
                at = ""
                if colon >= 0 {
                    at = string.trim(string.substring(a, colon + 1, string.length(a)))
                }
                ct = c_param_type(collections.string_list_get(cp, i))
                ak = ae_class(at)
                ck = c_class(ct)
                if differ(ak, ck) == 1 {
                    if out != "" {
                        out = "${out}; "
                    }
                    out = "${out}parameter ${i + 1} is `${at}`, ${width_name(ak)}, and the C definition takes `${ct}`, ${width_name(ck)}"
                }
                i = i + 1
            }
        }
    }
    collections.string_list_free(ap)
    collections.string_list_free(cp)
    rt = field(ext, 3)
    rk = "void"
    if rt != "" {
        rk = ae_class(rt)
    }
    ck = c_class(field(def, 1))
    if differ(rk, ck) == 1 {
        if out != "" {
            out = "${out}; "
        }
        shown = rt
        if shown == "" {
            shown = "no result"
        } else {
            shown = "`${shown}`"
        }
        out = "${out}the result is ${shown}, ${width_name(rk)}, and the C definition returns `${field(def, 1)}`, ${width_name(ck)}"
    }
    return out
}

main() {
    dirs = collections.string_list_new()
    expect = -1
    argc = os.args_count()
    i = 1
    while i < argc {
        a = os.args_get(i)
        if a == "--expect" && i + 1 < argc {
            i = i + 1
            expect = string.get_int(os.args_get(i))
        } else {
            collections.string_list_add(dirs, string.replace_all(a, "\\", "/"))
        }
        i = i + 1
    }
    if collections.string_list_size(dirs) == 0 {
        say("usage: check [--expect N] DIR...")
        exit(2)
    }

    cfiles = collections.string_list_new()
    aefiles = collections.string_list_new()
    nd = collections.string_list_size(dirs)
    i = 0
    while i < nd {
        root = collections.string_list_get(dirs, i)
        _n, werr = fs.walk(root) | path: string, kind: int, depth: int | {
            p = string.replace_all(path, "\\", "/")
            verdict = 0
            if kind == 2 {
                base = p
                slash = last_index_of_char(p, 47)
                if slash >= 0 {
                    base = string.substring(p, slash + 1, string.length(p))
                }
                if base == "build" || base == ".git" || base == "target" || base == "node_modules" {
                    verdict = 1
                }
            } else if kind == 1 && string.ends_with(p, ".c") == 1 {
                collections.string_list_add(cfiles, p)
            } else if kind == 1 && string.ends_with(p, ".ae") == 1 {
                collections.string_list_add(aefiles, p)
            }
            return verdict
        }
        if werr != "" {
            say("extern abi: cannot walk ${root}: ${werr}")
            exit(2)
        }
        i = i + 1
    }

    // Pass 1: the C definitions, by name and by "name dir", and each
    // name's first directory.
    found = 0
    by_name = map.new()
    by_dir = map.new()
    first_dir = map.new()
    reported = map.new()
    ndefs = 0
    ncf = collections.string_list_size(cfiles)
    i = 0
    while i < ncf {
        p = collections.string_list_get(cfiles, i)
        dir = dir_of(p)
        text, rerr = fs.read(p)
        if rerr != "" {
            say("extern abi: cannot read ${p}: ${rerr}")
            exit(2)
        }
        lines = split_lines(text)
        nl = collections.string_list_size(lines)
        k = 0
        while k < nl {
            d = c_definition(lines, k)
            if d != "" {
                name = field(d, 0)
                entry = "${p}:${k + 1}\t${field(d, 1)}\t${field(d, 2)}"
                if map.has(by_name, name) == 0 {
                    map.put(by_name, name, entry)
                    map.put(first_dir, name, dir)
                    ndefs = ndefs + 1
                } else if name != "main" && map.has(reported, name) == 0 {
                    other, _e = map.get_string(first_dir, name)
                    if other != dir {
                        say("${p}:${k + 1}: ${name} is defined in ${other} too; a program linking both has two, so one of them needs a name of its own")
                        map.put(reported, name, dir)
                        found = found + 1
                    }
                }
                key = "${name} ${dir}"
                if map.has(by_dir, key) == 0 {
                    map.put(by_dir, key, entry)
                }
            }
            k = k + 1
        }
        collections.string_list_free(lines)
        i = i + 1
    }

    // Pass 2: each extern against the definition of the symbol it binds.
    nexterns = 0
    naf = collections.string_list_size(aefiles)
    i = 0
    while i < naf {
        p = collections.string_list_get(aefiles, i)
        dir = dir_of(p)
        text, rerr = fs.read(p)
        if rerr != "" {
            say("extern abi: cannot read ${p}: ${rerr}")
            exit(2)
        }
        lines = split_lines(text)
        nl = collections.string_list_size(lines)
        k = 0
        while k < nl {
            ext = ae_extern(lines, k)
            if ext != "" {
                sym = field(ext, 0)
                cdef, _e1 = map.get_string(by_dir, "${sym} ${dir}")
                if cdef == null {
                    cdef, _e2 = map.get_string(by_name, sym)
                }
                if cdef != null {
                    nexterns = nexterns + 1
                    wrong = compare(ext, cdef)
                    if wrong != "" {
                        say("${p}:${k + 1}: ${field(ext, 1)}: ${wrong} (${field(cdef, 0)})")
                        found = found + 1
                    }
                }
            }
            k = k + 1
        }
        collections.string_list_free(lines)
        i = i + 1
    }

    say("extern abi: ${ndefs} C functions, ${nexterns} externs bound to one: ${found} finding(s)")
    if expect >= 0 {
        if found != expect {
            say("extern abi: the self-test expected ${expect}")
            exit(1)
        }
        exit(0)
    }
    if found > 0 {
        exit(1)
    }
}
