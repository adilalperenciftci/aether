// Test: a message within the interval stops the countdown, and the countdown
// starts again once the messages stop (#3162).
//
// Pings come every 50 ms for half a second, under a 1000 ms timeout, so it
// must not fire while they come; the ask that follows sees that. Once they
// stop, the countdown ends and the timeout fires once: it used to be
// cancelled for good by the first message, and this test checked that it
// never fired at all.

message Ping {}

message Fired {}

message Times { n: int }

extern exit(code: int)

actor Waiter {
    state count = 0
    state timed_out = 0

    receive {
        Ping -> {
            count = count + 1
        }
        Fired() -> { reply Times { n: timed_out } }
    } after 1000 -> {
        timed_out = timed_out + 1
    }
}

main() {
    w = spawn(Waiter())
    i = 0
    while i < 10 {
        w ! Ping {}
        sleep(50)
        i = i + 1
    }
    int during = w ? Fired {}
    if during != 0 {
        println("FAIL: the timeout fired ${during} time(s) while pings came within its interval")
        exit(1)
    }
    println("PASS: pings within the interval kept the timeout from firing")

    // The ask was a message too: the countdown runs from its end.
    wait_for_idle()
    if w.count != 10 || w.timed_out != 1 {
        println("FAIL: ${w.count} ping(s), the timeout fired ${w.timed_out} time(s) after them, expected 10 and 1")
        exit(1)
    }
    println("PASS: once the messages stopped, the timeout fired once")
}
