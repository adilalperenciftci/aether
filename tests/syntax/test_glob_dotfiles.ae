// Regression test: fs.glob's recursive walk must match dot-prefixed files
// (e.g. ".env", ".build.ae") while still skipping dot-prefixed directories
// (".git", ".aeb") from recursion.
//
// Before the fs_glob fix, walk_recursive skipped every directory entry whose
// name began with '.', so patterns like "**/.build.ae" or "**/.*.ae"
// always returned zero results.
//
// We build a tiny fixture tree under build/test_glob_dotfiles/ at runtime,
// run several glob patterns against it, and clean up, all through std.fs's
// public functions (#3166).

import std.fs

extern exit(code: int)

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

// Create a directory and its parents.
make_dir(path: string) {
    err = fs.mkdir_p(path)
    if err != "" {
        fail("cannot create ${path}: ${err}")
    }
}

// Create an empty file.
touch(path: string) {
    err = fs.write(path, "")
    if err != "" {
        fail("cannot create ${path}: ${err}")
    }
}

// How many paths `pattern` matches.
matches(pattern: string) -> int {
    list, err = fs.glob(pattern)
    if err != "" {
        fail("glob ${pattern}: ${err}")
    }
    n = fs.dir_list_count(list)
    fs.dir_list_free(list)
    return n
}

main() {
    // Build the fixture tree.
    make_dir("build/test_glob_dotfiles/sub/sub2")
    make_dir("build/test_glob_dotfiles/.hidden_dir")
    touch("build/test_glob_dotfiles/.dotfile.cfg")
    touch("build/test_glob_dotfiles/sub/.build.ae")
    touch("build/test_glob_dotfiles/sub/sub2/.tests.ae")
    touch("build/test_glob_dotfiles/sub/plain_sentinel")
    touch("build/test_glob_dotfiles/.hidden_dir/should_not_appear")

    // Recursive match against any dot-prefixed .ae file (this used to return 0).
    n1 = matches("build/test_glob_dotfiles/**/.*.ae")
    if n1 < 2 {
        fail("recursive .*.ae matched only ${n1} files (expected >= 2)")
    }

    // Specific dot-prefixed file under a specific subtree.
    if matches("build/test_glob_dotfiles/**/.build.ae") != 1 {
        fail(".build.ae match count != 1")
    }

    // Dot-prefixed directories must NOT be recursed into. The file at
    // .hidden_dir/should_not_appear should never show up.
    if matches("build/test_glob_dotfiles/**/should_not_appear") != 0 {
        fail("should_not_appear was visited under a hidden dir")
    }

    // Non-dot pattern still works (sanity).
    if matches("build/test_glob_dotfiles/**/plain_sentinel") != 1 {
        fail("plain_sentinel match count != 1")
    }

    // Clean up the fixture tree (files first, then dirs bottom-up).
    _ = fs.delete("build/test_glob_dotfiles/.dotfile.cfg")
    _ = fs.delete("build/test_glob_dotfiles/sub/.build.ae")
    _ = fs.delete("build/test_glob_dotfiles/sub/sub2/.tests.ae")
    _ = fs.delete("build/test_glob_dotfiles/sub/plain_sentinel")
    _ = fs.delete("build/test_glob_dotfiles/.hidden_dir/should_not_appear")
    _ = fs.delete_dir("build/test_glob_dotfiles/sub/sub2")
    _ = fs.delete_dir("build/test_glob_dotfiles/sub")
    _ = fs.delete_dir("build/test_glob_dotfiles/.hidden_dir")
    _ = fs.delete_dir("build/test_glob_dotfiles")
    println("PASS glob dotfiles")
}
