// Test: the filesystem bundle, fs.mkdir_p, fs.symlink, fs.readlink,
// fs.is_symlink and fs.unlink, through std.fs's public functions (#3166).
// Builds a small fixture tree at runtime under build/test_fs_bundle/,
// exercises each function, then cleans up.
//
// Windows note: creating a symlink there needs a privilege a CI runner may
// lack, so the symlink sub-cases are skipped on Windows; mkdir_p and unlink
// are checked everywhere.

import std.fs
import std.os

extern exit(code: int)

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

main() {
    is_windows = os.platform() == "windows"

    // Clean slate (MSYS2 on Windows provides rm)
    _rm = os.system("rm -rf build/test_fs_bundle")

    // 1. fs.mkdir_p: nested directories created in one call
    err = fs.mkdir_p("build/test_fs_bundle/a/b/c")
    if err != "" {
        fail("fs.mkdir_p should create nested dirs: ${err}")
    }
    if fs.dir_exists("build/test_fs_bundle/a/b/c") != 1 {
        fail("nested dir not actually created")
    }

    // 2. fs.mkdir_p: idempotent, re-creating an existing tree succeeds
    err = fs.mkdir_p("build/test_fs_bundle/a/b/c")
    if err != "" {
        fail("fs.mkdir_p should be idempotent: ${err}")
    }

    // 3. fs.mkdir_p: also works for a single new dir
    err = fs.mkdir_p("build/test_fs_bundle/single")
    if err != "" {
        fail("fs.mkdir_p should create a single dir: ${err}")
    }
    if fs.dir_exists("build/test_fs_bundle/single") != 1 {
        fail("single dir not created")
    }

    // A real file to unlink later (and to symlink to, on POSIX)
    _echo = os.system("echo target-content > build/test_fs_bundle/a/target.txt")

    if !is_windows {
        // ---- POSIX-only symlink sub-cases (4 through 10) ----
        // 4. fs.symlink: create a symlink pointing at the file
        err = fs.symlink("../a/target.txt", "build/test_fs_bundle/single/link.txt")
        if err != "" {
            fail("fs.symlink should succeed: ${err}")
        }

        // 5. fs.is_symlink: the link is itself a symlink
        if fs.is_symlink("build/test_fs_bundle/single/link.txt") != 1 {
            fail("fs.is_symlink should return 1 for a real symlink")
        }

        // 6. fs.is_symlink: the target file is not a symlink
        if fs.is_symlink("build/test_fs_bundle/a/target.txt") != 0 {
            fail("fs.is_symlink should return 0 for a regular file")
        }

        // 7. fs.is_symlink: a missing path is not one either
        if fs.is_symlink("build/test_fs_bundle/does/not/exist") != 0 {
            fail("fs.is_symlink should return 0 for a missing path")
        }

        // 8. fs.readlink: round-trip the target given to fs.symlink
        target, rerr = fs.readlink("build/test_fs_bundle/single/link.txt")
        if rerr != "" || target != "../a/target.txt" {
            fail("fs.readlink target mismatch: '${target}' (${rerr})")
        }

        // 9. fs.readlink on a regular file is an error
        _not_link, nerr = fs.readlink("build/test_fs_bundle/a/target.txt")
        if nerr == "" {
            fail("fs.readlink on a regular file should be an error")
        }

        // 10. fs.unlink: remove the symlink (the target file stays)
        err = fs.unlink("build/test_fs_bundle/single/link.txt")
        if err != "" {
            fail("fs.unlink should remove the symlink: ${err}")
        }
        if fs.is_symlink("build/test_fs_bundle/single/link.txt") != 0 {
            fail("symlink should be gone after fs.unlink")
        }
        if fs.file_exists("build/test_fs_bundle/a/target.txt") != 1 {
            fail("fs.unlink on the symlink should NOT have removed the target")
        }
    } else {
        println("SKIP: symlink sub-cases (Windows: creating a symlink needs a privilege)")
    }

    // ---- Non-symlink sub-cases (11 through 13), on every platform ----

    // 11. fs.unlink: remove a regular file
    err = fs.unlink("build/test_fs_bundle/a/target.txt")
    if err != "" {
        fail("fs.unlink should remove a regular file: ${err}")
    }
    if fs.file_exists("build/test_fs_bundle/a/target.txt") != 0 {
        fail("file should be gone after fs.unlink")
    }

    // 12. fs.unlink refuses to remove a directory
    if fs.unlink("build/test_fs_bundle/a") == "" {
        fail("fs.unlink should refuse to remove a directory")
    }
    if fs.dir_exists("build/test_fs_bundle/a") != 1 {
        fail("directory should still exist after fs.unlink refused")
    }

    // 13. fs.unlink of a missing path is an error
    if fs.unlink("build/test_fs_bundle/never/existed") == "" {
        fail("fs.unlink on a missing path should be an error")
    }

    // Cleanup
    _clean = os.system("rm -rf build/test_fs_bundle")

    println("PASS fs stdlib bundle")
}
