// Test: fs.glob_multi, a glob over a list of patterns, through std.fs's
// public function (#3166). Each check fails the test; it used to print a
// line on success and exit 0 either way.

import std.fs
import std.list
import std.string

extern exit(code: int)

check(ok: bool, what: string) {
    if !ok {
        println("FAIL: ${what}")
        exit(1)
    }
}

main() {
    // Multi-pattern: both test_glob*.ae and test_args*.ae
    patterns = list.new()
    _a1 = list.add(patterns, "tests/syntax/test_glob*.ae")
    _a2 = list.add(patterns, "tests/syntax/test_args*.ae")

    results, err = fs.glob_multi(patterns)
    check(err == "", "a multi-pattern glob runs: ${err}")
    count = fs.dir_list_count(results)
    check(count >= 2, "a multi-pattern glob finds files")

    // Both patterns contributed
    found_glob = 0
    found_args = 0
    i = 0
    while i < count {
        path = fs.dir_list_get(results, i)
        if string.contains(path, "test_glob") == 1 {
            found_glob = 1
        }
        if string.contains(path, "test_args") == 1 {
            found_args = 1
        }
        i = i + 1
    }
    check(found_glob == 1, "the glob pattern matched")
    check(found_args == 1, "the args pattern matched")
    fs.dir_list_free(results)
    list.free(patterns)

    // A single pattern in the list, the same as fs.glob
    single = list.new()
    _a3 = list.add(single, "tests/syntax/test_glob_multi.ae")
    single_results, serr = fs.glob_multi(single)
    check(serr == "" && fs.dir_list_count(single_results) == 1, "a single pattern works")
    fs.dir_list_free(single_results)
    list.free(single)

    // An empty list of patterns matches nothing
    empty_patterns = list.new()
    empty_results, eerr = fs.glob_multi(empty_patterns)
    check(eerr == "" && fs.dir_list_count(empty_results) == 0, "no patterns match nothing")
    fs.dir_list_free(empty_results)
    list.free(empty_patterns)

    // A null list is an error
    _none, nerr = fs.glob_multi(null)
    check(nerr != "", "a null list is an error")

    println("glob_multi ok")
}
