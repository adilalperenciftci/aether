// Every .ae file under std and contrib type-checks without a warning.
//
// A warning there is a value nobody reads (W1001: often a test's error
// result that was never checked), code that never runs (W1002), an arm
// that never matches (W1004), or a call that names its module twice
// (W1006, `fs.fs_is_symlink`). std and contrib carried 36 of them before
// this gate (#3176), several an unchecked error in a test.
//
// This runs `<ae> check` on each file, --jobs of them at a time, and
// reports every warning it prints (`warning[...]:`, or `warning:` for the
// uncoded ones), with the file, and each file that does not type-check at
// all: its errors stop the check before the warnings are found. The
// examples have a gate of their own (tests/examples/check.ae), which builds
// each one warning-free.
//
//     check AE [--jobs N] [--expect N] DIR...
//
// Exits 1 on a warning or a file that does not check; with --expect, unless
// exactly N such findings were made (the self-test over
// tests/warnings/fixture). `make check-warnings` runs both.

import std.fs
import std.os
import std.io
import std.list
import std.mem
import std.string
import std.collections

extern exit(code: int)

say(s: string) {
    _w = io.stdout_write("${s}\n")
}

last_index_of_char(s: string, c: int) -> int {
    n = string.length(s)
    i = n - 1
    while i >= 0 {
        if string.char_at_n(s, n, i) == c {
            return i
        }
        i = i - 1
    }
    return -1
}

// The warnings `ae check` reports for `path`, one per line of `out`.
report(path: string, out: string) -> int {
    found = 0
    n = string.length(out)
    start = 0
    while start < n {
        cut = string.index_of_from(out, "\n", start)
        stop = cut
        if cut < 0 {
            stop = n
        }
        line = string.trim(string.substring(out, start, stop))
        // Coded (`warning[W1001]:`) or not (`warning: ...`, the C-shaped
        // ones such as a malloc sized by a literal).
        if string.starts_with(line, "warning[") == 1 || string.starts_with(line, "warning:") == 1 {
            say("${path}: ${line}")
            found = found + 1
        }
        start = stop + 1
    }
    return found
}

main() {
    argc = os.args_count()
    if argc < 3 {
        say("usage: check AE [--expect N] DIR...")
        exit(2)
    }
    ae = os.args_get(1)
    expect = -1
    jobs = 1
    dirs = collections.string_list_new()
    i = 2
    while i < argc {
        a = os.args_get(i)
        if a == "--expect" && i + 1 < argc {
            i = i + 1
            expect = string.get_int(os.args_get(i))
        } else if a == "--jobs" && i + 1 < argc {
            i = i + 1
            jobs = string.get_int(os.args_get(i))
            if jobs < 1 {
                jobs = 1
            }
        } else {
            collections.string_list_add(dirs, string.replace_all(a, "\\", "/"))
        }
        i = i + 1
    }

    files = collections.string_list_new()
    nd = collections.string_list_size(dirs)
    i = 0
    while i < nd {
        root = collections.string_list_get(dirs, i)
        _n, werr = fs.walk(root) | path: string, kind: int, depth: int | {
            p = string.replace_all(path, "\\", "/")
            verdict = 0
            if kind == 2 {
                base = p
                slash = last_index_of_char(p, 47)
                if slash >= 0 {
                    base = string.substring(p, slash + 1, string.length(p))
                }
                if base == "build" || base == ".git" || base == "target" || base == "node_modules" {
                    verdict = 1
                }
            } else if kind == 1 && string.ends_with(p, ".ae") == 1 {
                collections.string_list_add(files, p)
            }
            return verdict
        }
        if werr != "" {
            say("warnings: cannot walk ${root}: ${werr}")
            exit(2)
        }
        i = i + 1
    }

    // The checks, `jobs` at a time, each one's output (stdout and stderr,
    // where the diagnostics go) in a file of its own, read in file order
    // once all have finished: the report reads the same however the checks
    // interleave. One at a time this took 22 s of every CI leg.
    nf = collections.string_list_size(files)
    out_dir = "build/warnings/out"
    _rt = fs.remove_tree(out_dir)
    _md = fs.mkdir_p(out_dir)
    codes = list.new()
    i = 0
    while i < nf {
        _c = list.add(codes, mem.long_to_ptr(-1 as long))
        i = i + 1
    }
    live_tok = list.new()
    live_idx = list.new()
    next = 0
    while next < nf || list.size(live_tok) > 0 {
        while next < nf && list.size(live_tok) < jobs {
            argv = list.new()
            _a1 = list.add(argv, "check")
            _a2 = list.add(argv, collections.string_list_get(files, next))
            tok, serr = os.spawn_proc_to(ae, argv, null, "${out_dir}/${next}.txt")
            list.free(argv)
            if serr != "" {
                say("warnings: cannot run ${ae} check: ${serr}")
                exit(2)
            }
            _t = list.add(live_tok, mem.long_to_ptr(tok as long))
            _x = list.add(live_idx, mem.long_to_ptr(next as long))
            next = next + 1
        }
        done, code, werr = os.wait_any(live_tok)
        if werr != "" {
            code = -1
        }
        k = 0
        while k < list.size(live_tok) {
            if mem.ptr_to_long(list.at(live_tok, k)) as int == done {
                list.set(codes, mem.ptr_to_long(list.at(live_idx, k)) as int, mem.long_to_ptr(code as long))
                list.remove(live_tok, k)
                list.remove(live_idx, k)
                break
            }
            k = k + 1
        }
    }

    found = 0
    failed = 0
    i = 0
    while i < nf {
        p = collections.string_list_get(files, i)
        out, _rerr = fs.read("${out_dir}/${i}.txt")
        found = found + report(p, out)
        // A file that does not type-check has its warnings unreported, and
        // passed the gate: the exit status was not read.
        code = mem.ptr_to_long(list.at(codes, i)) as int
        if code != 0 {
            say("${p}: ${ae} check failed (exit ${code}):")
            say(out)
            failed = failed + 1
        }
        i = i + 1
    }
    list.free(live_tok)
    list.free(live_idx)
    list.free(codes)

    say("warnings: ${nf} Aether files, ${found} warning(s), ${failed} that do not type-check")
    found = found + failed
    if expect >= 0 {
        if found != expect {
            say("warnings: the self-test expected ${expect}")
            exit(1)
        }
        exit(0)
    }
    if found > 0 {
        exit(1)
    }
}
