import views

var log: int[] = []
var rows: int[][] = []

main() {
    // An imported module's own globals, pushed from its functions.
    root = views.add(1, 0)
    _a = views.add(2, root)
    _b = views.add(3, root)
    println("${views.count()} ${views.kids_of(root)}")   // 3 2

    // This module's globals, pushed with values a call makes: the call
    // may write them, and the push still grows the global itself.
    log.push(7)
    rows.push(make([]int, 0))
    rows[0].push(log.len)
    rows.push(make([]int, 0))
    println("${log.len} ${rows.len} ${rows[0].len}")     // 1 2 1
}
