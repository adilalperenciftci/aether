// Certificate signatures beyond SHA-256 RSA and P-256/P-384 ECDSA (#3307).
//
// tls13_cert verified a certificate's signature only for
// sha256WithRSAEncryption, ecdsa-with-SHA256 on a P-256 key and
// ecdsa-with-SHA384 on a P-384 key. Any other chain did not verify, so the
// pure TLS client refused real sites whose CAs sign with
// sha384WithRSAEncryption (www.bing.com, www.microsoft.com: Microsoft's and
// many DigiCert chains), and every chain through a P-521 or Ed25519 CA.
// Each chain below failed before the fix ("certificate does not chain to a
// trusted anchor") and verifies now, and the same chain with one bit of the
// leaf's signature flipped is refused.
//
// Fixtures, made once with openssl (`x509 -req -extfile`, valid 2026-01-01
// to 2126-01-01), all under one P-256 root:
//   rsaca     RSA-3072 CA, signed ecdsa-with-SHA384 by the P-256 root (a hash
//             longer than the curve); rsaleaf under it, sha384WithRSAEncryption
//   p521ca    P-521 CA; p521leaf under it, ecdsa-with-SHA512
//   edca      Ed25519 CA; edleaf under it, Ed25519

import std.list
import std.bytes
import std.string
import std.cryptography.tls13_cert

extern exit(code: int)

