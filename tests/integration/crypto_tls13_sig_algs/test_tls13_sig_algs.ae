fn certs(pem: string) -> ptr {
    l = list_new()
    tls13_cert.trust_store_add_pem(l, pem)
    return l
}

// validate_chain(leaf, [ca], [root]) for a server in 2027, with the last
// byte of the leaf's signature flipped when `tamper` is 1.
fn chain_result(leaf_pem: string, ca_pem: string, tamper: int) -> string {
    anchors = certs(pem_root())
    inters = certs(ca_pem)
    leaves = certs(leaf_pem)
    r = "the leaf fixture does not parse"
    if list_size(leaves) == 1 {
        leaf = list.at(leaves, 0) as *LeafCert
        if tamper == 1 {
            k = leaf.signature_len - 1
            bytes.set(leaf.signature, k, (bytes.get(leaf.signature, k) ^ 1) & 0xFF)
        }
        r = tls13_cert.validate_chain(leaf, inters, anchors, "20270101000000", tls13_cert.PURPOSE_SERVER, -1)
    }
    tls13_cert.free_anchors(anchors)
    tls13_cert.free_anchors(inters)
    tls13_cert.free_anchors(leaves)
    return r
}

// 0 when the chain verifies and its tampered copy does not, else 1.
fn check(label: string, leaf_pem: string, ca_pem: string) -> int {
    fails = 0
    good = chain_result(leaf_pem, ca_pem, 0)
    if string.equals(good, "") == 1 {
        println("ok   ${label}")
    } else {
        println("FAIL ${label}: refused (${good})")
        fails = 1
    }
    bad = chain_result(leaf_pem, ca_pem, 1)
    if string.equals(bad, "") != 1 {
        println("ok   ${label}, tampered: refused")
    } else {
        println("FAIL ${label}, tampered: accepted")
        fails = 1
    }
    return fails
}

main() {
    fails = 0
    fails = fails + check("sha384WithRSAEncryption (RSA-3072 CA under ecdsa-with-SHA384 on P-256)", pem_rsaleaf(), pem_rsaca())
    fails = fails + check("ecdsa-with-SHA512 on a P-521 CA", pem_p521leaf(), pem_p521ca())
    fails = fails + check("Ed25519 CA", pem_edleaf(), pem_edca())
    if fails > 0 {
        println("tls13_sig_algs: ${fails} FAILURES")
        exit(1)
    }
    println("tls13_sig_algs: all checks pass")
}
