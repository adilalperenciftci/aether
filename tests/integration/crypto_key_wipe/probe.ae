fn ec_pkcs8() -> string {
    return "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQghIAOPUifKACigpl/\nNRf9RM2OLDXA71E78lbJeL1jiW6hRANCAAQZrgzufBOfDgjViwVGF5QzJP9ccZVG\nPYKipK50RAfyjExBX8EIpl0x1E4NZw+XjbUElSo0kK4SrIqqNssyyYFi\n-----END PRIVATE KEY-----\n"
}

