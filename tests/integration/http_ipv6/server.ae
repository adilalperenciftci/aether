// The server half of test_http_ipv6.sh: binds BIND_HOST ("::1", "::" or
// "localhost"; anything else is 127.0.0.1) on an ephemeral port,
// optionally over TLS (CERT_PATH and KEY_PATH; AETHER_PURE_TLS=1 selects the
// pure-Aether server), prints "READY <port>", and answers every GET with the
// peer address it saw, so the runner can tell an IPv4 client of a "::"
// listener from an IPv6 one. Prints "BIND FAILED" and exits 3 when the
// address can't be bound (no IPv6 on this host).

import std.http
import std.os
import std.cryptography.tls13_server

extern exit(code: int)

handle_root(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "ipv6-ok peer=${http.request_remote_addr(req)}")
}

message StartSrv { raw: ptr }

actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; _ = http.server_start(raw) } }
}

main() {
    host = os.getenv("BIND_HOST")
    raw = http.server_create(0)
    if raw == 0 {
        println("FAIL: server_create returned null")
        exit(1)
    }
    cert = os.getenv("CERT_PATH")
    if cert != "" {
        tls_err = http.server_set_tls(raw, cert, os.getenv("KEY_PATH"))
        if tls_err != "" {
            println("FAIL: server_set_tls: ${tls_err}")
            exit(1)
        }
    }
    berr = ""
    match host {
        "::1" -> {
            http.server_set_host(raw, "::1")
            berr = http.server_bind(raw, "::1", 0)
        }
        "localhost" -> {
            // loopback-ok: "localhost" is the case under test (it must still bind 127.0.0.1 only)
            http.server_set_host(raw, "localhost")
            // loopback-ok: as above
            berr = http.server_bind(raw, "localhost", 0)
        }
        "::" -> {
            // loopback-ok: dual-stack needs the wildcard; the runner skips this case on Windows
            http.server_set_host(raw, "::")
            // loopback-ok: as above
            berr = http.server_bind(raw, "::", 0)
        }
        _ -> {
            http.server_set_host(raw, "127.0.0.1")
            berr = http.server_bind(raw, "127.0.0.1", 0)
        }
    }
    if berr != "" {
        println("BIND FAILED")
        exit(3)
    }
    println("READY ${http.server_port(raw)}")
    http.server_get(raw, "/", handle_root, 0)
    a = spawn(SrvActor())
    a ! StartSrv { raw: raw }
    sleep(60000)
    exit(0)
}
