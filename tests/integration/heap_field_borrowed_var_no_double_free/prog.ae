// A string struct field stored from a local frees, at the struct's destroy,
// exactly the reference the field holds: never a value the program does not
// own, never one left to nobody.
//
// `passthru` returns its parameter, a literal here: the field holds the
// pinned literal, which a release leaves alone. Freeing it as an owned buffer
// (a free of rodata) aborted at teardown; that is the FFI/closure-callback
// shape a downstream HTML sanitizer hit, a hook returning a literal threaded
// through `-> string` helpers into a heap-boxed attr. `runtime_owned` is
// built through a call the constant folder cannot see through (string.concat
// of two literals folds to a literal), so it is a fresh string: left to
// nobody, it leaked (std.message leaked 60 allocations this way).
//
// The heap check runs where the count is exact (mem.heap_in_use_exact): after
// a warm-up, some window of the same work grows by exactly 0.

import std.mem
import std.string
import std.strbuilder

extern exit(code: int)

struct Attr {
    name: string
    value: string
}

fn passthru(u: string) -> string {
    return u
}

fn build_owned(n: int) -> string {
    b = strbuilder.new(16)
    strbuilder.append(b, "https://cdn.example/")
    strbuilder.append_int(b, n)
    return strbuilder.finish(b)
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

fn round(n: int) {
    a = heap.new(Attr)
    a.name = "src"
    borrowed = passthru("https://cdn.example/logo.png")
    ap = a as *Attr
    ap.value = borrowed
    check(a.value == "https://cdn.example/logo.png", "the borrowed value reads back")
    heap.free(a)

    b = heap.new(Attr)
    b.name = "href"
    owned = string.concat("https://", "cdn.example/style.css")
    bp = b as *Attr
    bp.value = owned
    check(b.value == "https://cdn.example/style.css", "the folded value reads back")
    heap.free(b)

    c = heap.new(Attr)
    c.name = "src"
    runtime_owned = build_owned(n)
    cp = c as *Attr
    cp.value = runtime_owned
    check(c.value == "https://cdn.example/${n}", "the fresh value reads back")
    heap.free(c)
}

main() {
    round(7)
    if mem.heap_in_use_exact() {
        grown = mem.steady_growth(|| {
                k = 0
                while k < 200 {
                    round(k % 10)
                    k = k + 1
                }
            }, 5)
        if grown != 0 {
            println("FAIL: a window of 200 rounds grew the heap by ${grown} bytes in every run")
            exit(1)
        }
    }
    println("done")
}
