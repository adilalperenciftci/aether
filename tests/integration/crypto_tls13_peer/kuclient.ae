// The pure TLS client updating its own keys (#3320): connect_socket to
// 127.0.0.1 PEER_PORT for "peer.example", trusting CAFILE, then
// conn_key_update(CLIENT_KU), then two bytes of data under the new keys.
// Prints "OK", "KUERR: <why>" or "ERR: <why>".

import std.os
import std.tcp
import std.bytes
import std.string
import std.cryptography.tls13_client

main() {
    port, _perr = string.to_int(os.getenv("PEER_PORT"))
    sock, derr = tcp.connect("127.0.0.1", port)
    if derr != "" {
        println("ERR: connect: ${derr}")
        return
    }
    conn, herr = tls13_client.connect_socket(sock, "peer.example", os.getenv("CAFILE"))
    if herr != "" {
        println("ERR: ${herr}")
        return
    }
    req, _rerr = string.to_int(os.getenv("CLIENT_KU"))
    kerr = tls13_client.conn_key_update(conn, req)
    if kerr != "" {
        println("KUERR: ${kerr}")
    } else {
        hi = bytes.new(2)
        bytes.set(hi, 0, 104)
        bytes.set(hi, 1, 105)
        serr = tls13_client.conn_send(conn, bytes.view(hi)[0..2])
        bytes.free(hi)
        if serr != "" { println("SENDERR: ${serr}") } else { println("OK") }
    }
    tls13_client.close_conn(conn)
}
