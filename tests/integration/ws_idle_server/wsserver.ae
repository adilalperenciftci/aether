// The echo server for ws_idle_server: a 1 s idle timeout, which guards the
// wait for the next HTTP request and must not reach an upgraded WebSocket.

import std.http

extern exit(code: int)

@c_callback echo_handler(req: ptr, ws: ptr, ud: ptr) {
    n = 0
    done = 0
    while n < 2 && done == 0 {
        if http.ws_recv(ws) == -1 {
            println("server: closed")
            done = 1
        } else {
            http.ws_send_text(ws, "echo: ${http.ws_message(ws)}")
            n = n + 1
        }
    }
}

message StartSrv { raw: ptr }
actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; _ = http.server_start(raw) } }
}

main() {
    raw = http.server_create(0)
    if raw == 0 { println("FAIL: server_create"); exit(1) }
    http.server_set_host(raw, "127.0.0.1")
    kerr = http.server_set_keepalive(raw, 1, 0, 1000ms)
    if kerr != "" { println("FAIL: server_set_keepalive: ${kerr}"); exit(1) }
    http.server_websocket(raw, "/echo", echo_handler, null)
    if http.server_bind(raw, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    println("READY ${http.server_port(raw)}")

    a = spawn(SrvActor())
    a ! StartSrv { raw: raw }

    sleep(30000)
    exit(0)
}
