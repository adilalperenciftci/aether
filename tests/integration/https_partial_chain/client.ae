// An https GET through std.http.client for test_https_partial_chain.sh
// (#3311).
//
//   URL       the https URL to GET
//   CAFILE    the CA file to pin (set_cafile)
//   PARTIAL   "1" to trust partial chains (set_partial_chain)
//   BACKEND   "aether" or "openssl"
//
// Prints "BACKEND-ERR: <error>" when set_tls_backend refuses, else
// "STATUS <code>" or "ERR: <error>".

import std.http.client
import std.cryptography.tls13_client
import std.os

main() {
    req = client.request("GET", os.getenv("URL"))
    client.set_timeout(req, 10s)
    client.set_cafile(req, os.getenv("CAFILE"))
    if os.getenv("PARTIAL") == "1" {
        client.set_partial_chain(req, 1)
    }
    berr = client.set_tls_backend(req, os.getenv("BACKEND"))
    if berr != "" {
        println("BACKEND-ERR: ${berr}")
        client.request_free(req)
        return
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        println("ERR: ${err}")
        return
    }
    println("STATUS ${client.response_status(resp)}")
    client.response_free(resp)
}
