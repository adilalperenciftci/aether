// Regression: a closure passed to an `extern` that keeps it (a callback
// registry: registered now, called later from C) must stay alive. An
// extern lends its arguments unless it declares the parameter `@retain`
// (R4); then the call hands it a reference of its own, and the caller's
// release after the call leaves the closure to C.

extern register_cb(boxed: @retain fn)
extern fire_cb()

main() {
    msg = "captured"
    register_cb(|| { println(msg) }) // closure captures msg → heap env
    fire_cb() // pre-fix: reads freed env (UAF)
    return 0
}
