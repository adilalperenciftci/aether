// A foreground server (http.server_start) and its monitor (#3131), by mode:
//
//   default  no monitor chosen: the console monitor prints the banner
//   null     null_monitor: nothing is printed
//   own      the program's monitor replaces the banner
//
// The monitor is what is under test, so the server is not stopped from it: a
// client actor asks /stop, which only a serving server answers, and the
// handler stops the server, so server_start returns. The driving shell test
// reads stdout.

import std.http
import std.os

extern http_server_bind_raw(server: ptr, host: string, port: int) -> int
extern http_server_port(server: ptr) -> int
extern sleep(ms: int)
extern exit(code: int)

stop_handler(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "stopping")
    http.server_stop(ud)
}

message AskStop { port: int }
actor Stopper {
    state asked = 0
    receive {
        AskStop(port) -> {
            tries = 0
            done = 0
            while done == 0 && tries < 250 {
                body, err = http.get("http://127.0.0.1:${port}/stop")
                if err == "" { done = 1 } else {
                    sleep(20)
                    tries = tries + 1
                }
            }
            asked = done
        }
    }
}

main() {
    mode = os.getenv("MONITOR_MODE")
    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    http.server_get(s, "/stop", stop_handler, s)
    match mode {
        "null" -> { http.null_monitor(s) }
        "own" -> {
            http.monitor(s) {
                listening() | host: string, port: int | { println("OWN listening on ${host}") }
                stopped() | host: string, port: int | { println("OWN stopped") }
            }
        }
        _ -> {}
    }
    if http_server_bind_raw(s, "127.0.0.1", 0) < 0 { println("FAIL bind"); exit(1) }
    stopper = spawn(Stopper())
    stopper ! AskStop { port: http_server_port(s) }
    err = http.server_start(s)
    if err != "" { println("FAIL start: ${err}"); exit(1) }
    http.server_free(s)
    println("FG-DONE")
}
