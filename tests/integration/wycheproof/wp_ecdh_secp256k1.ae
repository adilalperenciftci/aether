// Wycheproof adversarial vectors: ECDH over secp256k1, keys as JSON Web
// Keys (EcdhWebcryptoTest; Wycheproof has no bare-point file for this
// curve), #3291.
//
// Each case gives the private JWK ("d"), the peer's public JWK ("crv", "x",
// "y", base64url) and the expected shared x-coordinate:
//   "valid"   -> ecdh MUST return the shared secret.
//   "invalid" -> refused: points off the curve (the invalid-curve attack),
//                (0, 0), and keys of another curve.
// A key whose "crv" is not P-256K, or whose coordinates are not 32 bytes,
// is refused here, as a caller reading JWKs refuses it: the curve name is
// the caller's to check, and the point is secp256k1.ecdh's.

import std.cryptography.secp256k1
import std.fs
import std.json
import std.bytes
import std.string

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn b64v(c: int) -> int {
    if c >= 65 && c <= 90 { return c - 65 }
    if c >= 97 && c <= 122 { return c - 71 }
    if c >= 48 && c <= 57 { return c + 4 }
    if c == 45 { return 62 }
    if c == 95 { return 63 }
    return -1
}

// base64url without padding, or null on a bad character.
fn b64url(s: string) -> ptr {
    n = string_length(s)
    out = bytes.new(n)
    acc = 0
    bits = 0
    o = 0
    i = 0
    while i < n {
        v = b64v(string_char_at_n(s, n, i))
        if v < 0 {
            bytes.free(out)
            return null
        }
        acc = ((acc << 6) | v) & 0xFFFFFF
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            bytes.set(out, o, (acc >> bits) & 255)
            o = o + 1
        }
        i = i + 1
    }
    bytes.set_length(out, o)
    return out
}

fn to_hex(b: ptr) -> string {
    d = "0123456789abcdef"
    o = ""
    n = bytes.length(b)
    i = 0
    while i < n {
        v = bytes.get(b, i)
        o = string.concat(o, string.concat(string.substring(d, (v >> 4) & 15, ((v >> 4) & 15) + 1), string.substring(d, v & 15, (v & 15) + 1)))
        i = i + 1
    }
    return o
}

main() {
    doc, ferr = fs.read("tests/vectors/wycheproof/ecdh_secp256k1_webcrypto_test.json")
    if ferr != "" {
        println("FAIL: cannot read vector file: ${ferr}")
        exit(1)
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: vector JSON parse: ${jerr}")
        exit(1)
    }
    groups = json.object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)
    valid_ok = 0
    refused = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        tests = json.object_get_raw(g, "tests")
        nt = json.array_size(tests)
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.get_int(json.object_get_raw(t, "tcId"))
            res = json.get_string_raw(json.object_get_raw(t, "result"))
            pubj = json.object_get_raw(t, "public")
            privj = json.object_get_raw(t, "private")
            crv = json.get_string_raw(json.object_get_raw(pubj, "crv"))
            want = string.to_lower(json.get_string_raw(json.object_get_raw(t, "shared")))
            got = ""
            refused_here = 1
            x = b64url(json.get_string_raw(json.object_get_raw(pubj, "x")))
            y = b64url(json.get_string_raw(json.object_get_raw(pubj, "y")))
            d = b64url(json.get_string_raw(json.object_get_raw(privj, "d")))
            if crv == "P-256K" && x != null && y != null && d != null {
                if bytes.length(x) == 32 && bytes.length(y) == 32 && bytes.length(d) == 32 {
                    z = secp256k1.ecdh(d, x, y)
                    if z != null {
                        got = to_hex(z)
                        refused_here = 0
                        bytes.free(z)
                    }
                }
            }
            if x != null { bytes.free(x) }
            if y != null { bytes.free(y) }
            if d != null { bytes.free(d) }
            if res == "valid" {
                if refused_here == 0 && got == want {
                    valid_ok = valid_ok + 1
                } else {
                    println("FAIL tcId=${tc_id} (valid): got '${got}', want '${want}'")
                    failed = failed + 1
                }
            } else {
                if refused_here == 1 {
                    refused = refused + 1
                } else {
                    println("FAIL tcId=${tc_id} (${res}): ecdh ACCEPTED it, shared '${got}'")
                    failed = failed + 1
                }
            }
            ti = ti + 1
        }
        gi = gi + 1
    }
    println("wycheproof ecdh_secp256k1_webcrypto: ${valid_ok} valid ok, ${refused} invalid refused, ${failed} failed")
    if failed > 0 { exit(1) }
    println("ALL PASS")
}
