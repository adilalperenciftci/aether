// Wycheproof adversarial vectors — ECDSA P-521 / SHA-512, DER form (wave 5).
//
// The DER twin of wp_ecdsa_p521.ae. Measures the DER signature parser via
// the real tls13_cert.split_ecdsa_sig (coord width 66), then p521.ecdsa_verify.
//   "valid"   -> parse+verify MUST succeed (1).
//   "invalid" -> parse MUST error or verify MUST return 0.
// Every vector runs by default (a P-521 verify is a few milliseconds since
// #2600; it was about 60 ms on std.bignum, and seconds before #2595);
// WYCHEPROOF_STRIDE=N samples every Nth case instead.
//
// P-521 hash note: the curve order is 521 bits, SHA-512 only 512, and
// FIPS 186-5 uses the leftmost min(521, 512) bits of the digest: all of
// it. ecdsa_verify takes the 64-byte digest as it is (sha512_of below).

import std.cryptography.tls13_cert
import std.cryptography.p521
import std.cryptography.sha2
import std.os
import std.fs
import std.json
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern atoi(s: string) -> int
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(s, slen, i * 2))
        lo = hexval(string_char_at_n(s, slen, i * 2 + 1))
        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

fn coordn(hexs: string, width: int) -> ptr {
    raw = from_hex(hexs)
    n = string_length(hexs) / 2
    out = bytes.new(width)
    i = 0
    while i < width { bytes.set(out, i, 0) i = i + 1 }
    if n >= width {
        i = 0
        while i < width { bytes.set(out, i, bytes.get(raw, n - width + i)) i = i + 1 }
    } else {
        i = 0
        while i < n { bytes.set(out, width - n + i, bytes.get(raw, i)) i = i + 1 }
    }
    bytes.free(raw)
    return out
}

// The SHA-512 digest itself, 64 bytes: ecdsa_verify uses the leftmost 521
// bits of the digest it is given (FIPS 186-5), so a shorter digest is used
// whole. Zero-padding it to 66 bytes would make it a different number.
fn sha512_of(b: ptr, n: int) -> ptr {
    ctx, _e = sha2.new("sha512")
    sha2.update(ctx, bytes.view(b)[0..n])
    return sha2.final_bytes(ctx)
}

main() {
    stride = 1
    wf = os.getenv("WYCHEPROOF_FULL")
    if wf == "1" { stride = 1 }
    sv = os.getenv("WYCHEPROOF_STRIDE")
    if sv != "" { stride = atoi(sv) }
    if stride < 1 { stride = 1 }

    doc, ferr = fs.read("tests/vectors/wycheproof/ecdsa_secp521r1_sha512_test.json")
    if ferr != "" {
        println("FAIL: cannot read vector file: ${ferr}")
        exit(1)
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: vector JSON parse: ${jerr}")
        exit(1)
    }

    groups = json.object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)

    passed = 0
    rejected_invalid = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        pkobj = json.object_get_raw(g, "publicKey")
        wx = json.get_string_raw(json.object_get_raw(pkobj, "wx"))
        wy = json.get_string_raw(json.object_get_raw(pkobj, "wy"))
        pubx = coordn(wx, 66)
        puby = coordn(wy, 66)
        tests = json.object_get_raw(g, "tests")
        nt = json.array_size(tests)
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.get_int(json.object_get_raw(t, "tcId"))
            if (tc_id % stride) != 0 && stride > 1 {
                ti = ti + 1
                continue
            }
            res = json.get_string_raw(json.object_get_raw(t, "result"))
            msg_hex = json.get_string_raw(json.object_get_raw(t, "msg"))
            sig_hex = json.get_string_raw(json.object_get_raw(t, "sig"))

            msg = from_hex(msg_hex)
            h = sha512_of(msg, string_length(msg_hex) / 2)
            sig = from_hex(sig_hex)
            sig_len = string_length(sig_hex) / 2

            r66, s66, perr = tls13_cert.split_ecdsa_sig(bytes.view(sig)[0..sig_len], 66)
            ok = 0
            if r66 != null {
                ok = p521.ecdsa_verify(pubx, puby, h, r66, s66)
                bytes.free(r66)
                bytes.free(s66)
            }
            if res == "valid" {
                if ok == 1 { passed = passed + 1 } else {
                    println("FAIL tcId=${tc_id} (valid): rejected (parse: ${perr})")
                    failed = failed + 1
                }
            } else {
                if res == "invalid" {
                    if ok == 0 { rejected_invalid = rejected_invalid + 1 } else {
                        println("FAIL tcId=${tc_id} (invalid): ACCEPTED a forgery")
                        failed = failed + 1
                    }
                } else {
                    passed = passed + 1
                }
            }
            bytes.free(msg)
            bytes.free(h)
            bytes.free(sig)
            ti = ti + 1
        }
        bytes.free(pubx)
        bytes.free(puby)
        gi = gi + 1
    }

    println("wycheproof ecdsa_p521_der: ${passed} ok, ${rejected_invalid} invalid rejected, ${failed} failed (stride ${stride})")
    if failed > 0 { exit(1) }
    println("ALL PASS")
}
