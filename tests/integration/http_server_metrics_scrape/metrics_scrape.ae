// The /metrics scrape lists every series it counts (#3264), and the series a
// client can create are bounded (#3265).
//
// The scrape was written into a fixed 64 KB buffer and stopped where it
// filled, without a word: a series is about 1.3 KB of text, so past about
// fifty of them the rest were silently missing from every scrape. And the
// per-route counters were keyed by the literal method and path a client
// sent, one series each, without limit, in a list searched under one lock
// on every request: a client requesting fresh paths grew it, and slowed
// every request, for as long as it liked. Past 1024 series, requests now
// count in one series labelled "(other)", which is the same series a client
// sending that method and path itself counts in: it was a second series
// with the same labels, which a Prometheus scrape rejects (#3279).
//
// A request whose method and path are both "(other)", requests to distinct
// paths, then a scrape: the requests the scrape counts must add up to every
// request made, it may list no more than 1025 series, and none twice. The
// server listens on 127.0.0.1 and a port the kernel picks.

import std.http
import std.string
import std.tcp

extern exit(code: int)

handle_p(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "p")
}

// One response off `sock`, by its Content-Length: the whole of it.
read_response(sock: ptr) -> string {
    wire = ""
    want = -1
    quiet = 0
    while quiet < 20 && (want < 0 || string.length(wire) < want) {
        ready, _perr = tcp.poll(sock, 100)
        if ready {
            chunk, rerr = tcp.read(sock, 65536)
            if rerr != "" || string.length(chunk) == 0 {
                quiet = 20
            } else {
                wire = string.concat(wire, chunk)
                quiet = 0
                if want < 0 {
                    end = string.index_of(wire, "\r\n\r\n")
                    if end >= 0 {
                        at = string.index_of(wire, "Content-Length: ")
                        stop = string.index_of_from(wire, "\r\n", at)
                        want = end + 4 + string.get_int(string.substring(wire, at + 16, stop))
                    }
                }
            }
        } else {
            quiet = quiet + 1
        }
    }
    return wire
}

// `count` GETs to distinct paths starting at /x<from>, one at a time.
spray(sock: ptr, from: int, count: int) {
    i = 0
    while i < count {
        tcp.write(sock, "GET /x${from + i} HTTP/1.1\r\nHost: x\r\n\r\n")
        read_response(sock)
        i = i + 1
    }
}

// The scrape's request series: how many, then the requests they add up to.
series_and_total(scrape: string) -> (int, int) {
    series = 0
    total = 0
    marker = "\naether_http_requests_total{"
    at = string.index_of(scrape, marker)
    while at >= 0 {
        close = string.index_of_from(scrape, "} ", at)
        stop = string.index_of_from(scrape, "\n", close)
        total = total + string.get_int(string.substring(scrape, close + 2, stop))
        series = series + 1
        at = string.index_of_from(scrape, marker, stop)
    }
    return series, total
}

// How many times `needle` is in `hay`.
occurrences(hay: string, needle: string) -> int {
    n = 0
    at = string.index_of(hay, needle)
    while at >= 0 {
        n = n + 1
        at = string.index_of_from(hay, needle, at + 1)
    }
    return n
}

main() {
    println("=== the metrics scrape lists every series, and a client cannot grow them without end (#3264, #3265) ===")
    server = http.server_create(0)
    http.server_set_host(server, "127.0.0.1")
    http.server_get(server, "/p", handle_p, 0)
    merr = http.server_set_metrics(server, "/metrics")
    if merr != "" {
        println("FAIL: metrics: ${merr}")
        exit(1)
    }
    if http.server_bind(server, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    err = http.server_start_background(server)
    if err != "" {
        println("FAIL: ${err}")
        exit(1)
    }
    port = http.server_port(server)
    sleep(100)
    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        println("FAIL: connect")
        exit(1)
    }

    bad = 0
    // The overflow series' labels, sent by a client, on a connection of its
    // own: the server may close one whose request it refuses.
    odd, oerr = tcp.connect("127.0.0.1", port)
    if oerr != "" {
        println("FAIL: connect")
        exit(1)
    }
    tcp.write(odd, "(other) (other) HTTP/1.1\r\nHost: x\r\n\r\n")
    read_response(odd)
    tcp.close(odd)

    // 120 series: past what 64 KB of scrape held, well within the bound.
    spray(sock, 0, 120)
    tcp.write(sock, "GET /metrics HTTP/1.1\r\nHost: x\r\n\r\n")
    series, total = series_and_total(read_response(sock))
    if total != 121 {
        println("  FAIL the scrape counts every request: ${total} of 121 in ${series} series")
        bad = bad + 1
    } else {
        println("  PASS the scrape counts every request")
    }

    // 1500 more: past the bound. The scrape before this one is counted too.
    spray(sock, 120, 1500)
    tcp.write(sock, "GET /metrics HTTP/1.1\r\nHost: x\r\n\r\n")
    scrape = read_response(sock)
    series, total = series_and_total(scrape)
    if series > 1025 {
        println("  FAIL the series a client can create are bounded: ${series}")
        bad = bad + 1
    } else {
        println("  PASS the series a client can create are bounded")
    }
    if total != 1622 {
        println("  FAIL the bounded scrape still counts every request: ${total} of 1622")
        bad = bad + 1
    } else {
        println("  PASS the bounded scrape still counts every request")
    }
    others = occurrences(scrape, "aether_http_requests_total{method=\"(other)\",path=\"(other)\"}")
    if others != 1 {
        println("  FAIL no two series share labels: the (other) series is listed ${others} times")
        bad = bad + 1
    } else {
        println("  PASS no two series share labels")
    }

    tcp.close(sock)
    http.server_stop(server)
    if bad > 0 {
        println("FAIL: ${bad} case(s)")
        exit(1)
    }
    println("All PASS")
}
