// x509-limbo (C2SP/x509-limbo) against std.cryptography.tls13_cert's path
// and hostname validation (#1298).
//
// Every testcase of limbo.json is validated as the pure TLS client validates
// a server: the trusted certificates as anchors, the untrusted intermediates
// as the chain, the peer certificate as the leaf, at the case's validation
// time, for the case's purpose (SERVER or CLIENT), then the expected peer
// name. The result is compared with expected_result.
//
// The expected-results file lists every case that does not run or does not
// agree, one per line, with its reason:
//
//   <id> SKIP <reason>     not run (a feature this validator does not have)
//   <id> FAIL <reason>     runs, and the result differs from limbo's
//   <id> AGREE <reason>    runs and agrees with limbo, where OpenSSL does not
//                          (a note: checked as any case that is not listed)
//
// A mismatch not in the file fails the run, and so does a FAIL entry that
// now agrees (so the file stays exact). Lines starting with # are comments.
//
// Environment:
//   LIMBO_JSON       path to limbo.json (required)
//   LIMBO_EXPECTED   path to the expected-results file (required)
//   LIMBO_PREFIX     only the ids starting with this ("bettertls::" for the
//                    bettertls namespace, "" for all)
//   LIMBO_EXCLUDE    skip the ids starting with this
//   LIMBO_PRINT=1    print a "<id> FAIL <our reason>" line per disagreement,
//                    to seed the expected-results file
//
// Prints a summary line and "ALL PASS", or the unexpected cases and exits 1.
// run.sh fetches the pinned limbo.json and runs this, in the Linux CI job
// ci-crypto-ct.

import std.os
import std.fs
import std.json
import std.list
import std.map
import std.string
import std.cryptography.tls13_cert

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int

// "2024-01-01T00:00:00+00:00" (limbo writes UTC) -> "20240101000000".
fn time_key(t: string) -> string {
    n = string.length(t)
    out = ""
    i = 0
    count = 0
    while i < n && count < 14 {
        c = string_char_at_n(t, n, i)
        if c >= 48 && c <= 57 {
            out = "${out}${string.substring(t, i, i + 1)}"
            count = count + 1
        }
        i = i + 1
    }
    return out
}

// Parse every PEM certificate in the JSON array `arr` into a fresh list.
fn certs_of(arr: ptr) -> ptr {
    l = list_new()
    if arr == null { return l }
    n = json.array_size(arr)
    i = 0
    while i < n {
        pem = json.get_string_raw(json.array_get_raw(arr, i))
        tls13_cert.trust_store_add_pem(l, pem)
        i = i + 1
    }
    return l
}

fn json_list_has(arr: ptr, s: string) -> int {
    if arr == null { return 0 }
    n = json.array_size(arr)
    i = 0
    while i < n {
        if json.get_string_raw(json.array_get_raw(arr, i)) == s { return 1 }
        i = i + 1
    }
    return 0
}

// Our verdict for one testcase: "" (SUCCESS) or the reason for FAILURE.
fn validate_case(t: ptr) -> string {
    anchors = certs_of(json.object_get_raw(t, "trusted_certs"))
    inters = certs_of(json.object_get_raw(t, "untrusted_intermediates"))
    leaves = list_new()
    tls13_cert.trust_store_add_pem(leaves, json.get_string_raw(json.object_get_raw(t, "peer_certificate")))
    reason = ""
    if list_size(leaves) != 1 {
        reason = "the peer certificate does not parse"
    } else {
        leaf = list.at(leaves, 0) as *LeafCert
        at = ""
        vt = json.object_get_raw(t, "validation_time")
        if vt != null && json.is_null(vt) != 1 { at = time_key(json.get_string_raw(vt)) }
        purpose = tls13_cert.PURPOSE_SERVER
        if json.get_string_raw(json.object_get_raw(t, "validation_kind")) == "CLIENT" {
            purpose = tls13_cert.PURPOSE_CLIENT
        }
        depth = -1
        md = json.object_get_raw(t, "max_chain_depth")
        if md != null && json.is_null(md) != 1 { depth = json.get_int(md) }
        reason = tls13_cert.validate_chain(leaf, inters, anchors, at, purpose, depth)
        if reason == "" {
            // The leaf's keyUsage must allow what the case asks for.
            ku = json.object_get_raw(t, "key_usage")
            if json_list_has(ku, "digitalSignature") == 1 && (leaf.ext_bits & 8) != 0 && (leaf.key_usage & 1) == 0 {
                reason = "the leaf's keyUsage lacks digitalSignature"
            }
        }
        if reason == "" {
            pn = json.object_get_raw(t, "expected_peer_name")
            if pn != null && json.is_null(pn) != 1 {
                kind = json.get_string_raw(json.object_get_raw(pn, "kind"))
                value = json.get_string_raw(json.object_get_raw(pn, "value"))
                if kind == "DNS" || kind == "IP" {
                    reason = tls13_cert.check_hostname(leaf, value)
                } else {
                    reason = "peer name kind ${kind} is not supported"
                }
            }
        }
    }
    tls13_cert.free_anchors(anchors)
    tls13_cert.free_anchors(inters)
    tls13_cert.free_anchors(leaves)
    return reason
}

main() {
    doc, ferr = fs.read(os.getenv("LIMBO_JSON"))
    if ferr != "" {
        println("FAIL: cannot read LIMBO_JSON: ${ferr}")
        exit(1)
    }
    exp_text, eerr = fs.read(os.getenv("LIMBO_EXPECTED"))
    if eerr != "" {
        println("FAIL: cannot read LIMBO_EXPECTED: ${eerr}")
        exit(1)
    }
    prefix = os.getenv("LIMBO_PREFIX")
    exclude = os.getenv("LIMBO_EXCLUDE")
    print_mode = os.getenv("LIMBO_PRINT") == "1"

    // id -> "SKIP" / "FAIL" from the expected-results file.
    expected = map_new()
    lines = string.split(exp_text, "\n")
    nl = string.array_size(lines)
    li = 0
    while li < nl {
        line = string.trim(string.array_get(lines, li))
        if string.length(line) > 0 && string.starts_with(line, "#") != 1 {
            parts = string.split(line, " ")
            if string.array_size(parts) >= 2 {
                map_put_string_owned(expected, string.array_get(parts, 0), string.array_get(parts, 1))
            }
            string.array_free(parts)
        }
        li = li + 1
    }
    string.array_free(lines)

    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: limbo.json does not parse: ${jerr}")
        exit(1)
    }
    cases = json.object_get_raw(root, "testcases")
    n = json.array_size(cases)
    agree = 0
    skipped = 0
    known = 0
    bad = 0
    ran = 0
    i = 0
    while i < n {
        t = json.array_get_raw(cases, i)
        id = json.get_string_raw(json.object_get_raw(t, "id"))
        take = 1
        if prefix != "" && string.starts_with(id, prefix) != 1 { take = 0 }
        if exclude != "" && string.starts_with(id, exclude) == 1 { take = 0 }
        if take == 1 {
            mark, merr = map.get_string(expected, id)
            if merr != "" || mark == null { mark = "" }
            if mark == "SKIP" {
                skipped = skipped + 1
            } else {
                ran = ran + 1
                reason = validate_case(t)
                ours = "SUCCESS"
                if reason != "" { ours = "FAILURE" }
                want = json.get_string_raw(json.object_get_raw(t, "expected_result"))
                if ours == want {
                    if mark == "FAIL" {
                        println("NOW AGREES (remove from the expected file): ${id}")
                        bad = bad + 1
                    } else {
                        agree = agree + 1
                    }
                } else {
                    if mark == "FAIL" {
                        known = known + 1
                    } else {
                        bad = bad + 1
                        if print_mode {
                            if reason == "" { reason = "accepted" }
                            println("${id} FAIL ${reason}")
                        } else {
                            println("UNEXPECTED: ${id}: expected ${want}, got ${ours} (${reason})")
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    println("x509-limbo: ${ran} run, ${agree} agree, ${known} known disagreements, ${skipped} skipped, ${bad} unexpected")
    json.free(root)
    map_free(expected)
    if bad > 0 { exit(1) }
    println("ALL PASS")
}
