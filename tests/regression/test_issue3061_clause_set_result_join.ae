// #3061: a function written as several clauses is one C function, whose
// result was its first clause's with a known type, so a later clause's
// wider value was cut to it with no word: `pick(1, 7, 5000000000)` gave
// 705032704. The set's result is the join of every clause's now: a long
// with an int, a float or an f32 with an int, a uint32 with an int
// (tests/integration/clause_set_result_join checks two results no one type
// holds are refused).

extern exit(code: int)

struct P {
    small: int
    big: long
}

pick(0, s: int, b: long) -> s
pick(k, s: int, b: long) -> b

// Results inferred from what each clause returns through a pointer (#3056).
pick_p(p: *P, 0) -> p.small
pick_p(p: *P, k) -> p.big

mean(0, n: int, f: float) -> n
mean(k, n: int, f: float) -> f

// The join an if-expression's arms take: an f32 beside an int is an f32, a
// uint32 beside an int a uint32.
mean32(0, n: int, f: f32) -> n
mean32(k, n: int, f: f32) -> f

unsigned(0, n: int, x: uint32) -> n
unsigned(k, n: int, x: uint32) -> x

check(ok: bool, what: string) {
    if !ok {
        println("FAIL: ${what}")
        exit(1)
    }
}

main() {
    check(pick(1, 7, 5000000000) == 5000000000, "a later clause's long")
    check(pick(0, 7, 5000000000) == 7, "the first clause's int, widened")
    x = heap.new(P)
    x.small = 7
    x.big = 5000000000
    check(pick_p(x, 1) == 5000000000, "a long read through a pointer")
    check(pick_p(x, 0) == 7, "an int read through a pointer")
    heap.free(x)
    check(mean(1, 2, 2.5) == 2.5, "a later clause's float")
    check(mean(0, 2, 2.5) == 2.0, "the first clause's int, as a float")
    f32 h = 2.5
    check(mean32(1, 2, h) == 2.5, "a later clause's f32")
    uint32 u = 4000000000
    check("${unsigned(1, 2, u)}" == "4000000000", "a later clause's uint32")
    check(unsigned(0, 5, u) == 5, "the first clause's int, as a uint32")
    println("${pick(1, 7, 5000000000)} ${mean(1, 2, 2.5)}")
}
