// Regression (#2800): a module-level `var` of an optional type can be
// declared with a value, with `none`, or with no initialiser (`none`), and
// read, matched and re-bound from functions, a tuple destructure included.
//
// A module-level `var` is a file-scope static whose initialiser C requires
// to be constant. An optional one was given its value bare (`static
// ae_opt_int g = 3;`, an invalid initialiser), `none` was refused as not a
// constant, a struct literal was refused for a struct optional, and a
// declaration needed an initialiser at all. The initialiser is now the
// optional's own constant (`{ .has = 1, .val = 3 }`, `{0}` for `none` or
// for no initialiser). A function's `g = v` or `g, n = f()` writes the
// global, a bare value wrapped, as for a local. A `string?` global owns
// its string: a re-bind takes a string of its own and gives back the one
// it held, so re-binding it in a loop grows nothing.
//
// The leak check runs where the heap count is exact (mem.heap_in_use_exact):
// after a warm-up, some window of the same work grows by exactly 0
// (mem.steady_growth).

import std.mem
import std.string

extern exit(code: int)

struct Point {
    x: int
    y: int
}

var gi: int? = 3
var gi_none: int? = none
var gi_unset: int?
var gs: string? = "hi"
var gs_none: string? = none
var gs_unset: string?
var gp: Point? = Point { x: 1, y: 2 }
var gp_none: Point? = none
var gp_unset: Point?

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

two() -> (int, int) {
    return 7, 8
}

names(p: string) -> (string, int) {
    return string.concat(p, "!"), 2
}

opt_names(p: string, n: int) -> (string?, int) {
    if n > 0 {
        return string.concat(p, "?"), n
    }
    return none, 0
}

int_or(o: int?) -> int {
    int r = match o {
        none -> -1
        some(v) -> v
    }
    return r
}

str_len(o: string?) -> int {
    int r = match o {
        none -> -1
        some(v) -> string.length(v)
    }
    return r
}

point_sum(o: Point?) -> int {
    int r = match o {
        none -> -1
        some(v) -> v.x + v.y
    }
    return r
}

set_ints() {
    gi = 5
    gi_none = 6
    gi_unset, _ = two()
}

clear_ints() {
    gi = none
}

set_strs(p: string) {
    gs = string.concat(p, "!!")
    gs_none, _ = names(p)
    gs_unset, _ = opt_names(p, 1)
}

clear_strs() {
    gs = none
    gs_none = none
    gs_unset = none
}

set_points() {
    gp = Point { x: 10, y: 20 }
    gp_none = Point { x: 3, y: 4 }
}

// Re-bound in a loop body and by a closure: still the global.
in_loop(p: string) -> int {
    i = 0
    while i < 3 {
        gi = i
        gs = string.concat(p, "?")
        i = i + 1
    }
    set = || {
        gi_none = 40
    }
    set()
    return gi ?? -1
}

// A local bound to a string? global keeps its own string when the
// global is re-bound.
kept_copy(p: string) -> int {
    gs = string.concat(p, "123")
    let mine: string? = none
    mine = gs
    gs = none
    int r = string.length(mine ?? "")
    return r
}

fn round(p: string) {
    i = 0
    while i < 100 {
        set_strs(p)
        clear_strs()
        set_strs(p)
        in_loop(p)
        kept_copy(p)
        i = i + 1
    }
}

main() {
    println("=== test_optional_module_var ===")
    p = string.concat("bc", "")
    check((gi ?? -1) == 3, "an int? declared with a value (${gi ?? -1})")
    check((gi_none ?? -1) == -1, "an int? declared none")
    check((gi_unset ?? -1) == -1, "an int? declared with no initialiser")
    check((gs ?? "-") == "hi", "a string? declared with a value (${gs ?? "-"})")
    check(gs_none == none && gs_unset == none, "a string? declared none, or with no initialiser")
    check(point_sum(gp) == 3, "a Point? declared with a value (${point_sum(gp)})")
    check(point_sum(gp_none) == -1 && point_sum(gp_unset) == -1, "a Point? declared none, or with no initialiser")
    set_ints()
    check(int_or(gi) == 5 && int_or(gi_none) == 6, "int? globals re-bound (${int_or(gi)} ${int_or(gi_none)})")
    check(int_or(gi_unset) == 7, "an int? global destructured into (${int_or(gi_unset)})")
    clear_ints()
    check(gi == none, "an int? global re-bound to none")
    set_strs(p)
    check(str_len(gs) == 4, "a string? global re-bound (${str_len(gs)})")
    check((gs_none ?? "-") == "bc!", "a string? global destructured from a string (${gs_none ?? "-"})")
    check((gs_unset ?? "-") == "bc?", "a string? global destructured from a string? (${gs_unset ?? "-"})")
    set_points()
    check(point_sum(gp) == 30 && point_sum(gp_none) == 7, "Point? globals re-bound")
    check(in_loop(p) == 2 && int_or(gi_none) == 40 && (gs ?? "-") == "bc?",
        "optional globals re-bound in a loop and by a closure (${gi ?? -1} ${gi_none ?? -1})")
    check(kept_copy(p) == 5, "a local keeps a copy of a string? global (${kept_copy(p)})")
    if mem.heap_in_use_exact() {
        round(p)
        grown = mem.steady_growth(|| {
                round(p)
            }, 5)
        check(grown == 0, "100 re-binds of string? globals grew the heap by ${grown} bytes in every run")
    }
    println("=== test_optional_module_var passed ===")
}
