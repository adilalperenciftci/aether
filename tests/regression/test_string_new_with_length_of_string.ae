// #3030: string.new_with_length(s, n) of an Aether string copies its
// characters, and a buffer C filled is copied as given. The C function copied
// a counted or pinned string's header bytes (the grid's SA5 cells read them
// back wrong). The first fix made the C function read any argument that began
// with a string header's magic as a string, which followed a forged header in
// a raw buffer (#2301's binary payloads crashed); now codegen passes a string
// as its characters, and the buffer is never read as one.
import std.string

extern exit(code: int)

check(ok: bool, what: string) {
    if !ok {
        println("FAIL: ${what}")
        exit(1)
    }
}

main() {
    // A literal is a pinned string.
    lit = string.new_with_length("abcdef", 3)
    check(string.length(lit) == 3 && string.equals(lit, "abc") == 1, "a literal's first 3 characters")
    // A counted string.
    s = string.concat("xy", "zw")
    cnt = string.new_with_length(s, 2)
    check(string.length(cnt) == 2 && string.equals(cnt, "xy") == 1, "a counted string's first 2 characters")
    // A string holding a NUL is copied past it, by its length.
    nul = string.new_with_length("a\0bc", 4)
    check(string.length(nul) == 4 && string.char_at(nul, 2) == 98, "a string's NUL is copied")
    // A raw buffer that begins like a string's header (magic DE C0 57 AE, a
    // count, a length and a data pointer of 0x10) is copied as given.
    byte[34] raw = [222, 192, 87, 174, 1, 0, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0,
                    5, 0, 0, 0, 0, 0, 0, 0, 16, 0, 0, 0, 0, 0, 0, 0, 104, 105]
    got = string.new_with_length(raw, 34)
    check(string.length(got) == 34, "a forged header's buffer keeps its 34 bytes")
    check(string.char_at(got, 0) == 222 && string.char_at(got, 32) == 104, "and its bytes as given")
    println("ok")
}
