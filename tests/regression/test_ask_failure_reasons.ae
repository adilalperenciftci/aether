// An ask that gets no reply says why, and an ask to a dead actor ends at once
// (#3151).
//
// An ask to an actor that had died waited the whole timeout (5 s) and gave
// the reply's zero value, which the caller could not tell from a reply of 0;
// a timed-out ask gave the same zero and no reason either. `v, err = actor ?
// Msg {}` now gives the reply and "", or the zero value and the reason; the
// single-value form keeps the zero value, without the wait.

message Get {}
message Name {}
message Boom {}
message Never {}
message Value { v: int }

extern exit(code: int)

actor Server {
    state n = 42
    state label = "primary"

    receive {
        Get() -> { reply Value { v: n } }
        Name() -> { reply label }
        Boom() -> {
            panic("boom before the reply")
        }
        Never() -> {
            n = n + 0
        }
    }
}

check(label: string, ok: bool) -> int {
    if !ok {
        println("  FAIL ${label}")
        return 1
    }
    println("  PASS ${label}")
    return 0
}

// Whether `ms` is well under the 5 s timeout. The time is printed only when
// it is not: a PASS line reads the same on every run and at every -O level.
at_once(label: string, ms: int) -> int {
    if ms >= 2000 {
        println("  FAIL ${label}: took ${ms} ms")
        return 1
    }
    println("  PASS ${label}")
    return 0
}

main() {
    println("=== an ask that gets no reply says why (#3151) ===")
    fails = 0

    live = spawn(Server())
    v, err = live ? Get {}
    fails = fails + check("a reply: (42, \"\"), got (${v}, \"${err}\")", v == 42 && err == "")
    s, serr = live ? Name {}
    fails = fails + check("a string reply: (\"primary\", \"\"), got (\"${s}\", \"${serr}\")",
        s == "primary" && serr == "")

    // Dies handling an ask, before its reply.
    dying = spawn(Server())
    t0 = clock_ns()
    dv, derr = dying ? Boom {}
    died_ms = (clock_ns() - t0) / 1000000
    fails = fails + check("an actor that dies first: (0, \"the actor died before it replied\"), got (${dv}, \"${derr}\")",
        dv == 0 && derr == "the actor died before it replied")
    fails = fails + at_once("and the asker learns at once, not at the timeout", died_ms)

    // Asked once it is dead.
    t1 = clock_ns()
    gv, gerr = dying ? Get {}
    dead_ms = (clock_ns() - t1) / 1000000
    fails = fails + check("a dead actor: (0, \"the actor is dead\"), got (${gv}, \"${gerr}\")",
        gv == 0 && gerr == "the actor is dead")
    fails = fails + at_once("at once", dead_ms)

    // The single-value form: the zero value, still without the wait.
    t2 = clock_ns()
    int plain = dying ? Get {}
    plain_ms = (clock_ns() - t2) / 1000000
    fails = fails + check("a dead actor, single value: 0, got ${plain}", plain == 0)
    fails = fails + at_once("at once", plain_ms)

    // No reply at all: the timeout, and its reason.
    nv, nerr = live ? Never {}
    fails = fails + check("no reply: (0, \"ask timed out after 5000 ms\"), got (${nv}, \"${nerr}\")",
        nv == 0 && nerr == "ask timed out after 5000 ms")

    if fails > 0 {
        println("FAIL: ${fails} case(s)")
        exit(1)
    }
    println("All PASS")
}
