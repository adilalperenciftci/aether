// Regression (#2750): the string of a `string?` call result that nothing
// binds is freed once the expression that uses it is done.
//
// A function returning `string?` hands its caller a string of its own
// (#2740: a returned literal is copied too). Bound to a local, the result is
// that local's and freed at its exit; used where nothing binds it, it was
// freed by nobody: under `??` and `!`, in a comparison, an interpolation, as
// a call's argument, as a `match` scrutinee, thrown away. Each leaked one
// string per evaluation, and since #2740 even `lookup(true)! == "Ada"` over
// a function returning a literal did (test_issue340_optionals under macOS
// `leaks`). The result is now a temporary of the expression: `call!` and
// `call ?? d` yield a heap string of their own (the default is copied unless
// it is fresh itself), freed by whatever reads it as a `string.concat`
// result is; `call == none` frees after reading the flag; an argument is
// freed after the call when the parameter keeps nothing; a `match` arm's
// `some` binding owns it for the arm; a discarded one is freed.
//
// Each check reads its value after churn, allocations of the same sizes
// that reuse what was freed. The leak checks run where the heap count is
// exact (mem.heap_in_use_exact): after a warm-up, some window of the same
// work grows by exactly 0 (mem.steady_growth), one window per shape.
// Strings are built from parameters, because string.concat of two literals
// folds to a literal.

import std.mem
import std.string

extern exit(code: int)

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL #2750: ${msg}")
        exit(1)
    }
}

// Allocations of the sizes the checks read, to take over freed blocks.
churn(w: string) -> int {
    n = 0
    i = 0
    while i < 8 {
        a = string.concat(w, "!!")
        b = string.concat(w, "z")
        n = n + string.length(a) + string.length(b)
        i = i + 1
    }
    return n
}

fresh(w: string, has: bool) -> string? {
    if has {
        return string.concat(w, "f")
    }
    return none
}

lookup(found: bool) -> string? {
    if found {
        return "Ada"
    }
    return none
}

len(o: string?) -> int {
    if o != none {
        return string.length(o!)
    }
    return -1
}

// A callee that hands its `string?` parameter back (a copy, #2740).
pass_on(o: string?) -> string? {
    return o
}

as_coalesce(w: string) -> int {
    a = (fresh(w, true) ?? "x") == "wf"
    b = (fresh(w, false) ?? "x") == "x"
    c = (lookup(true) ?? "x") == "Ada"
    churn(w)
    check(a && b && c, "a `??` over a string? call")
    return 1
}

as_unwrap(w: string) -> int {
    a = fresh(w, true)! == "wf"
    b = lookup(true)! == "Ada"
    n = string.length(fresh(w, true)!)
    churn(w)
    check(a && b && n == 2, "a `!` over a string? call")
    return n
}

as_compare(w: string) -> int {
    a = fresh(w, true) != none
    b = fresh(w, false) == none
    c = fresh(w, true) == fresh(w, true)
    d = lookup(true) != fresh(w, true)
    churn(w)
    check(a && b && c && d, "a comparison of a string? call")
    return 1
}

as_interpolate(w: string) -> int {
    s = "${fresh(w, true) ?? "x"}:${fresh(w, true)!}:${lookup(false) ?? "none"}"
    println("interpolated ${fresh(w, true)!}")
    churn(w)
    check(s == "wf:wf:none", "an interpolation of a string? call (${s})")
    return string.length(s)
}

as_argument(w: string) -> int {
    n = len(fresh(w, true)) + len(fresh(w, false)) + len(lookup(true))
    p = pass_on(fresh(w, true))
    churn(w)
    check(n == 2 - 1 + 3, "a string? call passed as an argument (${n})")
    check(p! == "wf", "a string? argument handed back")
    return n
}

as_discard(w: string) -> int {
    fresh(w, true)
    _ = fresh(w, true)
    lookup(true)
    return 0
}

as_matched(w: string) -> int {
    let a: int = match fresh(w, true) {
        none -> -1
        some(v) -> string.length(v)
    }
    let b: int = match lookup(true) {
        none -> -1
        _ -> 1
    }
    let s: string = match fresh(w, true) {
        none -> "none"
        some(v) -> v
    }
    churn(w)
    check(a == 2 && b == 1 && s == "wf", "a match over a string? call (${a}, ${b}, ${s})")
    return a + b
}

as_bound(w: string) -> int {
    x = fresh(w, true)!
    y = fresh(w, false) ?? "dflt"
    z = lookup(true) ?? "x"
    churn(w)
    check(x == "wf" && y == "dflt" && z == "Ada", "a bound unwrap of a string? call")
    return string.length(x) + string.length(y) + string.length(z)
}

measure(which: int, w: string) -> long {
    return mem.steady_growth(|| {
            k = 0
            while k < 100 {
                if which == 0 { as_coalesce(w) }
                if which == 1 { as_unwrap(w) }
                if which == 2 { as_compare(w) }
                if which == 3 { as_argument(w) }
                if which == 4 { as_discard(w) }
                if which == 5 { as_matched(w) }
                if which == 6 { as_bound(w) }
                k = k + 1
            }
        }, 5)
}

main() {
    println("=== test_opt_string_call_temporaries ===")
    w = "w"
    check(as_coalesce(w) + as_unwrap(w) + as_compare(w) + as_argument(w) + as_discard(w) == 8, "a round adds up")
    check(as_matched(w) == 3 && as_bound(w) == 9 && as_interpolate(w) == 10, "a round adds up")
    if mem.heap_in_use_exact() {
        names = ["??", "!", "a comparison", "an argument", "a discard", "a match", "a binding"]
        i = 0
        while i < 7 {
            grown = measure(i, w)
            check(grown == 0, "100 uses as ${names[i]} grew the heap by ${grown} bytes in every run")
            i = i + 1
        }
        grown = mem.steady_growth(|| {
                k = 0
                while k < 20 {
                    as_interpolate(w)
                    k = k + 1
                }
            }, 5)
        check(grown == 0, "20 interpolations grew the heap by ${grown} bytes in every run")
    }
    println("=== test_opt_string_call_temporaries passed ===")
}
