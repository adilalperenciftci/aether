// Regression (#2760): std.http's server took `THIS IS NOT HTTP` for a
// request (method THIS, path IS), answered it 404 and kept the connection
// open for a next request the client never sends, so the client waited out
// its own timeout: 20 such sessions were about 100 s of the actor-mode
// release test on Linux. A request line whose version is not HTTP/1.0 or
// HTTP/1.1 is now answered 400 and the connection closed, as any request
// that does not parse is. A well-formed request is still served on its
// connection.

import std.http
import std.tcp
import std.string

extern exit(code: int)

handle_ping(req: ptr, res: ptr, ud: ptr) {
    http.response_set_body(res, "pong")
}

// Sends `raw` on a fresh connection and reads until the server closes it,
// giving up after 3 s with nothing to read. Returns what came back and
// whether the server closed the connection.
exchange(port: int, raw: string) -> (string, int) {
    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        return "connect: ${cerr}", 0
    }
    tcp.write(sock, raw)
    resp = ""
    closed = 0
    reading = 1
    while reading == 1 {
        ready, _perr = tcp.poll(sock, 3000)
        if !ready {
            reading = 0
        } else {
            chunk, rerr = tcp.read(sock, 4096)
            if rerr != "" || string.length(chunk) == 0 {
                closed = 1
                reading = 0
            } else {
                resp = string.concat(resp, chunk)
            }
        }
    }
    tcp.close(sock)
    return resp, closed
}

main() {
    s = http.server_create(0)
    if s == 0 {
        println("FAIL: server_create")
        exit(1)
    }
    http.server_set_host(s, "127.0.0.1")
    http.server_get(s, "/ping", handle_ping, 0)
    _ = http.server_start_background(s)
    port = 0
    tries = 0
    while port == 0 && tries < 100 {
        sleep(20)
        port = http.server_port(s)
        tries = tries + 1
    }
    if port == 0 {
        println("FAIL: the server never bound")
        http.server_stop(s)
        exit(1)
    }
    bad = 0

    garbage, gclosed = exchange(port, "THIS IS NOT HTTP\r\n\r\n")
    if string.starts_with(garbage, "HTTP/1.1 400") != 1 {
        println("FAIL: a non-HTTP request line was answered '${string.substring(garbage, 0, 24)}', want 400")
        bad = bad + 1
    }
    if gclosed != 1 {
        println("FAIL: the server kept the connection of a non-HTTP request line open")
        bad = bad + 1
    }

    future, fclosed = exchange(port, "GET /ping HTTP/9.9\r\nHost: x\r\n\r\n")
    if string.starts_with(future, "HTTP/1.1 400") != 1 || fclosed != 1 {
        println("FAIL: an unknown HTTP version was not answered 400 and closed")
        bad = bad + 1
    }

    good, _okclosed = exchange(port, "GET /ping HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    if string.starts_with(good, "HTTP/1.1 200") != 1 || string.contains(good, "pong") != 1 {
        println("FAIL: a well-formed request got '${string.substring(good, 0, 24)}'")
        bad = bad + 1
    }

    old, _oldclosed = exchange(port, "GET /ping HTTP/1.0\r\n\r\n")
    if string.starts_with(old, "HTTP/1.1 200") != 1 {
        println("FAIL: an HTTP/1.0 request got '${string.substring(old, 0, 24)}'")
        bad = bad + 1
    }

    http.server_stop(s)
    http.server_free(s)
    if bad != 0 {
        exit(1)
    }
    println("PASS: a non-HTTP request line is answered 400 and closed; HTTP/1.0 and 1.1 are served")
}
