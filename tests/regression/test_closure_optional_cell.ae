// Regression (#2795): an optional local, or parameter, that a closure
// writes is a cell the closure shares, as any variable a closure writes is.
//
// The optional declaration path declared `ae_opt_int a` and stored into it
// directly, without asking whether a closure writes it, so the closure's
// capture of the cell did not compile (`_aether_cell_retain` given an
// `ae_opt_int`). It makes the cell now, and every store goes through it,
// a bare value wrapped. A `string?` cell owns the string it holds, as a
// string cell does: a store takes a string of its own and gives back the
// one it held, and the cell's last release gives back the last.
//
// The leak check runs where the heap count is exact (mem.heap_in_use_exact):
// after a warm-up, some window of the same work grows by exactly 0
// (mem.steady_growth).

import std.mem
import std.string

extern exit(code: int)

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

two() -> (int, int) {
    return 7, 8
}

single() -> int {
    let a: int? = 3
    set = || {
        a = 5
    }
    set()
    int r = a ?? -1
    return r
}

cleared() -> int {
    let a: int? = 3
    clear = || {
        a = none
    }
    clear()
    int r = a ?? -1
    return r
}

pair() -> int {
    let a: int? = 3
    b = 0
    set = || {
        a, b = two()
    }
    set()
    int r = (a ?? -1) * 10 + b
    return r
}

param(x: int?) -> int {
    set = || {
        x = 9
    }
    set()
    int r = x ?? -1
    return r
}

strs(p: string) -> int {
    let s: string? = none
    set = || {
        s = string.concat(p, "!")
    }
    set()
    set()
    int n = string.length(s ?? "")
    clear = || {
        s = none
    }
    clear()
    int r = n * 10 + string.length(s ?? "")
    return r
}

str_param(s: string?, p: string) -> int {
    set = || {
        s = string.concat(p, "?!")
    }
    int before = string.length(s ?? "")
    set()
    int r = before * 10 + string.length(s ?? "")
    return r
}

fn round(p: string) {
    i = 0
    while i < 100 {
        strs(p)
        str_param(p, p)
        i = i + 1
    }
}

main() {
    println("=== test_closure_optional_cell ===")
    p = string.concat("bc", "")
    check(single() == 5, "a closure writes an int? (${single()})")
    check(cleared() == -1, "a closure clears an int? (${cleared()})")
    check(pair() == 78, "a closure destructures into an int? (${pair()})")
    check(param(1) == 9, "a closure writes an int? parameter (${param(1)})")
    check(strs(p) == 30, "a closure writes a string? (${strs(p)})")
    check(str_param(p, p) == 24, "a closure writes a string? parameter (${str_param(p, p)})")
    check(p == "bc", "the caller's string is the caller's (${p})")
    if mem.heap_in_use_exact() {
        round(p)
        grown = mem.steady_growth(|| {
                round(p)
            }, 5)
        check(grown == 0, "100 closures writing string? cells grew the heap by ${grown} bytes in every run")
    }
    println("=== test_closure_optional_cell passed ===")
}
