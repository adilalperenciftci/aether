// Regression: an array literal indexed in place, `[10, 20, 30][i]`, works
// anywhere an expression does.
//
// The literal was emitted as the bare initializer `{10, 20, 30}[...]`, which
// C refuses: an initializer list is only valid in a declaration. It is now the
// statement's temporary, as a literal passed as an argument is, or a compound
// literal where no temporary can be declared. The bounds check is the one any
// array index has; `[..].len` on a literal is its element count.

import std.string

extern exit(code: int)

struct Pt { x: int, y: int }

check(label: string, got: int, want: int) -> int {
    if got == want {
        println("  PASS ${label} = ${got}")
        return 0
    }
    println("  FAIL ${label}: got ${got}, want ${want}")
    return 1
}

double_it(n: int) -> int { return n * 2 }

second_name() -> string { return ["ann", "bob", "cy"][1] }

pick(i: int) -> int { return [10, 20, 30][i] }

pt_y(i: int) -> int {
    p = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }][i]
    return p.y
}

main() {
    fails = 0
    i = 1
    println("array literal indexed in place")
    v = [10, 20, 30][i]
    fails = fails + check("initializer", v, 20)
    fails = fails + check("argument", double_it([1, 2, 3][2]), 6)
    fails = fails + check("return", pick(2), 30)
    fails = fails + check("in arithmetic", [10, 20][i] + [1, 2][0], 21)
    fails = fails + check("string element", string.length(["ab", "cde", "f"][i]), 3)
    fails = fails + check("string returned", string.length(second_name()), 3)
    fails = fails + check("struct element", pt_y(1), 4)
    fails = fails + check("literal .len", [5, 6, 7].len, 3)
    j = 0
    while j < 3 {
        fails = fails + check("in a loop", [7, 8, 9][j], 7 + j)
        j = j + 1
    }
    // Out of range panics as any array index does, and can be caught.
    k = 5
    caught = 0
    try {
        x = [1, 2, 3][k]
        println("  FAIL: no panic (${x})")
    } catch e {
        caught = 1
    }
    fails = fails + check("out of range caught", caught, 1)
    if fails > 0 {
        println("${fails} failure(s)")
        exit(1)
    }
    println("all passed")
}
