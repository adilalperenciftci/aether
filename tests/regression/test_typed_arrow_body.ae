// Regression (#3158): an arrow body may follow a written result type.
//
// The bug: `square(x: int) -> int -> x * x` was read as a result type
// followed by a block body, failed with "Expected LEFT_BRACE, got ARROW",
// and the block parser then took the rest of the file as the missing
// block's statements: nine errors, the last ones on later functions'
// parameters. This file did not compile before the fix.
//
// What it exercises: `-> T -> expr` and `-> T -> { ...; expr }` with a
// keyword type, a struct, a tuple, an optional and a contract clause
// between the type and the body, each returning what it says.
// tests/integration/typed_arrow_body checks that a value of another type
// is one E0200 at the expression.

struct Point {
    x: int
    y: int
}

square(x: int) -> int -> x * x

origin() -> Point -> Point { x: 1, y: 2 }

pair(a: int) -> (int, int) -> (a, a + 1)

maybe(n: int) -> int? -> if n > 0 { n } else { none }

label(n: int) -> string -> {
    s = "n=${n}"
    s
}

positive(n: int) -> int
requires n > 0
-> n * 10

after_typed(y: int) -> int {
    return square(y) + 1
}

main() {
    a, b = pair(4)
    p = origin()
    ok = square(3) == 9 && p.x == 1 && p.y == 2 && a == 4 && b == 5 &&
    (maybe(0) ?? -1) == -1 && (maybe(3) ?? -1) == 3 && label(5) == "n=5" &&
    positive(2) == 20 && after_typed(2) == 5
    if !ok {
        println("FAIL: a typed arrow body returned the wrong value")
        exit(1)
    }
    println("typed arrow bodies: ok")
}
