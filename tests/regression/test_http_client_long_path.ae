// Regression (#2674): std.http.client sends a request path longer than
// 1,023 bytes whole. It copied the path into a fixed char[1024], cut it
// there, and sent the request anyway, so the server answered for a path the
// caller never asked for (OpenAlex answered 400; a server that accepts any
// path answered 200 for the wrong thing). A background server here reports
// the length of the path it received.

import std.http
import std.http.client
import std.string
import std.strbuilder

extern exit(code: int)
extern sleep(ms: int)
extern http_server_start_background_raw(server: ptr) -> int
extern http_server_port(server: ptr) -> int

handle_long(req: ptr, res: ptr, ud: ptr) {
    path = http.request_path(req)
    http.response_set_status(res, 200)
    http.response_set_body(res, "${string.length(path)}")
}

// A long path ending in /x is redirected to the relative "next", which the
// client resolves against the long base path (http_resolve_location, with a
// 1024-byte base path buffer before #2674); the target reports its length.
handle_redir(req: ptr, res: ptr, ud: ptr) {
    path = http.request_path(req)
    if string.ends_with(path, "/x") == 1 {
        http.response_set_status(res, 302)
        http.response_set_header(res, "Location", "next")
        http.response_set_body(res, "")
        return
    }
    http.response_set_status(res, 200)
    http.response_set_body(res, "${string.length(path)}")
}

long_path(prefix: string, suffix: string) -> string {
    sb = strbuilder.new(1600)
    strbuilder.append(sb, prefix)
    i = 0
    while i < 150 {
        strbuilder.append(sb, "abcdefghi.")
        i = i + 1
    }
    strbuilder.append(sb, suffix)
    return strbuilder.finish(sb)
}

main() {
    s = http.server_create(0)
    if s == 0 {
        println("FAIL: server_create")
        exit(1)
    }
    http.server_set_host(s, "127.0.0.1")
    http.server_get(s, "/long/*", handle_long, 0)
    http.server_get(s, "/redir/*", handle_redir, 0)
    http_server_start_background_raw(s)
    port = 0
    tries = 0
    while port <= 0 && tries < 100 {
        sleep(20)
        port = http_server_port(s)
        tries = tries + 1
    }
    if port <= 0 {
        println("FAIL: the server never bound")
        http.server_stop(s)
        exit(1)
    }

    // 6 + 1500 + 3 = 1509 bytes of path.
    path = long_path("/long/", "END")
    req = client.request("GET", "http://127.0.0.1:${port}${path}")
    client.set_timeout(req, 5s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        println("FAIL: send_request: ${err}")
        http.server_stop(s)
        exit(1)
    }
    status = client.response_status(resp)
    body = client.response_body(resp)
    client.response_free(resp)
    want = "${string.length(path)}"
    if status != 200 || string.equals(body, want) == 0 {
        println("FAIL: status ${status}, the server got ${body} of ${want} bytes of the path")
        http.server_stop(s)
        exit(1)
    }
    println("PASS: the server got all ${want} bytes of the path")

    // /redir/<1500 bytes>/x redirects to /redir/<1500 bytes>/next.
    from = long_path("/redir/", "/x")
    to_len = string.length(from) - 1 + 4
    rreq = client.request("GET", "http://127.0.0.1:${port}${from}")
    client.set_timeout(rreq, 5s)
    client.set_follow_redirects(rreq, 3)
    rresp, rerr = client.send_request(rreq)
    client.request_free(rreq)
    if rerr != "" {
        println("FAIL: redirect send_request: ${rerr}")
        http.server_stop(s)
        exit(1)
    }
    rstatus = client.response_status(rresp)
    rbody = client.response_body(rresp)
    client.response_free(rresp)
    http.server_stop(s)
    rwant = "${to_len}"
    if rstatus == 200 && string.equals(rbody, rwant) == 1 {
        println("PASS: a relative redirect from a long path kept all ${rwant} bytes")
        exit(0)
    }
    println("FAIL: redirect status ${rstatus}, the target got ${rbody} of ${rwant} bytes")
    exit(1)
}
