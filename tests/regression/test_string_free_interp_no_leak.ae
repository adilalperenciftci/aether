// Regression: `string.free(s)` on an interpolated or concatenated string
// reclaims it, and the local it was freed through is left empty, so scope
// exit does not free it again (a double free aborts on glibc and corrupts
// the heap elsewhere).
//
// Interpolation produces the refcounted shape (#1543), with its payload in
// the same allocation as its header. A helper that freed the string it was
// passed was covered here too; a function may not free what it borrows any
// more (E0901, tests/integration/frees_borrowed).

import std.string

extern exit(code: int)

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

main() {
    println("=== test_string_free_interp_no_leak ===")

    // 1. An interpolation, freed in the loop that makes it. One leaked block
    //    per iteration is what this used to cost.
    n = 0
    while n < 200 {
        s = "iteration ${n} of the loop"
        if string.contains(s, "of the loop") != 1 { fail("interpolation wrong") }
        string.free(s)
        n = n + 1
    }
    println("  PASS interpolated strings are reclaimed")

    // 2. A concat, freed through the same call.
    n = 0
    while n < 200 {
        c = string.concat("prefix-", "suffix")
        if string.equals(c, "prefix-suffix") != 1 { fail("concat wrong") }
        string.free(c)
        n = n + 1
    }
    println("  PASS concatenated strings are reclaimed")

    // 3. Freeing a variable that holds a literal must not reach free() on
    //    static storage: another holder of the same literal still reads it.
    lit = "static text"
    other = lit
    string.free(lit)
    if string.equals(other, "static text") != 1 { fail("literal damaged") }
    println("  PASS freeing a literal-holding variable is safe")

    println("=== test_string_free_interp_no_leak passed ===")
}
