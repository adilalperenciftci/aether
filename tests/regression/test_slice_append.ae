// `append(xs, v)`: a growable `T[]`. `xs` one element longer with `v` at its
// end, the buffer grown in place with its capacity doubling, so n appends
// cost O(n) in all. Before, Aether had no way to grow a slice: a program
// copied every element into a buffer one longer on each push (O(n) a push,
// O(n^2) a list, and the old buffer leaked unless it was freed by hand).
//
// Pre-change this file does not compile (`append` is undefined). The blocks
// cover each element kind (int, long, float, byte, string, a struct that
// owns a string, a plain struct, a closure, a function pointer), a slice
// built in a loop inside a function and returned, a slice parameter grown
// and handed back, 100k and 1M appends in linear time, a value that reads the slice it is appended to across a
// growth, element stores and sub-slices of a grown buffer, `free` of a grown
// buffer of strings (each element released: the leak gate checks it), and
// the named panics for a view that owns nothing.

import std.string

extern exit(code: int)

struct Named {
    name: string
    n: int
}

struct Pt {
    x: int
    y: int
}

twice(x: int) -> int {
    return x * 2
}

check(ok: bool, what: string) {
    if !ok {
        println("FAIL: ${what}")
        exit(1)
    }
}

total(xs: int[]) -> long {
    long t = 0
    for i in 0..xs.len {
        t = t + xs[i]
    }
    return t
}

// The translator's case: a list built in a loop and returned.
range_list(n: int) -> int[] {
    int[] xs = []
    for i in 0..n {
        xs = append(xs, i)
    }
    return xs
}

// A slice the caller owns, grown and handed back.
push_squares(xs: int[], n: int) -> int[] {
    for i in 0..n {
        xs = append(xs, i * i)
    }
    return xs
}

words(n: int) -> string[] {
    out = make([]string, 0)
    for i in 0..n {
        out = append(out, "w${i}")
    }
    return out
}

grow_view(xs: int[]) -> int[] {
    return append(xs, 1)
}

refused(what: string, xs: int[], want: string) {
    try {
        ys = grow_view(xs)
        println("FAIL: ${what}: no panic (${ys.len})")
        exit(1)
    } catch e {
        check(string.ends_with(e, want) != 0, "${what}: the panic says why (${e})")
    }
}

main() {
    // ---- int: from `[]`, in a function, returned ----
    xs = range_list(10)
    check(xs.len == 10, "ten appends give ten elements")
    check(xs[0] == 0 && xs[9] == 9, "each value at its index")
    check(total(xs) == 45, "a grown slice flows into an int[] parameter")
    free(xs)

    // ---- from a make buffer with elements of its own, and from null ----
    m = make([]int, 3)
    m[0] = 7
    m = append(m, 8)
    check(m.len == 4 && m[0] == 7 && m[1] == 0 && m[3] == 8, "a make buffer keeps its elements")
    m = push_squares(m, 5)
    check(m.len == 9 && m[8] == 16, "a slice parameter grown and handed back")
    free(m)
    int[] z = null
    z = append(z, 5)
    check(z.len == 1 && z[0] == 5, "null starts a buffer")
    free(z)

    // ---- 100k appends, then 1M: linear time ----
    t0 = clock_ns()
    big = range_list(100000)
    check(big.len == 100000 && big[99999] == 99999, "100k appends")
    check(total(big) == 4999950000, "100k appends sum")
    free(big)
    huge = range_list(1000000)
    check(huge.len == 1000000 && huge[999999] == 999999, "1M appends")
    free(huge)
    ms = (clock_ns() - t0) / 1000000
    // Doubling makes 1.1M appends a few milliseconds; copying the whole
    // slice on each one is ~4 TB moved and would not finish.
    check(ms < 20000, "1.1M appends in linear time (took ${ms} ms)")

    // ---- long, float, byte ----
    long[] ls = []
    ls = append(ls, 5000000000)
    ls = append(ls, 3)
    check(ls.len == 2 && ls[0] == 5000000000 && ls[1] == 3, "long elements, an int widened")
    free(ls)
    float[] fs = []
    for i in 0..20 {
        fs = append(fs, i * 0.5)
    }
    check(fs.len == 20 && fs[19] == 9.5, "float elements")
    free(fs)
    bs = make([]byte, 0)
    bs = append(bs, 65)
    bs = append(bs, 66)
    check(bs.len == 2 && bs[1] == 66, "byte elements")
    free(bs)

    // ---- strings: fresh, literal, a local that is released after ----
    ss = words(50)
    check(ss.len == 50 && string.equals(ss[49], "w49") != 0, "fresh strings appended")
    ss = append(ss, "literal")
    s = "local-${7}"
    ss = append(ss, s)
    s = "rebound"
    check(string.equals(ss[51], "local-7") != 0, "the element holds its own reference")
    ss[0] = "replaced-${0}"
    check(string.equals(ss[0], "replaced-0") != 0, "a store into a grown element")
    check(string.equals(ss[50], "literal") != 0, "a literal element")
    free(ss)

    // ---- the value reads the slice it grows, across a reallocation ----
    int[] r = []
    r = append(r, 41)
    for i in 0..100 {
        r = append(r, r[0] + 1)
    }
    check(r.len == 101 && r[100] == 42, "a value read from the slice before it moves")
    sub = r[1..3]
    check(sub.len == 2 && sub[0] == 42, "a sub-slice of a grown buffer")
    free(r)

    // ---- structs: one that owns a string, a plain one ----
    ns = make([]Named, 0)
    for i in 0..10 {
        ns = append(ns, Named { name: "n${i}", n: i })
    }
    nm = Named { name: "kept-${1}", n: 99 }
    ns = append(ns, nm)
    check(ns.len == 11 && string.equals(ns[9].name, "n9") != 0 && ns[10].n == 99,
        "struct elements that own a string")
    check(string.equals(nm.name, "kept-1") != 0, "the appended struct is copied, not moved")
    free(ns)
    Pt[] ps = []
    ps = append(ps, Pt { x: 1, y: 2 })
    ps = append(ps, Pt { x: 3, y: 4 })
    check(ps.len == 2 && ps[1].y == 4, "plain struct elements")
    free(ps)

    // ---- closures in a bare `fn` slot, named functions in a typed one ----
    k = 10
    cs = make([]fn, 0)
    cs = append(cs, | x: int | { return x * k })
    cs = append(cs, | x: int | { return x + k })
    c1 = cs[1]
    check(cs.len == 2 && call(c1, 3) == 13, "closure elements keep their environment")
    free(cs)
    fps = make([]fn(int) -> int, 0)
    fps = append(fps, twice)
    g = fps[0]
    check(g(4) == 8, "a named function in a typed function pointer slot")
    free(fps)

    // ---- a view owns nothing: growing one is a named panic ----
    owner = make([]int, 4)
    refused("a sub-slice", owner[1..3],
        "append to a view of elements another slice or an array holds, which owns nothing")
    arr = [1, 2, 3]
    refused("an array", arr,
        "append to a view of elements another slice or an array holds, which owns nothing")
    free(owner)

    println("slice append: ok")
}
