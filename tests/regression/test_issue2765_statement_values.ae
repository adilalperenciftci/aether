// Regression (#2765): an `or` whose handler is a block, a `!` that
// propagates an error by returning, and a call with a trailing block whose
// value is used run statements as part of an expression. They were GNU
// statement expressions whatever the C compiler, so the C for a compiler that
// is not GCC-compatible (AETHER_GCC_COMPAT 0, what cl.exe compiles) did not
// compile. Where one is the first thing its statement evaluates (a binding's
// value, a returned value, an `if` condition, the first argument of a call,
// the left side of an operation, an operand after a literal) it now runs as
// statements ahead of the statement, its value left in a temporary, in the
// same order. This runs
// each position and checks its value; tests/compiler/test_msvc_compat.sh
// compiles it as strict C11 and under cl.exe.

import std.map
import std.string

extern exit(code: int)
extern malloc(size: int) -> ptr
extern free(p: ptr)

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

num(fail: bool) -> int! {
    if fail { return 0, "boom" }
    return 7
}

word(fail: bool, w: string) -> string! {
    if fail { return "", string.concat("bad-", w) }
    return string.concat(w, "!")
}

// An `or` block in a binding, an assignment and a return.
bound(fail: bool) -> int {
    v = num(fail) or { -1 }
    seen = ""
    v = num(fail) or {
        seen = err
        v - 1
    }
    if fail { check(seen == "boom", "err is bound in the block") }
    return v
}

returned(fail: bool, w: string) -> string {
    return word(fail, w) or { string.concat("fallback-", w) }
}

// An `or` block that leaves the function.
early(fail: bool) -> int {
    v = num(fail) or { return -9 }
    return v + 1
}

// An `or` block in an `if` condition and as a call's first argument.
in_condition(fail: bool, w: string) -> int {
    if string.length(word(fail, w) or { "" }) > 0 {
        return 1
    }
    return 0
}

// `!` propagating out of a result function, in a binding and a return.
halve(x: int) -> int! {
    if x % 2 != 0 { return 0, "odd" }
    return x / 2
}

quarter(x: int) -> int! {
    h = halve(x)!
    return halve(h)!
}

struct Bag {
    items: int
}

new_bag() -> ptr {
    b = malloc(sizeof(Bag)) as *Bag
    b.items = 0
    return b
}

add(_ctx: ptr) {
    b = _ctx as *Bag
    b.items = b.items + 1
}

taken(p: ptr) -> int {
    b = p as *Bag
    n = b.items
    free(p)
    return n
}

set_opt(_ctx: ptr, key: string, value: string) {
    map_put(_ctx, key, value)
}

builder label(text: string): string {
    suffix = ""
    if _builder != null && map_has(_builder, "suffix") == 1 { suffix, _ = map.get(_builder, "suffix") }
    out = string.concat(text, suffix)
    if _builder != null { map_free(_builder) }
    return out
}

// A call with a trailing block, its value returned or passed on.
fn made() -> ptr {
    return new_bag() {
        add()
        add()
    }
}

fn labelled() -> string {
    return label("x") {
        set_opt("suffix", "!")
    }
}

main() {
    check(bound(false) == 7, "or block, success")
    check(bound(true) == -2, "or block, error, the last expression")
    check(returned(false, "r") == "r!", "returned or block, success")
    check(returned(true, "r") == "fallback-r", "returned or block, error")
    check(early(false) == 8 && early(true) == -9, "or block that returns")
    check(in_condition(false, "c") == 1 && in_condition(true, "c") == 0,
        "or block in a condition")
    check((num(true) or { -5 }) == -5, "or block as an operand")
    check(10 + (num(true) or { -1 }) == 9, "or block after a literal operand")

    q, e = quarter(12)
    check(q == 3 && e == "", "propagating unwrap, success")
    q2, e2 = quarter(6)
    check(q2 == 0 && e2 == "odd", "propagating unwrap, error")

    check(taken(made()) == 2, "a returned call's block runs")
    n = taken(new_bag() {
            add()
            add()
            add()
        })
    check(n == 3, "an argument's block runs")
    check(labelled() == "x!", "a returned builder's block configures it")

    println("ok")
}
