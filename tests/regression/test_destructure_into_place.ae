// A destructure stores into an element or a field (#3167): each slot is a
// name, `_`, `a[i]` or `o.f`, and a place takes its value as `place =
// value` would, ownership included. `names[0], _ = pair()` was "Expected
// statement in block".

import std.mem
import std.string

extern exit(code: int)

struct Pt {
    name: string
    n: int
}

fn check(ok: bool, what: string) {
    if !ok {
        println("FAIL: ${what}")
        exit(1)
    }
}

pair(w: string) -> (string, int) {
    return string.concat(w, "!"), string.length(w)
}

// One of each shape: an element and a discard, an element and a new local,
// a field and a field, a local and an element.
shapes(round: int) {
    names = ["", ""]
    names[0], _ = pair("a")
    names[1], k = pair("bc")
    check(names[0] == "a!" && names[1] == "bc!" && k == 2, "elements, round ${round}")

    p = Pt { name: "", n: 0 }
    p.name, p.n = pair("xyz")
    check(p.name == "xyz!" && p.n == 3, "fields, round ${round}")

    counts = [0, 0]
    last, counts[1] = pair("q")
    check(last == "q!" && counts[1] == 1, "a local and an element, round ${round}")
}

main() {
    k = 0
    while k < 100 {
        shapes(k)
        k = k + 1
    }
    if mem.heap_in_use_exact() {
        grown = mem.steady_growth(|| {
                i = 0
                while i < 100 {
                    shapes(i)
                    i = i + 1
                }
            }, 5)
        check(grown == 0, "stores into places hold what they take: ${grown} bytes per 100 rounds")
    }
    println("PASS")
}
