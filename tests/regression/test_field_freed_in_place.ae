// Regression: a struct's string field freed where it lives gives its
// reference up, so nothing frees the same buffer again.
//
// The field owns its string (R2). Freed in place (`string.free(p.name)`,
// `release(p.name)`, or the runtime free bound under another name), the
// field is left empty: the store that replaces it next, and the destructor
// of the struct that holds it (`heap.free(p)`, a statement's temporary),
// find nothing to release. A store releases the value it replaces. Plain
// malloc'd buffers from an `@heap` extern (os.getenv here) are adopted as
// counted strings at the call, so they take the same path.
//
// Before R3 this test also covered a function that freed the string it was
// passed (`drop(s: string) { string.free(s) }`); that is refused now, E0901
// (tests/integration/frees_borrowed).
//
// The heap check runs where the count is exact (mem.heap_in_use_exact):
// after a warm-up, some window of the same work grows by exactly 0
// (mem.steady_growth). Strings are built from parameters, because
// string.concat of two literals folds to a literal.

import std.mem
import std.os
import std.string

extern exit(code: int)
// The runtime free under another name, as std.jsonpath once bound it: a
// free all the same, so a local or field handed to it gives its reference up.
@extern("string_free") drop_raw(s: string)

struct Item {
    name: string
    tag: string
}

struct Box {
    item: Item
    n: int
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

var made = 0
var seen = 0

counted_box(w: string) -> Box {
    made = made + 1
    return make_box(w)
}

// The second argument reads what the first one's call changes, so the
// first is evaluated ahead of the call into a temporary (#2478).
note(s: string, n: int) {
    check(s == "abc#", "the field reaches the call")
    seen = n
}

set_name(it: *Item, name: string) {
    it.name = string.copy(name)
}

make_box(w: string) -> Box {
    return Box { item: Item { name: string.concat(w, "#"), tag: "${w}%" }, n: 1 }
}

round(w: string) -> int {
    it = heap.new(Item)
    set_name(it, w)
    set_name(it, w)
    it.name = string.copy(w)
    check(it.name == w, "a store through a parameter and a local box")
    it.tag = string.concat(w, "#")
    string.free(it.tag)
    it.tag = string.concat(w, "%")
    release(it.tag)
    // Plain malloc'd buffers.
    it.tag = os.getenv("PATH")
    string.free(it.tag)
    it.tag = os.getenv("PATH")
    release(it.tag)
    it.tag = os.getenv("PATH")
    // The free under an alias, of a local and of a field.
    loose = string.concat(w, "~")
    drop_raw(loose)
    it.tag = string.concat(w, "^")
    drop_raw(it.tag)
    // A field of a statement's temporary struct.
    string.free(make_box(w).item.name)
    release(make_box(w).item.tag)
    before = made
    note(counted_box(w).item.name, made)
    check(made == before + 1 && seen == made, "the struct's call runs once, before the next argument")
    n = string.length(it.name)
    heap.free(it)
    return n
}

main() {
    println("=== test_field_freed_in_place ===")
    check(string.length(os.getenv("PATH")) > 0, "a PATH in the environment")
    check(round("abc") == 3, "the name survives every replacement")
    i = 0
    while i < 20 {
        round("abc")
        i = i + 1
    }
    if mem.heap_in_use_exact() {
        grown = mem.steady_growth(|| {
                k = 0
                while k < 200 {
                    round("abc")
                    k = k + 1
                }
            }, 5)
        check(grown == 0, "a window of 200 rounds grew the heap by ${grown} bytes in every run")
    }
    println("=== test_field_freed_in_place passed ===")
}
