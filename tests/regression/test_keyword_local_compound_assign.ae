// Regression (#2738): a local named after a C keyword is renamed for C
// (#976), and so is every node that names it. A compound assignment carries
// its target in the node itself and was left out, so `short += 2` wrote a
// bare `short` beside the declared `ae_short` and gcc failed. A closure
// parameter of such a name, beside a local of the same name: its body's
// reads were renamed and the parameter was not, so the closure took them for
// a capture of the local and declared `ae_short` twice.

extern exit(code: int)

main() {
    short = 1
    short += 2
    if short != 3 {
        println("FAIL: short is ${short}, want 3")
        exit(1)
    }
    f = | short: int | -> short + 1
    if f(4) != 5 {
        println("FAIL: a closure parameter named short gave ${f(4)}, want 5")
        exit(1)
    }
    println("PASS: keyword-named locals under a compound assignment and as a closure parameter")
}
