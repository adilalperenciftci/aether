// #3000: a call through a typed function pointer whose parameter is
// optional did not compile. `h = opt as fn(int?) -> int` then `h(4)` failed
// in C ("incompatible type, expected ae_opt_int") and `h(none)` with
// "expected expression before '{'": the arguments of such a call went to
// C as written, where a call through a closure with a known signature
// wraps a bare value into the optional and makes `none` the empty one. The
// call through a function pointer coerces its arguments the same way now.
// A struct field of such a type was declared before the optional's C type
// and did not compile either. Before the fix this program did not compile.

extern exit(code: int)

struct Ops {
    f: fn(int?) -> int
    o: fn(int) -> int?
}

var bad = 0

check(what: string, got: string, want: string) {
    if got != want {
        println("FAIL ${what}: got ${got}, want ${want}")
        bad = 1
    }
}

opt(x: int?) -> int {
    return match x {
        some(v) -> v * 2
        none -> -1
    }
}

label(s: string?) -> string {
    return match s {
        some(v) -> "<${v}>"
        none -> "<none>"
    }
}

some_of(x: int) -> int? {
    return x
}

// A typed function pointer parameter.
apply(g: fn(int?) -> int, v: int) -> int {
    return g(v) + g(none)
}

main() {
    // A local, given a value, `none` and an optional.
    h = opt as fn(int?) -> int
    let o: int? = 5
    check("local", "${h(4)} ${h(none)} ${h(o)}", "8 -1 10")

    // A string optional.
    l = label as fn(string?) -> string
    check("string", "${l("a")} ${l(none)}", "<a> <none>")

    // A parameter, and the fields of a struct, one returning an optional.
    check("parameter", "${apply(h, 7)}", "13")
    ops = Ops { f: opt as fn(int?) -> int, o: some_of as fn(int) -> int? }
    r = ops.o(4) ?? 0
    check("field", "${ops.f(3)} ${ops.f(none)} ${r}", "6 -1 4")

    if bad != 0 {
        exit(1)
    }
    println("ok")
}
