// Regression (#2745): a loop's local bound by an if-expression or by a call
// of a closure, read in the body before its binding (the value the previous
// pass bound), has the binding's type.
//
// The checker declares a loop's locals ahead of the loop, typed from what the
// inference pass before it knows of each binding (#2741). That pass typed
// neither an if-expression, which needs its arms' types, nor a call through a
// local bound to a closure literal, which needs the literal's result, so such
// a local was declared with no type and a read of it before the binding was
// interpolated as an int: `out = "${out}${prev}"` ahead of
// `prev = if i > 0 { "x" } else { "y" }` printed two pointer values. Each
// shape is read the pass after it is bound and checked by value.
import std.string

extern exit(code: int)

var bad = 0

check(label: string, got: string, want: string) {
    if string.equals(got, want) == 0 {
        println("FAIL ${label}: got ${got}, want ${want}")
        bad = bad + 1
    }
}

// The issue's first shape.
if_expression() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = if i > 0 { "x" } else { "y" }
        i = i + 1
    }
    return out
}

// The issue's second shape: `call(f)` through a local bound to a closure.
closure_call() -> string {
    f = || -> "z"
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = call(f)
        i = i + 1
    }
    return out
}

// The same closure called directly, `g(i)`.
closure_direct() -> string {
    g = | n: int | -> "g${n}"
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = g(i)
        i = i + 1
    }
    return out
}

// An if-expression whose then arm is not typed yet (the local itself, before
// its binding) takes its else arm's type.
if_expression_else() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = if i > 1 { prev } else { "e${i}" }
        i = i + 1
    }
    return out
}

// An int stays an int.
if_number() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = if i > 0 { i * 10 } else { 7 }
        i = i + 1
    }
    return out
}

main() {
    check("if-expression", if_expression(), "yx")
    check("call through a closure local", closure_call(), "zz")
    check("closure local called directly", closure_direct(), "g0g1")
    check("if-expression, else arm typed", if_expression_else(), "e0e1")
    check("if-expression of ints", if_number(), "710")
    if bad != 0 {
        println("${bad} check(s) failed")
        exit(1)
    }
    println("loop locals bound by if-expressions and closure calls: ok")
}
