// Regression test for #1035: the qualified argv forms resolve.
//
// std.os exported the argv externs under their raw names (aether_args_count,
// ...) with no `os_` prefix, so qualified resolution's `<prefix>_<suffix>`
// join never found them and `os.aether_args_count()` died with E0301. The
// resolver falls back to the bare exported name (gated on the module's
// exports list); `os.aether_argv_raw()` is such a name, the one argv
// accessor with no wrapper. The rest are one name each since #3014:
// `os.args_count()`, `os.args_get(i)`, `os.argv0()`. A program that wants a
// C function under its own name declares it, as this one does.

import std.os
import std.string

extern aether_args_count() -> int

main() {
    n = os.args_count()
    if n != aether_args_count() {
        print("FAIL: os.args_count (${n}) != the C aether_args_count (${aether_args_count()})\n")
        exit(1)
    }
    if n < 1 {
        print("FAIL: argv count ${n} < 1, argv[0] should always exist\n")
        exit(1)
    }
    print("PASS: os.args_count agrees with the C function (${n})\n")

    // The bare exported name, reached qualified (#1035).
    if os.aether_argv_raw() == null { // raw-ok: the qualified escape hatch under test (#1035)
        print("FAIL: os.aether_argv_raw() is null with argv initialised\n")
        exit(1)
    }
    print("PASS: os.aether_argv_raw() resolves qualified\n")

    a0 = os.args_get(0)
    if string.length(a0) < 1 || string.equals(a0, os.argv0()) != 1 {
        print("FAIL: os.args_get(0) '${a0}' is empty or differs from os.argv0()\n")
        exit(1)
    }
    print("PASS: os.args_get(0) and os.argv0() agree ('${a0}')\n")

    // Out of range: the contract is "" (never null).
    oob = os.args_get(9999)
    if string.length(oob) != 0 {
        print("FAIL: os.args_get(9999) returned non-empty '${oob}'\n")
        exit(1)
    }
    print("PASS: os.args_get out of range returns \"\"\n")

    print("=== #1035: the qualified argv forms compile and agree ===\n")
}
