// Regression (#2741): a loop's local read before its binding in the body,
// the value the previous pass bound, has the binding's type.
//
// The checker declares a loop's (or a branch's) locals ahead of the block,
// where codegen declares them, typed from what the inference pass before it
// knows of each binding. That pass left an interpolation untyped, so a local
// an interpolation binds was declared with no type, and a read of it before
// the binding was interpolated as an int: `out = "${out}${prev}"` ahead of
// `prev = "p${i}"` printed two pointer values. Each shape below is read the
// pass after it is bound and checked by value.
import std.string

extern exit(code: int)

var bad = 0

check(label: string, got: string, want: string) {
    println("  ${label}: ${got}")
    if string.equals(got, want) == 0 {
        println("FAIL ${label}: got ${got}, want ${want}")
        bad = bad + 1
    }
}

label_of(i: int) -> string {
    return "f${i}"
}

// The issue's shape.
interpolation() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = "p${i}"
        i = i + 1
    }
    return out
}

literal() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = "q"
        i = i + 1
    }
    return out
}

user_call() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = label_of(i)
        i = i + 1
    }
    return out
}

std_call() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = string.concat("c", string.from_int(i))
        i = i + 1
    }
    return out
}

// An int stays an int.
number() -> string {
    i = 0
    out = ""
    while i < 3 {
        if i > 0 {
            out = "${out}${prev}"
        }
        prev = i * 10
        i = i + 1
    }
    return out
}

// Both arms of an if/else bind it, inside the loop.
branches(flag: int) -> string {
    k = 0
    out = ""
    while k < 3 {
        if k > 0 {
            out = "${out}${tag}"
        }
        if flag > 0 {
            tag = "t${k}"
        } else {
            tag = "u${k}"
        }
        k = k + 1
    }
    return out
}

// A function-level branch binds it; a later branch reads it, then binds it.
twice(flag: int) -> string {
    if flag > 0 {
        pick = "b${flag}"
    }
    if flag > 1 {
        out = "${pick}!"
        pick = "c${flag}"
        return "${out}${pick}"
    }
    return pick
}

main() {
    println("=== test_loop_local_read_before_binding ===")
    check("interpolation", interpolation(), "p0p1")
    check("string literal", literal(), "qq")
    check("call", user_call(), "f0f1")
    check("std call", std_call(), "c0c1")
    check("int", number(), "010")
    check("if/else arms, then", branches(1), "t0t1")
    check("if/else arms, else", branches(0), "u0u1")
    check("branches", twice(2), "b2!c2")
    if bad != 0 {
        println("${bad} check(s) failed")
        exit(1)
    }
    println("=== test_loop_local_read_before_binding passed ===")
}
