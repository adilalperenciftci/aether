// Regression: a `match` bound to an optional takes each arm's value wrapped.
//
// `int? o = match n { 1 -> 41  _ -> none }` (and the `let o: int? = match`
// form) went through the optional declaration's single-value wrap, which
// emitted the whole match as one expression: `.val = n141_{0}`, an undeclared
// name in C. A match bound to an optional is now bound arm by arm, as any
// bound match is, each arm's value wrapped into the optional (`none` is the
// empty one): for `int?`, `string?` and a struct's optional, in a typed
// declaration, a re-bind and a `return` of the match.
extern exit(code: int)

struct Point {
    x: int
}

var bad = 0

check(label: string, got: int, want: int) {
    if got != want {
        println("FAIL ${label}: got ${got}, want ${want}")
        bad = bad + 1
    }
}

check_s(label: string, got: string, want: string) {
    if got != want {
        println("FAIL ${label}: got ${got}, want ${want}")
        bad = bad + 1
    }
}

c_style(n: int) -> int {
    int? o = match n {
        1 -> 41
        _ -> none
    }
    return o ?? 7
}

let_form(n: int) -> int {
    let o: int? = match n {
        1 -> 41
        2 -> {
            k = n * 10
            k
        }
        _ -> none
    }
    return o ?? 7
}

word(n: int) -> int {
    string? w = match n {
        1 -> "one"
        2 -> "two ${n}"
        _ -> none
    }
    check_s("string? arm ${n}", w ?? "none", if n == 1 { "one" } else { if n == 2 { "two 2" } else { "none" } })
    return 0
}

point(n: int) -> int {
    let p: Point? = match n {
        1 -> Point { x: 5 }
        _ -> none
    }
    return p?.x ?? 9
}

returned(n: int) -> int? {
    return match n {
        1 -> 3
        _ -> none
    }
}

rebound(n: int) -> int {
    let o: int? = 1
    o = match n {
        1 -> none
        _ -> 8
    }
    return o ?? 6
}

main() {
    check("int? first arm", c_style(1), 41)
    check("int? none arm", c_style(2), 7)
    check("let int? value arm", let_form(1), 41)
    check("let int? block arm", let_form(2), 20)
    check("let int? none arm", let_form(3), 7)
    word(1)
    word(2)
    word(3)
    check("Point? value arm", point(1), 5)
    check("Point? none arm", point(2), 9)
    check("returned value arm", returned(1) ?? 0, 3)
    check("returned none arm", returned(2) ?? 0, 0)
    check("re-bound to none", rebound(1), 6)
    check("re-bound to a value", rebound(2), 8)
    if bad != 0 {
        exit(1)
    }
    println("match into an optional: ok")
}
