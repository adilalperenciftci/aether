// Regression (#2698): in a C-style `for`, the variable the init binds is the
// loop's, and a binding of its name in the body assigns it. The body's
// `i = i + 1` declared a new `int i` that shadowed the loop's (reading its
// own uninitialised value), so `for (i = 0; i < 3; ) { i = i + 1 }` never
// ended. Each loop here is bounded by a step count, so a regression fails
// instead of hanging.
extern exit(code: int)

var bad = 0

check(label: string, got: int, want: int) {
    if got != want {
        println("FAIL ${label}: got ${got}, want ${want}")
        bad = bad + 1
    }
}

// Exits with an error once a loop runs far past its end.
step(steps: int, label: string) -> int {
    if steps > 50 {
        println("FAIL ${label}: the loop did not end")
        exit(1)
    }
    return steps + 1
}

main() {
    steps = 0
    for (i = 0; i < 3;) {
        i = i + 1
        steps = step(steps, "body steps i")
    }
    check("body steps i", steps, 3)

    total = 0
    steps = 0
    for (n = 0; n < 6;) {
        total = total + n
        n = n + 2
        steps = step(steps, "body steps by 2")
    }
    check("sum of 0, 2, 4", total, 6)
    check("steps by 2", steps, 3)

    // The increment and the body both step the variable.
    steps = 0
    for (k = 0; k < 10; k = k + 1) {
        k = k + 1
        steps = step(steps, "both step k")
    }
    check("both step k", steps, 5)

    // A typed init: the body reads the loop's variable, not an uninitialised one.
    seen = 0
    for (int m = 0; m < 3; m = m + 1) {
        m = m + 0
        seen = seen * 10 + m + 1
    }
    check("typed init", seen, 123)

    // The name is the loop's only inside it: after the loop it binds anew.
    for (j = 0; j < 2;) {
        j = j + 1
    }
    j = 7
    check("after the loop", j, 7)

    if bad != 0 {
        println("${bad} check(s) failed")
        exit(1)
    }
    println("the body assigns the loop variable: ok")
}
