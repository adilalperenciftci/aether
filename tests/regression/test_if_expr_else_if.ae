// Regression: an if-expression could not chain `else if`. The parser wanted
// a `{` after `else`, so `if a { x } else if b { y } else { z }` was
// "Expected LEFT_BRACE, got IF" and the chain had to be spelled
// `else { if b { y } else { z } }`. `else if` is now sugar for that nesting,
// at any length, and types as the nested form does.

extern exit(code: int)

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

sign_name(n: int) -> string {
    return if n < 0 { "neg" } else if n == 0 { "zero" } else { "pos" }
}

grade(score: int) -> int {
    return if score >= 90 { 4 } else if score >= 80 { 3 } else if score >= 70 { 2 } else if score >= 60 { 1 } else { 0 }
}

letter(score: int) -> string {
    return if score >= 90 { "A" } else if score >= 80 { "B" } else if score >= 70 { "C" } else if score >= 60 { "D" } else { "F" }
}

twice(n: int) -> int {
    return n * 2
}

shout(s: string) -> string {
    return "${s}!"
}

main() {
    // Initializers: ints and strings, three arms.
    n = 5
    s = if n < 0 { "neg" } else if n == 0 { "zero" } else { "pos" }
    check(s == "pos", "3-arm string initializer, last arm")
    z = 0
    s0 = if z < 0 { "neg" } else if z == 0 { "zero" } else { "pos" }
    check(s0 == "zero", "3-arm string initializer, middle arm")
    m = -3
    k = if m < 0 { -1 } else if m == 0 { 0 } else { 1 }
    check(k == -1, "3-arm int initializer, first arm")

    // Return position, three and five arms.
    check(sign_name(-7) == "neg", "returned 3-arm, first")
    check(sign_name(0) == "zero", "returned 3-arm, middle")
    check(sign_name(9) == "pos", "returned 3-arm, last")
    check(grade(95) == 4, "returned 5-arm int, 1st")
    check(grade(85) == 3, "returned 5-arm int, 2nd")
    check(grade(75) == 2, "returned 5-arm int, 3rd")
    check(grade(65) == 1, "returned 5-arm int, 4th")
    check(grade(10) == 0, "returned 5-arm int, else")
    check(letter(91) == "A", "returned 5-arm string, 1st")
    check(letter(72) == "C", "returned 5-arm string, 3rd")
    check(letter(3) == "F", "returned 5-arm string, else")

    // Argument position.
    check(twice(if n > 10 { 1 } else if n > 4 { 2 } else { 3 }) == 4, "int argument")
    check(shout(if n > 10 { "big" } else if n > 4 { "mid" } else { "small" }) == "mid!", "string argument")

    // String ownership: arms that build new strings, in a loop, so a leak or
    // a double free of an arm's value shows up under the memory checks.
    acc = ""
    i = 0
    while i < 5 {
        piece = if i == 0 { "a${i}" } else if i == 1 { shout("b") } else if i == 2 { "c" } else if i == 3 { letter(85) } else { "e${i}" }
        acc = "${acc}${piece},"
        i = i + 1
    }
    check(acc == "a0,b!,c,B,e4,", "string arms in a loop: ${acc}")

    // Mixed numeric arms join as the nested form does: int beside long is long.
    long big = 4000000000
    w = if n < 0 { 1 } else if n == 0 { big } else { 2 }
    check(w == 2, "int/long join")
    w2 = if n > 0 { big } else if n == 0 { 1 } else { 2 }
    check(w2 == 4000000000, "long arm kept")

    // Arms laid out over several lines, as the two-armed form allows.
    ml = if n < 0 {
        "neg"
    } else if n == 5 {
        "five"
    } else {
        "other"
    }
    check(ml == "five", "multi-line layout")

    // An operand of an operator.
    t = 1 + (if n < 0 { 10 } else if n == 5 { 20 } else { 30 }) * 2
    check(t == 41, "operand of an operator")

    // A chain inside an arm of another chain.
    q = if n > 100 { "huge" } else if n > 0 { if n % 2 == 0 { "even" } else if n == 5 { "five" } else { "odd" } } else { "nonpos" }
    check(q == "five", "chain nested in an arm")

    println("ok")
}
