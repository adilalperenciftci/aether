// A DER length is checked against the bytes left, so a length that is
// negative or near 2^31 is refused instead of wrapping past the check:
// `rr.pos + length > rr.len` overflowed, and an INTEGER declaring 0x7fffffff
// bytes reached bignum.from_bytes, which panicked on a negative element
// count (Wycheproof's ecdsa_p256 DER vectors).

import std.cryptography.asn1
import std.bytes
import std.string

digit(c: int) -> int {
    if c >= 97 { return c - 87 }
    return c - 48
}

der(hex: string) -> ptr {
    n = string.length(hex) / 2
    b = bytes.new(n)
    i = 0
    while i < n {
        bytes.set(b, i, digit(string.char_at(hex, 2 * i)) * 16 + digit(string.char_at(hex, 2 * i + 1)))
        i = i + 1
    }
    return b
}

refused(hex: string, what: string) -> int {
    buf = der(hex)
    r = asn1.reader_new(buf)
    _n, err = asn1.read_integer(r)
    asn1.reader_free(r)
    bytes.free(buf)
    if string.equals(err, "asn1: content runs past end of input") == 1 {
        return 0
    }
    println("FAIL ${what}: got '${err}'")
    return 1
}

main() {
    fails = 0
    fails = fails + refused("02847fffffff01", "a length of 0x7fffffff with one byte left")
    fails = fails + refused("0284ffffffff01", "a length that reads as negative")
    fails = fails + refused("028480000000", "a length of 2^31")
    fails = fails + refused("020205", "a length one byte past the input")

    buf = der("020105")
    r = asn1.reader_new(buf)
    _n, err = asn1.read_integer(r)
    if string.equals(err, "") != 1 {
        println("FAIL a whole INTEGER: '${err}'")
        fails = fails + 1
    }
    asn1.reader_free(r)
    bytes.free(buf)

    if fails != 0 {
        exit(1)
    }
    println("PASS asn1 lengths past the input are refused")
}
