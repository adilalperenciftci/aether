// Regression (#3098): a call through a typed function pointer that holds
// null is a named panic at the call, not a jump to address 0.
//
// A `fn(int) -> int` local, parameter, struct field, module-level `var`, a
// `cfn` local, an array element, a field reached through another field or
// an element, and a function's result each crashed with an access
// violation and no message when they held null. Each call now panics with
// the category `null_function_call` and the call's source position, which a
// `catch` receives; a pointer that holds a function is called as before,
// and a callee an expression yields is evaluated once.

import std.string

extern exit(code: int)

cfn Op(int) -> int

struct H {
    cb: fn(int) -> int
}

struct W {
    h: H
}

var G: fn(int) -> int = null
var picks = 0

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL #3098: ${msg}")
        exit(1)
    }
}

fn check_panic(e: string, line: string, what: string) {
    check(string.starts_with(e, "null_function_call: "), "${what}: category, got '${e}'")
    check(string.contains(e, "test_null_function_call.ae:${line}:"),
        "${what}: position ${line}, got '${e}'")
}

twice(x: int) -> int {
    return x * 2
}

apply(g: fn(int) -> int, x: int) -> int {
    return g(x)
}

none_op() -> Op {
    return null
}

pick() -> int {
    picks = picks + 1
    return 0
}

local() -> string {
    let f: fn(int) -> int = null
    try {
        f(3)
    } catch e {
        return e
    }
    return "no panic"
}

param() -> string {
    try {
        apply(null, 3)
    } catch e {
        return e
    }
    return "no panic"
}

cfn_local() -> string {
    let o: Op = null
    try {
        o(3)
    } catch e {
        return e
    }
    return "no panic"
}

global() -> string {
    try {
        G(3)
    } catch e {
        return e
    }
    return "no panic"
}

field() -> string {
    h = H { cb: null }
    try {
        h.cb(3)
    } catch e {
        return e
    }
    return "no panic"
}

nested_field() -> string {
    w = W { h: H { cb: null } }
    try {
        w.h.cb(3)
    } catch e {
        return e
    }
    return "no panic"
}

element() -> string {
    let o: Op = null
    fs = [o, o]
    try {
        fs[1](3)
    } catch e {
        return e
    }
    return "no panic"
}

element_field() -> string {
    hs = [H { cb: twice }, H { cb: null }]
    try {
        hs[1].cb(3)
    } catch e {
        return e
    }
    return "no panic"
}

result() -> string {
    try {
        none_op()(3)
    } catch e {
        return e
    }
    return "no panic"
}

main() {
    check_panic(local(), "62", "a local")
    check_panic(param(), "47", "a parameter")
    check_panic(cfn_local(), "81", "a cfn local")
    check_panic(global(), "90", "a module-level var")
    check_panic(field(), "100", "a field")
    check_panic(nested_field(), "110", "a field of a field")
    check_panic(element(), "121", "an array element")
    check_panic(element_field(), "131", "a field of an element")
    check_panic(result(), "140", "a function's result")

    let o: Op = twice
    hs = [H { cb: twice }, H { cb: twice }]
    w = W { h: H { cb: twice } }
    check(apply(twice, 4) == 8, "a parameter holding a function")
    check(o(5) == 10, "a cfn local holding a function")
    check(hs[0].cb(6) == 12, "an element's field holding a function")
    check(w.h.cb(7) == 14, "a field of a field holding a function")
    fs = [o, o]
    check(fs[pick()](2) == 4, "an element holding a function")
    check(picks == 1, "the callee evaluated ${picks} times, not once")
    println("PASS #3098: a call through a null function pointer is a named panic")
}
