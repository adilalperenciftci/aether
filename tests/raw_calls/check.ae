// No std or contrib file calls a raw C binding another module declares
// (#3107).
//
// A std module binds C through `*_raw` externs and builds its public
// functions on them: the error results, the ownership of what is stored,
// the bounds of what is read. A caller in another module that names the raw
// binding skips all of it and ties itself to a C signature the module is
// free to change. 49 files made 97 such calls before #3107 moved them to the
// public functions.
//
// This reads every .ae file under the given directories, collects the
// `*_raw` externs each module directory declares, and reports each call of
// one (`name_raw(`, `mod.name_raw(`) or selective import of one
// (`import std.x(name_raw)`) from a file whose own directory does not
// declare it. A name the file's directory declares is its own binding, and
// a `*_raw` name no module declares as an extern (a helper function of the
// file) is not a binding at all. Comments and string literals are skipped.
//
//     check [--exclude DIR]... [--expect N] DIR...
//
// Exits 1 on a call it reports; with --expect, unless exactly N were found
// (the self-test over tests/raw_calls/fixture). `make check-raw-calls` runs
// both.

import std.fs
import std.os
import std.io
import std.string
import std.collections

extern exit(code: int)

say(s: string) {
    _w = io.stdout_write("${s}\n")
}

is_ident_char(c: int) -> int {
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 {
        return 1
    }
    return 0
}

// The lines of a text, without their line breaks.
split_lines(text: string) -> ptr {
    out = collections.string_list_new()
    n = string.length(text)
    start = 0
    while start < n {
        cut = string.index_of_from(text, "\n", start)
        stop = cut
        if cut < 0 {
            stop = n
        }
        line_end = stop
        if line_end > start && string.char_at_n(text, n, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        collections.string_list_add(out, string.substring(text, start, line_end))
        start = stop + 1
    }
    return out
}

// A line with its comment cut off and every string literal's contents
// blanked (the quotes stay), so neither is read as code.
code_of(line: string) -> string {
    n = string.length(line)
    out = ""
    in_str = 0
    i = 0
    while i < n {
        c = string.char_at_n(line, n, i)
        if in_str == 1 {
            if c == 92 {
                i = i + 2
                continue
            }
            if c == 34 {
                in_str = 0
                out = "${out}\""
            }
            i = i + 1
            continue
        }
        if c == 34 {
            in_str = 1
            out = "${out}\""
            i = i + 1
            continue
        }
        if c == 47 && i + 1 < n && string.char_at_n(line, n, i + 1) == 47 {
            break
        }
        out = "${out}${string.from_char(c)}"
        i = i + 1
    }
    return out
}

// The identifier ending at `end` (exclusive) in `text`, or "".
ident_before(text: string, end: int) -> string {
    n = string.length(text)
    start = end
    while start > 0 && is_ident_char(string.char_at_n(text, n, start - 1)) == 1 {
        start = start - 1
    }
    return string.substring(text, start, end)
}

// The `*_raw` names a line of code uses: every identifier ending in `_raw`
// followed by `(`, and every one listed in a selective import.
raw_uses(code: string) -> ptr {
    out = collections.string_list_new()
    n = string.length(code)
    is_import = string.starts_with(string.trim(code), "import ")
    i = 0
    while i < n {
        c = string.char_at_n(code, n, i)
        if is_ident_char(c) == 1 && (i + 1 == n || is_ident_char(string.char_at_n(code, n, i + 1)) == 0) {
            name = ident_before(code, i + 1)
            if string.ends_with(name, "_raw") == 1 {
                j = i + 1
                while j < n && string.char_at_n(code, n, j) == 32 {
                    j = j + 1
                }
                if (j < n && string.char_at_n(code, n, j) == 40) || is_import == 1 {
                    collections.string_list_add(out, name)
                }
            }
        }
        i = i + 1
    }
    return out
}

// The name an extern declaration binds, or "": `extern name(` and
// `@extern("sym") name(`.
extern_name(code: string) -> string {
    t = string.trim(code)
    rest = ""
    if string.starts_with(t, "extern ") == 1 {
        rest = string.trim(string.substring(t, 7, string.length(t)))
    } else if string.starts_with(t, "@extern(") == 1 {
        close = string.index_of(t, ")")
        if close < 0 {
            return ""
        }
        rest = string.trim(string.substring(t, close + 1, string.length(t)))
    } else {
        return ""
    }
    open = string.index_of(rest, "(")
    if open <= 0 {
        return ""
    }
    return string.trim(string.substring(rest, 0, open))
}

last_index_of_char(s: string, c: int) -> int {
    n = string.length(s)
    i = n - 1
    while i >= 0 {
        if string.char_at_n(s, n, i) == c {
            return i
        }
        i = i - 1
    }
    return -1
}

dir_of(p: string) -> string {
    slash = last_index_of_char(p, 47)
    if slash < 0 {
        return "."
    }
    return string.substring(p, 0, slash)
}

excluded(excludes: ptr, p: string) -> int {
    n = collections.string_list_size(excludes)
    i = 0
    while i < n {
        if p == collections.string_list_get(excludes, i) {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Is `s` in the string list?
list_has(list: ptr, s: string) -> int {
    n = collections.string_list_size(list)
    i = 0
    while i < n {
        if collections.string_list_get(list, i) == s {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Does directory `dir` declare extern `name`? `decls` holds "name dir".
declares(decls: ptr, name: string, dir: string) -> int {
    return list_has(decls, "${name} ${dir}")
}

// The directories that declare extern `name`, for the report.
declarers(decls: ptr, name: string) -> string {
    out = ""
    n = collections.string_list_size(decls)
    prefix = "${name} "
    i = 0
    while i < n {
        d = collections.string_list_get(decls, i)
        if string.starts_with(d, prefix) == 1 {
            dir = string.substring(d, string.length(prefix), string.length(d))
            if out == "" {
                out = dir
            } else {
                out = "${out}, ${dir}"
            }
        }
        i = i + 1
    }
    return out
}

main() {
    dirs = collections.string_list_new()
    excludes = collections.string_list_new()
    expect = -1
    argc = os.args_count()
    i = 1
    while i < argc {
        a = os.args_get(i)
        if a == "--exclude" && i + 1 < argc {
            i = i + 1
            collections.string_list_add(excludes, string.replace_all(os.args_get(i), "\\", "/"))
        } else if a == "--expect" && i + 1 < argc {
            i = i + 1
            expect = string.get_int(os.args_get(i))
        } else {
            collections.string_list_add(dirs, string.replace_all(a, "\\", "/"))
        }
        i = i + 1
    }
    if collections.string_list_size(dirs) == 0 {
        say("usage: check [--exclude DIR]... [--expect N] DIR...")
        exit(2)
    }

    files = collections.string_list_new()
    nd = collections.string_list_size(dirs)
    i = 0
    while i < nd {
        root = collections.string_list_get(dirs, i)
        _n, werr = fs.walk(root) | path: string, kind: int, depth: int | {
            p = string.replace_all(path, "\\", "/")
            verdict = 0
            if kind == 2 {
                base = p
                slash = last_index_of_char(p, 47)
                if slash >= 0 {
                    base = string.substring(p, slash + 1, string.length(p))
                }
                if base == "build" || base == ".git" || base == "target" ||
                base == "node_modules" || excluded(excludes, p) == 1 {
                    verdict = 1
                }
            } else if kind == 1 && string.ends_with(p, ".ae") == 1 {
                collections.string_list_add(files, p)
            }
            return verdict
        }
        if werr != "" {
            say("raw calls: cannot walk ${root}: ${werr}")
            exit(2)
        }
        i = i + 1
    }

    // Pass 1: every `*_raw` extern and the directory that declares it.
    decls = collections.string_list_new()
    names = collections.string_list_new()
    nf = collections.string_list_size(files)
    i = 0
    while i < nf {
        p = collections.string_list_get(files, i)
        text, rerr = fs.read(p)
        if rerr != "" {
            say("raw calls: cannot read ${p}: ${rerr}")
            exit(2)
        }
        lines = split_lines(text)
        nl = collections.string_list_size(lines)
        k = 0
        while k < nl {
            name = extern_name(code_of(collections.string_list_get(lines, k)))
            if name != "" && string.ends_with(name, "_raw") == 1 {
                entry = "${name} ${dir_of(p)}"
                if list_has(decls, entry) == 0 {
                    collections.string_list_add(decls, entry)
                }
                if list_has(names, name) == 0 {
                    collections.string_list_add(names, name)
                }
            }
            k = k + 1
        }
        collections.string_list_free(lines)
        i = i + 1
    }

    // Pass 2: every use of one from a directory that does not declare it.
    found = 0
    i = 0
    while i < nf {
        p = collections.string_list_get(files, i)
        dir = dir_of(p)
        text, _rerr = fs.read(p)
        lines = split_lines(text)
        nl = collections.string_list_size(lines)
        k = 0
        while k < nl {
            code = code_of(collections.string_list_get(lines, k))
            if extern_name(code) == "" {
                uses = raw_uses(code)
                nu = collections.string_list_size(uses)
                u = 0
                while u < nu {
                    name = collections.string_list_get(uses, u)
                    if list_has(names, name) == 1 &&
                    declares(decls, name, dir) == 0 {
                        say("${p}:${k + 1}: ${name} is the raw C binding of ${declarers(decls, name)}; call that module's public function")
                        found = found + 1
                    }
                    u = u + 1
                }
                collections.string_list_free(uses)
            }
            k = k + 1
        }
        collections.string_list_free(lines)
        i = i + 1
    }

    say("raw calls: ${nf} Aether files, ${collections.string_list_size(names)} raw bindings: ${found} call(s) from another module")
    if expect >= 0 {
        if found != expect {
            say("raw calls: the self-test expected ${expect}")
            exit(1)
        }
        exit(0)
    }
    if found > 0 {
        exit(1)
    }
}
