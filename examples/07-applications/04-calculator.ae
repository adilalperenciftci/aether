// A calculator in the terminal: a button grid built by a DSL, with closures.
//
// The keypad is written as what it is: `grid() { btn("7") callback { ... }
// ... }`. `grid` makes the widget; each `btn` in its trailing block is
// given the grid without naming it (the block passes it as `_ctx`,
// docs/closures-and-builder-dsl.md), and records a label and the closure
// to run when the button is pressed. `box_closure` puts a closure in a
// list, `unbox_closure` takes it out, and `call` runs it. A closure
// captures values, so the state the buttons share (the number shown, the
// one before it, the operator) lives in ref cells, `ref(0)`, which every
// closure reads and writes through. `raw_mode()` hands the program each
// key as it is typed; `cooked_mode()` gives the terminal back.
//
// Keys: the arrows move, Space or Enter presses, digits and + - * / =
// work directly, c clears, q quits.
//
// Run: ae run examples/07-applications/04-calculator.ae
// Needs: a terminal to type in (it reads keys and redraws the screen); CI
//   builds it.
// See: docs/closures-and-lifetimes.md

import std.list

const ESC = 27
const UP = 65
const DOWN = 66
const RIGHT = 67
const LEFT = 68
const SPACE = 32
const ENTER = 10
const PLUS = 43
const MINUS = 45
const STAR = 42
const SLASH = 47
const EQUAL = 61
const KEY_C = 99
const KEY_Q = 113

// The widget: a list of two lists, the labels and the boxed handlers.
grid() -> ptr {
    g = list.new()
    list.add(g, list.new())
    list.add(g, list.new())
    return g
}

free_grid(g: ptr) {
    list.free(list.at(g, 0))
    list.free(list.at(g, 1))
    list.free(g)
}

// One button: called in grid's block, which passes the grid as _ctx.
btn(_ctx: ptr, label: string, action: @keep fn) {
    list.add(list.at(_ctx, 0), label)
    list.add(list.at(_ctx, 1), box_closure(action))
}

// The result of `prev op value`; a division by zero leaves value.
apply(prev: int, op: int, value: int) -> int {
    if op == PLUS {
        return prev + value
    }
    if op == MINUS {
        return prev - value
    }
    if op == STAR {
        return prev * value
    }
    if op == SLASH && value != 0 {
        return prev / value
    }
    return value
}

render(g: ptr, value: int, cursor: int, op: int, prev: int) {
    labels = list.at(g, 0)
    print("\x1b[H\x1b[2J  \x1b[1;36mCalculator\x1b[0m\n\n")
    println("  \x1b[44;97;1m  ${value}                \x1b[0m\n")
    for i in 0..list.size(labels) {
        label, _ = list.get_string(labels, i)
        col = i % 4
        if col == 0 {
            print("  ")
        }
        ch = char_at(label)
        if i == cursor {
            print("\x1b[46;97;1m ${label} \x1b[0m ")
        } else if ch >= 48 && ch <= 57 {
            print("\x1b[47;30m ${label} \x1b[0m ")
        } else {
            print("\x1b[43;30m ${label} \x1b[0m ")
        }
        if col == 3 {
            println("")
        }
    }
    println("")
    if op != 0 {
        print("  \x1b[90m${prev} ")
        print_char(op)
        println(" ...\x1b[0m")
    }
    println("  \x1b[90marrows move  space presses  q quits\x1b[0m")
}

main() {
    num = ref(0)
    prev = ref(0)
    op = ref(0)
    defer ref_free(num)
    defer ref_free(prev)
    defer ref_free(op)

    digit = | n: ptr, d: int | {
        ref_set(n, ref_get(n) * 10 + d)
    }
    set_op = | n: ptr, p: ptr, o: ptr, v: int | {
        ref_set(p, ref_get(n))
        ref_set(n, 0)
        ref_set(o, v)
    }

    // The keypad, laid out as it looks.
    g = grid() {
        btn("7") callback { call(digit, num, 7) }
        btn("8") callback { call(digit, num, 8) }
        btn("9") callback { call(digit, num, 9) }
        btn("+") callback { call(set_op, num, prev, op, PLUS) }

        btn("4") callback { call(digit, num, 4) }
        btn("5") callback { call(digit, num, 5) }
        btn("6") callback { call(digit, num, 6) }
        btn("-") callback { call(set_op, num, prev, op, MINUS) }

        btn("1") callback { call(digit, num, 1) }
        btn("2") callback { call(digit, num, 2) }
        btn("3") callback { call(digit, num, 3) }
        btn("*") callback { call(set_op, num, prev, op, STAR) }

        btn("0") callback { call(digit, num, 0) }
        btn("c") callback {
            ref_set(num, 0)
            ref_set(prev, 0)
            ref_set(op, 0)
        }
        btn("=") callback {
            ref_set(num, apply(ref_get(prev), ref_get(op), ref_get(num)))
            ref_set(prev, 0)
            ref_set(op, 0)
        }
        btn("/") callback { call(set_op, num, prev, op, SLASH) }
    }
    defer free_grid(g)

    cursor = 0
    raw_mode()
    render(g, ref_get(num), cursor, ref_get(op), ref_get(prev))
    running = true
    while running {
        key = read_char()
        if key == KEY_Q {
            running = false
        } else if key == ESC {
            read_char()
            arrow = read_char()
            if arrow == UP {
                cursor = cursor - 4
            } else if arrow == DOWN {
                cursor = cursor + 4
            } else if arrow == RIGHT {
                cursor = cursor + 1
            } else if arrow == LEFT {
                cursor = cursor - 1
            }
            if cursor < 0 {
                cursor = 0
            }
            if cursor > 15 {
                cursor = 15
            }
        } else if key == SPACE || key == ENTER {
            call(unbox_closure(list.at(list.at(g, 1), cursor)))
        } else if key >= 48 && key <= 57 {
            call(digit, num, key - 48)
        } else if key == PLUS || key == MINUS || key == STAR || key == SLASH {
            call(set_op, num, prev, op, key)
        } else if key == EQUAL {
            ref_set(num, apply(ref_get(prev), ref_get(op), ref_get(num)))
            ref_set(prev, 0)
            ref_set(op, 0)
        } else if key == KEY_C {
            ref_set(num, 0)
            ref_set(prev, 0)
            ref_set(op, 0)
        }
        if running {
            render(g, ref_get(num), cursor, ref_get(op), ref_get(prev))
        }
    }
    cooked_mode()
    print("\x1b[2J\x1b[H\x1b[0m")
    println("Bye!")
}
