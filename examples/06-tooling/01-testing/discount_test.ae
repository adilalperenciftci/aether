// Testing: a std.spec suite, run by `ae test` or on its own.
//
// std.spec is the test framework. `spec.init()` starts a run;
// `spec.describe(fw, name) { ... }` groups cases; `spec.it(name)
// callback { ... }` is one case, and the assertions in it
// (`spec.assert_eq`, `spec.assert_str_eq`, `spec.assert_true`, ...) mark
// it failed when they do not hold, printing what they saw. `main` returns
// `spec.run_summary(fw)`, 0 when every case passed, so the program's exit
// status is the verdict. The suite imports the code it tests,
// discount.ae, as a module.
//
// `ae test` finds the files named `test_*.ae` or `*_test.ae` in a
// directory (its tests/ when it has one) and runs each, reporting PASS or
// FAIL per file: `ae test examples/06-tooling/01-testing`. Run on its own,
// as below, a suite prints each case.
//
// Run: ae run examples/06-tooling/01-testing/discount_test.ae
// See: docs/testing.md

import std.spec
import discount

main() {
    fw = spec.init()

    spec.describe(fw, "clamp_percent") {
        spec.it("keeps a percent in range") callback {
            spec.assert_eq(discount.clamp_percent(40), 40, "40")
        }
        spec.it("raises a negative one to 0") callback {
            spec.assert_eq(discount.clamp_percent(-5), 0, "-5")
        }
        spec.it("lowers one over 100 to 100") callback {
            spec.assert_eq(discount.clamp_percent(150), 100, "150")
        }
    }

    spec.describe(fw, "apply") {
        spec.it("takes the percent off") callback {
            spec.assert_eq(discount.apply(1000, 25), 750, "25% of 1000")
        }
        spec.it("rounds down to a whole cent") callback {
            spec.assert_eq(discount.apply(999, 10), 900, "10% of 999")
        }
        spec.it("never goes below zero") callback {
            spec.assert_eq(discount.apply(500, 120), 0, "120% of 500")
        }
    }

    return spec.run_summary(fw)
}

// Output:
// clamp_percent
//     ✓ keeps a percent in range
//     ✓ raises a negative one to 0
//     ✓ lowers one over 100 to 100
// apply
//     ✓ takes the percent off
//     ✓ rounds down to a whole cent
//     ✓ never goes below zero
//
//   6 passing
