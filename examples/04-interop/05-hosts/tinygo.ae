// Calling Go in-process: a Go c-shared library loaded at run time.
//
// contrib.host.tinygo loads a library built with `go build
// -buildmode=c-shared` (TinyGo builds that only for wasm today) and calls
// its exported functions directly, no child process: `tinygo.load(path)`
// opens it, and `call_<result>_<arguments>` calls a function by name with
// that C signature. A function that returns a `C.CString` hands the
// string over: `call_str_str_owned` takes it and frees the C copy.
//
// Run: ae run examples/04-interop/05-hosts/tinygo.ae
// Needs: a Go toolchain to build the library first,
//   CGO_ENABLED=1 go build -buildmode=c-shared -o libgreet.so contrib/host/tinygo/examples/greet.go
//   and TINYGO_LIB set to its path (libgreet.dylib on macOS, greet.dll on
//   Windows). CI's contrib/host job builds and runs it.
// See: contrib/host/tinygo/README.md

import contrib.host.tinygo
import std.os

main() {
    path = os.getenv("TINYGO_LIB")
    if path == "" {
        println("set TINYGO_LIB to the library's path (see the header)")
        return
    }
    lib, err = tinygo.load(path)
    if lib == null {
        println("cannot load ${path}: ${err}")
        exit(1)
    }
    println("Answer() = ${tinygo.call_int_void(lib, "Answer")}")
    println("Add(2, 40) = ${tinygo.call_int_int_int(lib, "Add", 2, 40)}")
    println("Negate(7) = ${tinygo.call_int_int(lib, "Negate", 7)}")
    println(tinygo.call_str_str_owned(lib, "Greet", "world"))
    closed = tinygo.unload(lib)
    if closed != "" {
        println("unload: ${closed}")
    }
}
