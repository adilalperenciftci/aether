// Hosting Tcl: Tcl scripts run inside an Aether program, sandboxed.
//
// contrib.host.tcl embeds a Tcl interpreter. `tcl.run(script)` evaluates
// a script; `tcl.run_sandboxed(grants, script)` evaluates one with the
// Aether permission checker installed, so `open`, `exec` and `$::env`
// reads are checked against the grants, and what they do not allow fails
// as a Tcl error. Each returns 0 when the script ran to its end. The
// interpreter is shared between calls, so a variable one run sets is
// there in the next (docs/containment-sandbox.md, shared interpreters).
//
// Run: ae run examples/04-interop/05-hosts/tcl.ae
// Needs: Tcl development files, built in with
//   CFLAGS="-DAETHER_HAS_TCL $(pkg-config --cflags tcl)"
//   LDFLAGS="$(pkg-config --libs tcl)"; without them the bridge is a stub
//   that reports itself unavailable. CI's contrib/host job builds and runs
//   it.
// See: docs/containment-sandbox.md

import std.sandbox
import contrib.host.tcl

main() {
    tcl.run("puts \"hello from Tcl [expr {6 * 7}]\"")

    reader = sandbox.new("reader") {
        grant_fs_read("/etc/*")
    }
    defer sandbox.free(reader)
    nothing = sandbox.new("nothing") {
        grant_env("TERM")
    }
    defer sandbox.free(nothing)

    script = "set f [open /etc/hostname r]; close $f"
    if tcl.run_sandboxed(reader, script) == 0 {
        println("reader: opened /etc/hostname")
    }
    if tcl.run_sandboxed(nothing, script) != 0 {
        println("nothing: /etc/hostname refused")
    }
    tcl.finalize()
}
