// Hosting Lua: Lua code run inside an Aether program, sandboxed.
//
// contrib.host.lua embeds Lua. `lua.run(code)` runs a chunk;
// `lua.run_sandboxed(grants, code)` runs one with the Aether permission
// checker installed, so what Lua's libraries ask of libc (io.open,
// os.getenv, os.execute) is checked against the grants, and what they do
// not allow fails inside Lua. Each returns 0 when the chunk ran to its end;
// `assert` turns a refused io.open into an error the return code shows.
// The bridge also has a VM API for calling Lua functions and registering
// Aether ones (contrib/host/lua/README.md).
//
// Run: ae run examples/04-interop/05-hosts/lua.ae
// Needs: Lua 5.3 or 5.4 development files, built in with
//   CFLAGS="-DAETHER_HAS_LUA $(pkg-config --cflags lua5.4)"
//   LDFLAGS="$(pkg-config --libs lua5.4)"; without them the bridge is a
//   stub that reports itself unavailable. CI's contrib/host job builds and
//   runs it.
// See: docs/containment-sandbox.md

import std.sandbox
import contrib.host.lua

main() {
    lua.run("print('hello from Lua ' .. 6 * 7)")

    reader = sandbox.new("reader") {
        grant_fs_read("/etc/*")
    }
    defer sandbox.free(reader)
    nothing = sandbox.new("nothing") {
        grant_env("TERM")
    }
    defer sandbox.free(nothing)

    chunk = "local f = assert(io.open('/etc/hostname')); f:close()"
    if lua.run_sandboxed(reader, chunk) == 0 {
        println("reader: opened /etc/hostname")
    }
    if lua.run_sandboxed(nothing, chunk) != 0 {
        println("nothing: /etc/hostname refused")
    }
    lua.finalize()
}
