// Hosting Go: a Go program run from an Aether program, sandboxed.
//
// Go brings its own runtime, so contrib.host.go runs it as a child
// process rather than in the program: `go.run_script(path)` runs a Go
// source file with `go run`, `go.run(binary)` a built one, and the
// `_sandboxed` forms start the child under the Aether sandbox (on Linux
// through LD_PRELOAD, so its libc calls are checked against the grants;
// macOS has no such preload, and there the grants are advisory). Each
// returns the child's exit code.
//
// Run: ae run examples/04-interop/05-hosts/go.ae
// Needs: the `go` toolchain on PATH when it runs (no build flags), and
//   Linux for the sandbox to be enforced. CI's contrib/host job runs it.
// See: docs/containment-sandbox.md

import std.fs
import std.sandbox
import contrib.host.go

main() {
    dir, err = fs.make_temp_dir("", "aether-go-")
    if err != "" {
        println("no temp dir: ${err}")
        exit(1)
    }
    defer fs.remove_tree(dir)
    source = fs.join_clean(dir, "hello.go")
    fs.write(source, <<GO
package main

import "fmt"

func main() {
	fmt.Println("hello from Go", 6*7)
}
GO
    )

    if go.run_script(source) != 0 {
        println("go run failed: is the go toolchain on PATH?")
        exit(1)
    }

    // `go run` itself reads the toolchain and writes a build cache, so a
    // sandbox for it grants those; a pre-built binary needs far fewer.
    toolchain = sandbox.new("toolchain") {
        grant_all()
    }
    defer sandbox.free(toolchain)
    println("sandboxed run exit code: ${go.run_script_sandboxed(toolchain, source)}")
}
