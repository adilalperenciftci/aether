// String ownership: the compiler releases every string.
//
// Every `string` is a counted value (a literal is pinned and never
// freed). Each place that holds one (a local, a field, an element, a
// module `var`) owns one reference; a store takes the new value and
// releases the one it replaces, and leaving a scope releases what its
// locals hold. A function hands its caller one reference from every
// `return`, whatever it returns: a fresh string, a literal, or a
// parameter it only borrowed. You do NOT write `defer string.free(s)`.
//
// See docs/memory-management.md ("Values the program owns") for the
// rules, and docs/design/ownership-model.md for the design.

import std.string

// Returns a fresh string, which the caller's place takes over.
my_concat(a: string, b: string) -> string {
    return string.concat(a, b)
}

// Returns a literal on one path and a fresh string on the other. Both
// hand the caller a reference; the literal's is never released.
banner(name: string) -> string {
    if string.length(name) == 0 {
        return "guest"
    }
    return string.concat("hi ", name)
}

main() {
    println("=== String ownership demo ===")

    // 1. A loop that rebinds `s`: each store releases the string it
    // replaces, so memory stays flat however long the loop runs.
    s = ""
    i = 0
    while i < 10000 {
        s = my_concat(s, "x")
        i = i + 1
    }
    println("loop done: ${string.length(s)} bytes (no leak)")

    // 2. A fresh string replaced by a literal: the store releases the
    // fresh one, and the literal is never freed.
    msg = string.concat("hello ", "world")
    msg = "all done"
    println(msg)

    // 3. A local bound in several branches is one variable, and each
    // branch's store follows the same rule.
    score = 75
    result = ""
    if score > 90 {
        result = my_concat("excellent: ", "A")
    } else if score > 60 {
        result = my_concat("passing: ", "C")
    } else {
        result = "fail"
    }
    println(result)

    // 4. A function whose returns mix literals and fresh strings: the
    // caller's place owns whichever it is given, and releases it on the
    // next store.
    g = banner("")
    g = banner("Aether")
    println(g)

    // 5. Stores at any depth of nesting follow the same rule.
    deep = ""
    if 1 == 1 {
        deep = my_concat("outer-", "init")
        j = 0
        while j < 3 {
            deep = my_concat(deep, "+")
            j = j + 1
        }
    }
    println(deep)

    println("=== done ===")
}
